<viewport-portal wx:if="{{visible}}">
  <view class="personnel-picker-overlay ui-overlay">
    <view class="ui-overlay-blocker" catchtouchmove="noop"></view>
    <view class="personnel-picker-shell popup-card ui-dialog-shell ui-dialog-shell--complex">
      <view class="personnel-picker-header popup-header ui-dialog-header">
        <view class="personnel-picker-title popup-title">{{title}}</view>
        <text class="personnel-picker-close popup-close ui-motion-chip" catchtap="cancelSelection" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">{{localeCopy.close}}</text>
      </view>

      <scroll-view enhanced="{{true}}" show-scrollbar="{{true}}" bounces="{{true}}" nested-scroll-enabled="{{true}}" scroll-y class="personnel-picker-body ui-dialog-body ui-dialog-content ui-dialog-content--stack ui-dialog-scroll--fill">
        <view class="personnel-picker-stack ui-dialog-stack">
          <view class="personnel-picker-context ui-dialog-summary" wx:if="{{contextText}}">{{contextText}}</view>

          <view class="personnel-picker-section personnel-picker-selection-summary ui-dialog-list-panel">
            <view class="personnel-picker-section-head personnel-picker-selected-head">
              <text>{{selectedHeading}}</text>
              <text class="personnel-picker-count">{{selectedCountText}}</text>
              <text wx:if="{{selectedItems.length}}" class="personnel-picker-expand link ui-motion-chip" catchtap="toggleSelectedExpanded" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">{{selectedExpanded ? localeCopy.collapseSelected : localeCopy.expandSelected}}</text>
            </view>
            <scroll-view wx:if="{{selectedExpanded && selectedItems.length}}" enhanced="{{true}}" show-scrollbar="{{true}}" bounces="{{true}}" nested-scroll-enabled="{{true}}" scroll-y class="personnel-picker-list personnel-picker-selected-list ui-dialog-scroll--pane ui-dialog-selection-current">
              <view class="personnel-picker-card personnel-picker-card-selected selection-option-card ui-motion-chip" wx:for="{{selectedItems}}" wx:key="selectionKey" data-key="{{item.selectionKey}}" catchtap="toggleOption" aria-role="checkbox" aria-checked="{{true}}" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">
                <view class="personnel-picker-card-content">
                  <view class="personnel-picker-main">
                    <view class="personnel-picker-name">{{item._displayName}}</view>
                    <view class="personnel-picker-assignment" wx:if="{{selectionLevel === 'assignment'}}">{{item._assignmentText}}</view>
                    <view class="personnel-picker-assignment-list" wx:else>
                      <view class="personnel-picker-assignment" wx:for="{{item.assignments}}" wx:key="assignmentId" wx:for-item="assignment">{{assignment.assignmentLabel || localeCopy.assignmentUnavailable}}</view>
                    </view>
                  </view>
                </view>
              </view>
              <view class="scroll-tail-space"></view>
            </scroll-view>
          </view>

          <view class="personnel-picker-toolbar ui-dialog-toolbar">
            <view class="personnel-picker-filter-grid">
              <view class="personnel-picker-filter"><view class="personnel-picker-filter-label">{{localeCopy.department}}</view><picker class="ui-field-control-host" range="{{departmentOptions}}" value="{{departmentIndex}}" bindchange="onDepartmentChange"><view class="personnel-picker-filter-value picker-value ui-field-control {{departmentIndex ? 'personnel-picker-filter-active' : ''}}"><text class="personnel-picker-filter-text">{{departmentOptions[departmentIndex]}}</text><view class="personnel-picker-chevron"></view></view></picker></view>
              <view class="personnel-picker-filter"><view class="personnel-picker-filter-label">{{localeCopy.identity}}</view><picker class="ui-field-control-host" range="{{identityOptions}}" value="{{identityIndex}}" bindchange="onIdentityChange"><view class="personnel-picker-filter-value picker-value ui-field-control {{identityIndex ? 'personnel-picker-filter-active' : ''}}"><text class="personnel-picker-filter-text">{{identityOptions[identityIndex]}}</text><view class="personnel-picker-chevron"></view></view></picker></view>
              <view class="personnel-picker-filter"><view class="personnel-picker-filter-label">{{localeCopy.workGroup}}</view><picker class="ui-field-control-host" range="{{workGroupOptions}}" value="{{workGroupIndex}}" bindchange="onWorkGroupChange"><view class="personnel-picker-filter-value picker-value ui-field-control {{workGroupIndex ? 'personnel-picker-filter-active' : ''}}"><text class="personnel-picker-filter-text">{{workGroupOptions[workGroupIndex]}}</text><view class="personnel-picker-chevron"></view></view></picker></view>
            </view>
            <input class="personnel-picker-search field-input" value="{{keyword}}" bindinput="onKeywordInput" placeholder="{{localeCopy.searchPlaceholder}}" />
          </view>

          <slot name="extra"></slot>

          <view class="personnel-picker-section ui-dialog-list-panel">
            <view class="personnel-picker-section-head">{{candidateHeading}}</view>
            <view class="personnel-picker-empty" wx:if="{{loading}}">{{localeCopy.loading}}</view>
            <view class="personnel-picker-error" wx:elif="{{errorText}}"><text>{{errorText}}</text><text class="link ui-motion-chip" catchtap="retry" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160">{{localeCopy.retry}}</text></view>
            <scroll-view wx:else enhanced="{{true}}" show-scrollbar="{{true}}" bounces="{{true}}" nested-scroll-enabled="{{true}}" scroll-y class="personnel-picker-list personnel-picker-option-list ui-dialog-scroll--pane ui-dialog-selection-options">
              <view class="personnel-picker-card selection-option-card ui-motion-chip {{item._selected ? 'personnel-picker-card-selected' : ''}}" wx:for="{{filteredOptions}}" wx:key="selectionKey" data-key="{{item.selectionKey}}" catchtap="toggleOption" aria-role="checkbox" aria-checked="{{item._selected}}" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">
                <view class="personnel-picker-card-content">
                  <view class="personnel-picker-main">
                    <view class="personnel-picker-name">{{item._displayName}}</view>
                    <view class="personnel-picker-assignment" wx:if="{{selectionLevel === 'assignment'}}">{{item._assignmentText}}</view>
                    <view class="personnel-picker-assignment-list" wx:else>
                      <view class="personnel-picker-assignment" wx:for="{{item.assignments}}" wx:key="assignmentId" wx:for-item="assignment">{{assignment.assignmentLabel || localeCopy.assignmentUnavailable}}</view>
                    </view>
                  </view>
                </view>
              </view>
              <view class="personnel-picker-empty" wx:if="{{!normalizedOptions.length}}">{{localeCopy.empty}}</view>
              <view class="personnel-picker-empty" wx:elif="{{!filteredOptions.length}}">{{localeCopy.noMatch}}</view>
              <view class="scroll-tail-space"></view>
            </scroll-view>
          </view>
        </view>
      </scroll-view>

      <view class="personnel-picker-footer button-row ui-dialog-footer">
        <button class="secondary-btn ui-motion-button" catchtap="cancelSelection" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">{{localeCopy.close}}</button>
        <button class="primary-btn ui-motion-button" loading="{{confirmLoading}}" catchtap="confirmSelection" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">{{localeCopy.confirm}}</button>
      </view>
    </view>
  </view>
</viewport-portal>
