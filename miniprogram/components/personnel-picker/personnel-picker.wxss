.personnel-picker-overlay {
  --ui-dialog-width: min(704rpx, calc(100vw - 32rpx));
  --ui-dialog-max-height: calc(100vh - 64rpx);
}

.personnel-picker-shell.popup-card {
  overflow: hidden;
  padding: var(--ui-dialog-padding, 32rpx);
  border-radius: var(--ui-dialog-radius, 30rpx);
  background: linear-gradient(145deg, rgba(255,255,255,0.985), rgba(247,250,255,0.95));
  border: 1rpx solid rgba(255,255,255,0.90);
  box-shadow:
    0 28rpx 64rpx rgba(15,23,42,0.18),
    inset 0 1rpx 0 rgba(255,255,255,0.96);
  box-sizing: border-box;
}

.personnel-picker-header,
.personnel-picker-footer {
  flex: none;
}

.personnel-picker-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--ui-dialog-section-gap, 20rpx);
}

.personnel-picker-title {
  min-width: 0;
  color: #0f172a;
  font-size: var(--ui-dialog-title-size, 30rpx);
  font-weight: 800;
  line-height: 1.45;
  overflow-wrap: anywhere;
}

.personnel-picker-close {
  flex: none;
  color: #2563eb;
}

.personnel-picker-body {
  max-height: calc(100vh - 250rpx);
  touch-action: pan-y;
}

.personnel-picker-stack {
  display: flex;
  flex-direction: column;
  width: 100%;
  min-width: 0;
  gap: var(--ui-dialog-section-gap, 20rpx);
}

.personnel-picker-footer {
  border-top: 1rpx solid rgba(219,229,241,0.72);
  background: transparent;
}

.personnel-picker-context {
  color: #334155;
  font-size: var(--ui-type-body);
  line-height: 1.6;
}

.personnel-picker-section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--ui-inline-gap, 12rpx);
  margin-bottom: var(--ui-section-gap, 16rpx);
  color: #0f172a;
  font-size: var(--ui-dialog-label-size);
  font-weight: 600;
  line-height: 1.45;
}

/* 已选仅作核对摘要，把首屏空间留给筛选与候选岗位。 */
.personnel-picker-selected-head {
  justify-content: flex-start;
  margin-bottom: 0;
  color: #64748b;
  font-size: var(--ui-dialog-meta-size);
}

.personnel-picker-count {
  margin-left: auto;
  color: #64748b;
  font-size: var(--ui-dialog-meta-size);
  font-weight: 500;
}

.personnel-picker-expand {
  flex: none;
  font-size: var(--ui-dialog-meta-size);
}

.personnel-picker-stack > .personnel-picker-section {
  margin-top: 0;
}

.personnel-picker-list {
  width: 100%;
  padding: 4rpx 6rpx 0;
  box-sizing: border-box;
  touch-action: pan-y;
}

/* 内容短时自然收缩，内容长时在自身视口内滚动，不恢复固定空白工作区。 */
.personnel-picker-shell .personnel-picker-option-list {
  height: auto;
  min-height: 0;
  max-height: 56vh;
}

.personnel-picker-shell .personnel-picker-selected-list {
  height: auto;
  min-height: 0;
  max-height: 22vh;
  margin-top: var(--ui-inline-gap, 12rpx);
}

.personnel-picker-card {
  flex: none;
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  width: 100%;
  margin-bottom: var(--ui-list-gap, 12rpx);
  padding: var(--ui-list-padding-y, 18rpx) var(--ui-list-padding-x, 20rpx);
  border-radius: var(--ui-list-radius, 22rpx);
  background: linear-gradient(135deg, rgba(255,255,255,0.96), rgba(246,249,255,0.88));
  border: 1rpx solid rgba(219,229,241,0.96);
  box-shadow: 0 10rpx 22rpx rgba(15,23,42,0.045), inset 0 1rpx 0 rgba(255,255,255,0.86);
  backdrop-filter: blur(24rpx);
  box-sizing: border-box;
}

.personnel-picker-card.personnel-picker-card-selected {
  border-color: #3b82f6;
  background: linear-gradient(135deg, rgba(219,234,254,0.76), rgba(239,246,255,0.92));
  box-shadow: inset 0 0 0 1px rgba(59,130,246,0.36), inset 0 1rpx 0 rgba(255,255,255,0.86);
}

.personnel-picker-card-content {
  flex: 1;
  display: flex;
  align-items: flex-start;
  min-width: 0;
  gap: var(--ui-inline-gap, 12rpx);
}

.personnel-picker-main {
  flex: 1;
  min-width: 0;
}

.personnel-picker-name {
  color: #0f172a;
  font-size: var(--ui-type-body);
  font-weight: 800;
  line-height: 1.45;
  overflow-wrap: anywhere;
}

.personnel-picker-assignment-list {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 8rpx;
  margin-top: 8rpx;
}

.personnel-picker-assignment {
  display: inline-flex;
  max-width: 100%;
  margin-top: 8rpx;
  padding: 6rpx 12rpx;
  box-sizing: border-box;
  border-radius: var(--ui-compact-radius, 18rpx);
  color: #2563eb;
  font-size: var(--ui-type-meta);
  line-height: 1.5;
  overflow-wrap: anywhere;
  background: linear-gradient(135deg, rgba(219,234,254,0.84), rgba(239,246,255,0.72));
  border: 1rpx solid rgba(147,197,253,0.64);
}

.personnel-picker-assignment-list .personnel-picker-assignment {
  margin-top: 0;
}

.personnel-picker-filter-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: var(--ui-inline-gap, 12rpx);
  align-items: end;
}

.personnel-picker-filter {
  min-width: 0;
}

.personnel-picker-filter-label {
  margin-bottom: var(--ui-label-gap, 8rpx);
  color: #334155;
  font-size: var(--ui-dialog-label-size);
  font-weight: 600;
  line-height: 1.45;
}

.personnel-picker-shell .personnel-picker-filter-value {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8rpx;
  padding: 12rpx 14rpx;
  min-height: var(--ui-field-control-height, 82rpx);
  color: #334155;
  font-size: var(--ui-dialog-control-size);
  font-weight: 600;
  border-color: rgba(147,197,253,0.72);
  background: linear-gradient(135deg, rgba(255,255,255,0.98), rgba(239,246,255,0.94));
}

.personnel-picker-filter-text {
  flex: 1;
  min-width: 0;
  overflow-wrap: anywhere;
}

.personnel-picker-chevron {
  flex: none;
  width: 10rpx;
  height: 10rpx;
  border-right: 2rpx solid #64748b;
  border-bottom: 2rpx solid #64748b;
  transform: rotate(45deg);
}

.personnel-picker-shell .personnel-picker-filter-active {
  color: #2563eb;
  border-color: rgba(96,165,250,0.90);
  background: linear-gradient(135deg, rgba(219,234,254,0.92), rgba(239,246,255,0.94));
}

.personnel-picker-search {
  width: 100%;
  margin-top: var(--ui-inline-gap, 12rpx);
}

.personnel-picker-empty,
.personnel-picker-error {
  padding: 20rpx 12rpx;
  color: #64748b;
  font-size: var(--ui-type-body);
  line-height: 1.6;
  text-align: center;
}

.personnel-picker-error {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--ui-inline-gap, 12rpx);
  flex-wrap: wrap;
}

@media (min-width: 520px) and (max-width: 899px) {
  .personnel-picker-overlay {
    --ui-dialog-width: min(760px, calc(100vw - 48px));
    --ui-dialog-max-height: calc(100vh - 48px);
  }
  .personnel-picker-body { max-height: calc(100vh - 190px); }
  .personnel-picker-shell .personnel-picker-option-list { max-height: min(56vh, 560px); }
  .personnel-picker-shell .personnel-picker-selected-list { max-height: min(22vh, 200px); }
  .personnel-picker-chevron { width: 6px; height: 6px; border-width: 1px; }
  .personnel-picker-shell .personnel-picker-filter-value { gap: 6px; }
  .personnel-picker-card { gap: 12px; }
  .personnel-picker-card-content { gap: 10px; }
}

@media (min-width: 900px) and (orientation: landscape) {
  .personnel-picker-overlay {
    --ui-dialog-width: min(1024px, calc(100vw - 44px));
    --ui-dialog-max-height: calc(100vh - 44px);
  }
  .personnel-picker-body { max-height: calc(100vh - 174px); }
  .personnel-picker-shell .personnel-picker-option-list { max-height: min(56vh, 480px); }
  .personnel-picker-shell .personnel-picker-selected-list { max-height: min(22vh, 180px); }
  .personnel-picker-chevron { width: 6px; height: 6px; border-width: 1px; }
  .personnel-picker-shell .personnel-picker-filter-value { gap: 6px; }
  .personnel-picker-card { gap: 10px; }
  .personnel-picker-card-content { gap: 8px; }
}
