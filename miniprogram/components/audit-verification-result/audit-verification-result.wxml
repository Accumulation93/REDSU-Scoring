<view wx:if="{{view}}" class="crypto-result">
  <view class="crypto-heading">
    <view class="crypto-title crypto-state--{{view.state}}">{{view.title}}</view>
    <view class="crypto-note">{{view.source}}</view>
    <view wx:if="{{view.notice}}" class="crypto-note">{{view.notice}}</view>
  </view>
  <view wx:if="{{!view.files.length}}" class="crypto-note">{{copy.noFiles}}</view>
  <view wx:for="{{view.files}}" wx:for-item="file" wx:key="key" class="crypto-file">
    <view class="crypto-file-name">{{file.name}}</view>
    <view class="crypto-state--{{file.state}} crypto-file-state">{{file.stateText}}</view>
    <view wx:if="{{!file.platformVerified}}" class="crypto-note">{{copy.platformUnconfirmed}}</view>
    <view wx:if="{{report && file.platformVerified}}" class="crypto-note">{{copy.hostedNotice}}</view>
    <view wx:if="{{report && !file.platformVerified}}" class="crypto-note">{{copy.unconfirmedReportNotice}}</view>
    <view wx:if="{{!report}}" class="crypto-check-grid">
      <view wx:for="{{file.summary}}" wx:for-item="check" wx:key="key" class="crypto-check">
        <view class="crypto-check-label">{{check.label}}</view>
        <view class="crypto-state--{{check.state}}">{{check.text}}</view>
      </view>
    </view>
    <view wx:if="{{report}}" class="crypto-check-grid">
      <view wx:for="{{file.checks}}" wx:for-item="check" wx:key="key" class="crypto-check">
        <view class="crypto-check-label">{{check.label}}</view>
        <view class="crypto-state--{{check.state}}">{{check.stateText}}</view>
        <view class="crypto-note">{{check.reasonText}}</view>
      </view>
    </view>
    <view wx:if="{{!file.steps.length}}" class="crypto-note">{{copy.noSteps}}</view>
    <view wx:for="{{file.steps}}" wx:for-item="step" wx:key="key" class="crypto-step">
      <view class="crypto-step-header">
        <view class="crypto-check-label">{{step.title}}</view>
        <view wx:if="{{step.personText}}" class="crypto-person-reference">{{step.personText}}</view>
      </view>
      <view class="crypto-person">{{step.name}}</view>
      <view class="crypto-identity crypto-state--{{step.state}}">{{step.stateText}}</view>
      <view class="crypto-affiliation">
        <view wx:if="{{step.organization}}" class="crypto-affiliation-row">
          <view class="crypto-note">{{copy.organizationLabel}}</view>
          <view class="crypto-organization">{{step.organization}}</view>
        </view>
        <view wx:if="{{step.assignment}}" class="crypto-affiliation-row">
          <view class="crypto-note">{{copy.assignmentLabel}}</view>
          <view class="crypto-assignment">{{step.assignment}}</view>
        </view>
      </view>
      <view class="crypto-step-time crypto-note">{{copy.timeLabel}} · {{step.signedAtText}}</view>
      <view wx:if="{{report}}" class="crypto-details">
        <view class="crypto-note">{{step.digestTypeText}}</view>
        <view wx:for="{{step.fields}}" wx:for-item="field" wx:key="key" class="crypto-detail-row">
          <view class="crypto-note">{{field.label}}</view><text selectable class="crypto-code">{{field.value}}</text>
        </view>
      </view>
    </view>
    <view wx:if="{{report}}" class="crypto-details">
      <view class="crypto-note">{{copy.fileDigest}}</view><text selectable class="crypto-code">{{file.fileDigest}}</text>
      <view wx:for="{{file.cms}}" wx:for-item="cms" wx:key="key" class="crypto-detail-row">
        <view class="crypto-note">{{copy.wholeDocument}} · {{cms.coverage}}</view>
        <view wx:for="{{cms.fields}}" wx:for-item="field" wx:key="key" class="crypto-detail-row">
          <view class="crypto-note">{{field.label}}</view><text selectable class="crypto-code">{{field.value}}</text>
        </view>
      </view>
      <view wx:if="{{file.platformVerified}}" class="crypto-details">
        <view class="crypto-check-label">{{copy.certificateTitle}}</view>
        <view class="crypto-report-guide"><view class="crypto-check-label">{{copy.certificateScopeTitle}}</view><view class="crypto-note">{{copy.certificateNotice}}</view></view>
        <view class="crypto-report-guide"><view class="crypto-check-label">{{copy.certificateUseTitle}}</view><view class="crypto-note">{{copy.certificateGuide}}</view></view>
        <view class="crypto-report-guide"><view class="crypto-check-label">{{copy.adobeTrustTitle}}</view><view class="crypto-note">{{copy.adobeTrustNotice}}</view></view>
        <view class="crypto-report-guide"><view class="crypto-check-label">{{copy.certificatePublicTrustTitle}}</view><view class="crypto-note">{{copy.certificatePublicTrust}}</view></view>
        <view wx:if="{{!file.certificates.length}}" class="crypto-note">{{copy.noCertificate}}</view>
        <view wx:for="{{file.certificates}}" wx:for-item="certificate" wx:for-index="certificateIndex" wx:key="fingerprint" class="crypto-certificate-actions">
          <button data-file="{{file.key}}" data-certificate="{{certificateIndex}}" class="secondary-btn crypto-details-toggle ui-motion-button" bindtap="exportCertificate" loading="{{exporting}}" disabled="{{exporting}}" hover-class="ui-press-button" hover-stop-propagation="{{true}}" hover-start-time="0" hover-stay-time="160">{{copy.exportCertificate}}</button>
          <button data-file="{{file.key}}" data-certificate="{{certificateIndex}}" class="secondary-btn crypto-details-toggle ui-motion-button" bindtap="copyCertificate" disabled="{{exporting}}" hover-class="ui-press-button" hover-stop-propagation="{{true}}" hover-start-time="0" hover-stay-time="160">{{copy.copyCertificate}}</button>
        </view>
      </view>
    </view>
    <view wx:if="{{report && file.platformVerified}}" class="crypto-note">{{copy.timeNotice}}</view>
  </view>
  <button wx:if="{{!report}}" class="secondary-btn crypto-details-toggle ui-motion-button" bindtap="openReport" hover-class="ui-press-button" hover-stop-propagation="{{true}}" hover-start-time="0" hover-stay-time="160">{{copy.technical}}</button>
</view>
