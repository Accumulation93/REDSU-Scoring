/* Shared Blue Luxury Glass polish for audit subpackage */
page {
  min-height: 100%;
  background:
    radial-gradient(circle at 12% 10%, rgba(96, 165, 250, 0.16) 0%, transparent 26%),
    radial-gradient(circle at 86% 18%, rgba(191, 219, 254, 0.22) 0%, transparent 24%),
    radial-gradient(circle at 18% 88%, rgba(125, 211, 252, 0.10) 0%, transparent 22%),
    linear-gradient(135deg, #f8fbff 0%, #f1f6fc 48%, #edf3fa 100%);
}

.page {
  position: relative;
  min-height: 100vh;
  padding: var(--ui-page-padding-top) var(--ui-page-padding-x) calc(var(--ui-page-padding-bottom) + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.card,
.my-filter-box,
.edit-box,
.list-card {
  position: relative;
  margin-bottom: var(--ui-card-gap);
  padding: var(--ui-card-padding-y) var(--ui-card-padding-x);
  border-radius: var(--ui-card-radius);
  background: linear-gradient(135deg, rgba(255,255,255,0.80) 0%, rgba(248,251,255,0.72) 100%);
  border: 1rpx solid rgba(255,255,255,0.62);
  box-shadow: 0 18rpx 36rpx rgba(15,23,42,0.06), inset 0 1rpx 0 rgba(255,255,255,0.78);
  backdrop-filter: blur(24rpx);
  -webkit-backdrop-filter: blur(24rpx);
  box-sizing: border-box;
}

/* 条件分支只承担布局，真实玻璃表面与外间距由子卡片单独拥有。 */
.section-stack {
  position: relative;
  min-width: 0;
  margin: 0;
  padding: 0;
  border: 0;
  background: transparent;
  box-shadow: none;
}

.section-title,
.list-title {
  position: relative;
  padding-left: var(--ui-section-title-inset);
  margin-bottom: var(--ui-field-gap);
  color: #0f172a;
  font-size: var(--ui-type-section);
  font-weight: 700;
  line-height: 1.4;
}

.section-title::before,
.list-title::before {
  content: "";
  position: absolute;
  left: 0;
  top: 50%;
  width: 8rpx;
  height: 28rpx;
  border-radius: 999rpx;
  transform: translateY(-50%);
  background: linear-gradient(180deg, #2563eb 0%, #60a5fa 100%);
  box-shadow: 0 0 14rpx rgba(59,130,246,0.24);
}

.field {
  margin-bottom: var(--ui-field-gap);
}

.field-label {
  margin-bottom: var(--ui-label-gap);
  color: #64748b;
  font-size: var(--ui-type-label);
  font-weight: 600;
  line-height: 1.5;
}

.field-input,
.field-textarea,
.picker-value,
.picker-display {
  width: 100%;
  min-height: var(--ui-field-control-height, 82rpx);
  padding: 16rpx 20rpx;
  border-radius: var(--ui-field-radius, 20rpx);
  color: #0f172a;
  font-size: var(--ui-type-emphasis);
  line-height: 1.6;
  background: linear-gradient(135deg, rgba(255,255,255,0.96), rgba(246,249,255,0.88));
  border: 1rpx solid rgba(219,229,241,0.96);
  box-shadow: 0 10rpx 22rpx rgba(15,23,42,0.04), inset 0 1rpx 0 rgba(255,255,255,0.84);
  box-sizing: border-box;
}

input.field-input,
textarea.field-textarea {
  display: block;
}

.field-textarea,
textarea {
  min-height: 156rpx;
  white-space: pre-wrap;
}

.audit-submission-desc-text,
.view-desc-text,
.list-desc,
.booking-item-meta,
.detail-val,
.field-hint {
  color: #64748b;
  font-size: var(--ui-type-label);
  line-height: 1.72;
  word-break: break-word;
  white-space: pre-wrap;
}

.audit-submission-item,
.pending-item,
.audit-sig-card,
.file-attach-item,
.ad-hoc-step-item,
.template-select-item,
.tpl-step-preview-item,
.sign-file-card,
.list-item,
.nav-row {
  border-radius: 22rpx;
  background: linear-gradient(135deg, rgba(255,255,255,0.92), rgba(249,251,255,0.82));
  border: 1rpx solid rgba(226,237,247,0.96);
  box-shadow: 0 12rpx 24rpx rgba(15,23,42,0.04), inset 0 1rpx 0 rgba(255,255,255,0.78);
}

.audit-chip,
.preview-chip,
.merit-chip,
.filter-chip,
.chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 38rpx;
  padding: 6rpx 14rpx;
  border-radius: var(--ui-compact-radius, 18rpx);
  font-size: var(--ui-type-caption);
  font-weight: 700;
  line-height: 1.35;
  border: 1rpx solid rgba(147,197,253,0.64);
  background: rgba(219,234,254,0.76);
  color: #2563eb;
}

.popup-mask {
  background: rgba(15,23,42,0.34);
  backdrop-filter: blur(6rpx);
}

.popup-card {
  border-radius: 28rpx;
  background: linear-gradient(135deg, rgba(255,255,255,0.95), rgba(248,251,255,0.90));
  border: 1rpx solid rgba(255,255,255,0.82);
  box-shadow: 0 22rpx 44rpx rgba(15,23,42,0.14), inset 0 1rpx 0 rgba(255,255,255,0.78);
}

.popup-title {
  color: #0f172a;
  font-size: var(--ui-type-dialog);
  font-weight: 700;
  line-height: 1.42;
}

.popup-close {
  white-space: nowrap;
  flex-shrink: 0;
}

.primary-btn,
.secondary-btn,
.danger-btn {
  border-radius: var(--ui-control-radius, 28rpx);
  font-weight: 700;
}

.inner-scroll,
.popup-scroll {
  box-sizing: border-box;
}

.audit-empty-state,
.empty-state,
.empty-inline {
  border-radius: 24rpx;
  background: linear-gradient(135deg, rgba(255,255,255,0.72), rgba(248,251,255,0.60));
  border: 1rpx dashed rgba(147,197,253,0.46);
  color: #64748b;
}

/* ── Shared utility classes (used across multiple audit pages) ── */
.compact-row { margin-top: 10rpx; }

.large-scroll { max-height: 820rpx; }

.card-loading-overlay {
  display: flex;
  align-items: center; justify-content: center;
  padding: 32rpx 0;
}

.card-loading-spinner {
  width: 40rpx; height: 40rpx;
  border: 5rpx solid rgba(37, 99, 235, 0.16);
  border-top-color: #2563eb;
  border-radius: 50%;
  animation: auditSpin 0.7s linear infinite;
}

@keyframes auditSpin {
  to { transform: rotate(360deg); }
}

.list-actions {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  gap: 8rpx;
}

/* Shared glass progress surfaces. Press feedback is driven by each target's hover-class. */
.audit-flow-progress-bar,
.progress-track {
  background: linear-gradient(135deg, rgba(226, 237, 247, 0.78), rgba(248, 251, 255, 0.68));
  border: 1rpx solid rgba(255, 255, 255, 0.66);
  box-shadow:
    inset 0 1rpx 5rpx rgba(15, 23, 42, 0.08),
    0 8rpx 18rpx rgba(15, 23, 42, 0.025);
}

.audit-flow-progress-fill,
.progress-fill {
  background: linear-gradient(90deg, #2563eb 0%, #3b82f6 54%, #60a5fa 100%);
  box-shadow: 0 0 18rpx rgba(37, 99, 235, 0.24);
}

.audit-submission-item.control-pressing,
.pending-item.control-pressing,
.audit-sig-card.control-pressing,
.file-attach-item.control-pressing,
.ad-hoc-step-item.control-pressing,
.template-select-item.control-pressing,
.tpl-step-preview-item.control-pressing,
.sign-file-card.control-pressing,
.list-item.control-pressing,
.nav-row.control-pressing {
  transform: translate3d(0, 2rpx, 0) scale(0.992) !important;
  opacity: 0.97 !important;
  filter: saturate(1.02) brightness(1.005) !important;
  transition:
    transform 0.18s cubic-bezier(0.22, 0.8, 0.26, 1),
    box-shadow 0.20s ease,
    opacity 0.16s ease,
    filter 0.20s ease !important;
}

.green-chip,
.blue-chip,
.orange-chip,
.gray-chip,
.red-chip {
  border-radius: var(--ui-compact-radius, 18rpx);
  border: 1rpx solid transparent;
  box-shadow:
    0 6rpx 14rpx rgba(15, 23, 42, 0.035),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.56);
}

.green-chip {
  color: #15803d;
  background: linear-gradient(135deg, rgba(220, 252, 231, 0.96), rgba(167, 243, 208, 0.84));
  border-color: rgba(110, 231, 183, 0.58);
}

.blue-chip {
  color: #2563eb;
  background: linear-gradient(135deg, rgba(219, 234, 254, 0.96), rgba(191, 219, 254, 0.84));
  border-color: rgba(147, 197, 253, 0.64);
}

.orange-chip {
  color: #c2410c;
  background: linear-gradient(135deg, rgba(255, 247, 237, 0.96), rgba(254, 215, 170, 0.84));
  border-color: rgba(253, 186, 116, 0.58);
}

.gray-chip {
  color: #64748b;
  background: linear-gradient(135deg, rgba(248, 250, 252, 0.96), rgba(226, 232, 240, 0.84));
  border-color: rgba(203, 213, 225, 0.58);
}

.red-chip {
  color: #dc2626;
  background: linear-gradient(135deg, rgba(254, 242, 242, 0.96), rgba(254, 202, 202, 0.84));
  border-color: rgba(252, 165, 165, 0.58);
}

/* Popup close is plain text plus x, not a pill button. */
.popup-close {
  display: inline-flex !important;
  align-items: center !important;
  gap: 8rpx !important;
  padding: 4rpx 0 4rpx 16rpx !important;
  border: 0 !important;
  background: transparent !important;
  box-shadow: none !important;
  color: #475569 !important;
  font-size: var(--ui-type-control) !important;
  font-weight: 700 !important;
  white-space: nowrap !important;
}

.popup-close::before { display: none !important; content: none !important; }
.popup-close::after { content: "×" !important; color: #2563eb !important; font-size: var(--ui-type-value) !important; font-weight: 800 !important; line-height: 1 !important; }

@media (min-width: 520px) {
  .large-scroll {
    max-height: 65vh;
  }

  .audit-submission-item,
  .pending-item,
  .audit-sig-card,
  .template-select-item {
    padding: 18px;
    border-radius: 18px;
  }

  .popup-close {
    min-height: 36px !important;
    padding: 8px 0 8px 14px !important;
    font-size: var(--ui-type-meta) !important;
    line-height: 20px !important;
  }

  .popup-close::after {
    font-size: var(--ui-type-section) !important;
  }

  .audit-submission-name,
  .pending-item-name,
  .detail-title,
  .template-select-name,
  .audit-sig-name {
    font-size: var(--ui-type-emphasis) !important;
    line-height: 1.5 !important;
  }

  .audit-submission-meta,
  .pending-item-meta,
  .detail-meta,
  .template-select-desc,
  .audit-sig-meta {
    font-size: var(--ui-type-meta) !important;
    line-height: 1.55 !important;
  }

  .detail-status-chip,
  .status-chip,
  .audit-chip {
    font-size: var(--ui-type-caption) !important;
    line-height: 18px !important;
  }
}

@media (min-width: 900px) and (orientation: landscape) {
  .audit-submission-item,
  .pending-item,
  .audit-sig-card,
  .template-select-item {
    padding: 12px 14px;
    border-radius: 14px;
  }

  .popup-close {
    min-height: 30px !important;
    padding: 5px 0 5px 10px !important;
    line-height: 18px !important;
  }
}
.audit-chip--inline {
  margin-left: 8rpx;
}

@media (min-width: 520px) {
  .audit-chip--inline {
    margin-left: 6px;
  }
}
