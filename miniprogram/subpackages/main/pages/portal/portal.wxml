<view class="page">
  <workspace-hero class="workspace-hero-host" app-name="{{copy.appName}}" page-name="{{copy.pageName}}" tone="{{isAdminRole ? 'admin' : 'blue'}}"></workspace-hero>

  <view class="portal-message-partial" wx:if="{{hasUser && messagePartial}}">
    <ui-icon name="bell" tone="primary" size="28" ariaLabel="{{copy.loadingHint}}" />
    <text>{{copy.partialOrganizationLoading}}</text>
  </view>

  <view class="card" wx:if="{{hasUser}}">
    <view class="info-head">
      <view class="section-title">{{copy.todoTitle}}</view>
      <view class="message-head-actions">
        <view class="todo-count" wx:if="{{todoCount > 0}}">{{copy.totalPrefix}} {{todoCount > 99 ? '99+' : todoCount}} {{copy.itemSuffix}}</view>
        <view class="message-text-action ui-motion-chip" data-tab="todos" bindtap="openMessageCenter" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160">{{copy.viewAll}}</view>
      </view>
    </view>
    <scroll-view class="notification-list message-preview-scroll" scroll-y="{{true}}" enhanced="{{true}}" nested-scroll-enabled="{{true}}" show-scrollbar="{{false}}">
      <view class="notification-empty" wx:if="{{!todos.length && !todoLoading}}">
        <text class="notification-empty-text">{{copy.noTodos}}</text>
      </view>
      <view class="notification-item todo-item ui-motion-card" wx:for="{{todos}}" wx:key="id"
            data-id="{{item.id}}" bindtap="onTodoTap" hover-class="ui-press-card" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">
        <view class="notification-icon"><ui-icon name="{{item.category === 'venue' ? 'venue' : 'clock'}}" tone="primary" sizeRole="message-leading" ariaLabel="{{copy.todoType}}" /></view>
        <view class="notification-body">
          <view class="portal-message-metadata">
            <view class="portal-message-context-line">
              <text class="notification-tag notification-tag-{{item.category}}">{{item.categoryLabel}}</text>
              <text class="portal-identity-meta {{item.isCurrentContext ? 'portal-identity-meta-current' : ''}}">{{item.workContextName}}</text>
            </view>
            <view class="portal-organization-meta {{item.isCurrentOrganization ? 'portal-organization-meta-current' : ''}}">
              <ui-icon name="home" tone="primary" sizeRole="message-meta" ariaLabel="{{copy.organization}}" />
              <text class="portal-organization-name">{{item.organizationName}}</text>
              <text class="portal-organization-current" wx:if="{{item.isCurrentOrganization}}">{{copy.current}}</text>
            </view>
          </view>
          <view class="notification-title">
            {{item.title}}
          </view>
          <view class="notification-desc" wx:if="{{item.description}}">{{item.description}}</view>
          <view class="notification-time">{{item.createdAtText}}</view>
        </view>
        <ui-icon name="chevron-right" tone="muted" sizeRole="message-trailing" ariaLabel="{{copy.enter}}" />
      </view>
      <view class="message-loading-more" wx:if="{{todoLoadingMore}}">{{copy.loadingMore}}</view>
    </scroll-view>
  </view>

  <view class="card" wx:if="{{hasUser}}">
    <view class="info-head">
      <view class="section-title">{{copy.notificationTitle}}</view>
      <view class="message-head-actions">
        <view class="message-text-action ui-motion-chip" wx:if="{{notificationCount > 0}}" bindtap="markAllNotificationsRead" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160">{{copy.markAllRead}}</view>
        <view class="notification-badge" wx:if="{{notificationCount > 0}}">{{notificationCount > 99 ? '99+' : notificationCount}}</view>
        <view class="message-text-action ui-motion-chip" data-tab="notifications" bindtap="openMessageCenter" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160">{{copy.viewAll}}</view>
      </view>
    </view>
    <scroll-view class="notification-list message-preview-scroll" scroll-y="{{true}}" enhanced="{{true}}" nested-scroll-enabled="{{true}}" show-scrollbar="{{false}}">
      <view class="notification-empty" wx:if="{{!notifications.length && !notificationLoading}}">
        <text class="notification-empty-text">{{copy.noNotifications}}</text>
      </view>
      <view class="notification-swipe-row" wx:for="{{notifications}}" wx:key="id">
        <view class="notification-item {{item.isRead ? 'notification-read' : 'notification-unread'}} {{item._showDelete ? 'notification-shifted' : ''}} ui-motion-card"
              style="transform: translateX({{item._swipeX || 0}}px);"
              data-id="{{item.id}}" data-url="{{item.targetUrl}}"
              bindtap="onNotificationTap"
              bindtouchstart="onNotificationTouchStart"
              bindtouchmove="onNotificationTouchMove"
              bindtouchend="onNotificationTouchEnd" hover-class="ui-press-card" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">
          <view class="notification-dot" wx:if="{{!item.isRead}}"></view>
          <view class="notification-icon"><ui-icon name="{{item.category === 'venue' ? 'venue' : (item.category === 'scoring' ? 'grid' : 'bell')}}" tone="primary" sizeRole="message-leading" ariaLabel="{{copy.notificationType}}" /></view>
          <view class="notification-body">
            <view class="portal-message-metadata">
              <view class="portal-message-context-line">
                <text class="notification-tag notification-tag-{{item.category}}">{{item.categoryLabel}}</text>
                <text class="portal-identity-meta {{item.isCurrentContext ? 'portal-identity-meta-current' : ''}}">{{item.workContextName}}</text>
              </view>
              <view class="portal-organization-meta {{item.isCurrentOrganization ? 'portal-organization-meta-current' : ''}}">
                <ui-icon name="home" tone="primary" sizeRole="message-meta" ariaLabel="{{copy.organization}}" />
                <text class="portal-organization-name">{{item.organizationName}}</text>
                <text class="portal-organization-current" wx:if="{{item.isCurrentOrganization}}">{{copy.current}}</text>
              </view>
            </view>
            <view class="notification-title">
              {{item.title}}
            </view>
            <view class="notification-desc" wx:if="{{item.description}}">{{item.description}}</view>
            <view class="notification-time">{{item.createdAtText}}</view>
          </view>
          <ui-icon name="chevron-right" tone="muted" sizeRole="message-trailing" ariaLabel="{{copy.enter}}" />
        </view>
        <view class="notification-delete ui-motion-chip" wx:if="{{item._showDelete}}" data-id="{{item.id}}" catchtap="deleteNotification" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">{{copy.delete}}</view>
      </view>
      <view class="message-loading-more" wx:if="{{notificationLoadingMore}}">{{copy.loadingMore}}</view>
    </scroll-view>
  </view>

  <view class="card portal-services-card">
    <view class="info-head">
      <view class="section-title">{{copy.servicesTitle}}</view>
      <view class="app-view-tabs ui-compact-segmented">
        <view class="app-view-tab ui-compact-segmented-item {{appViewMode === 'grid' ? 'app-view-tab-active' : ''}} ui-motion-chip"
              data-mode="grid" bindtap="switchAppView" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">{{copy.grid}}</view>
        <view class="app-view-tab ui-compact-segmented-item {{appViewMode === 'list' ? 'app-view-tab-active' : ''}} ui-motion-chip"
              data-mode="list" bindtap="switchAppView" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">{{copy.list}}</view>
      </view>
    </view>

    <!-- 应用搜索栏 -->
    <view class="app-search-bar">
      <view class="app-search-icon"><ui-icon name="search" tone="muted" size="34" ariaLabel="{{copy.search}}" /></view>
      <input class="app-search-input"
             placeholder="{{copy.searchPlaceholder}}"
             value="{{appSearchKeyword}}"
             bindinput="onAppSearchInput"
             confirm-type="search"/>
      <view class="app-search-clear ui-motion-chip" wx:if="{{appSearchKeyword}}" bindtap="clearAppSearch" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}"><ui-icon name="x" tone="muted" size="30" ariaLabel="{{copy.clearSearch}}" /></view>
    </view>

    <!-- 无搜索结果 -->
    <view class="notification-empty" wx:if="{{!filteredPortalCards.length}}">
      <text class="notification-empty-text">{{appSearchKeyword ? copy.noMatchingApps : copy.noApps}}</text>
    </view>

    <!-- 宫格视图 -->
    <view class="app-grid" wx:if="{{appViewMode === 'grid' && filteredPortalCards.length}}">
      <view class="app-grid-item {{item.disabled ? 'app-grid-item-disabled' : ''}} ui-motion-card"
            wx:for="{{filteredPortalCards}}" wx:key="key"
            wx:for-item="item" wx:for-index="i"
            style="animation: serviceCardIn 0.28s {{0.04 * i}}s ease-out both;"
            data-key="{{item.key}}"
            bindtap="onCardTap"
            hover-class="ui-press-card"
            hover-start-time="0"
            hover-stay-time="160" hover-stop-propagation="{{true}}">
        <view class="app-grid-icon"><ui-icon name="{{item.iconName}}" tone="primary" size="48" ariaLabel="{{item.label}}" /></view>
        <view class="app-grid-label">{{item.label}}</view>
        <view class="app-grid-badge" wx:if="{{item.disabled}}">{{copy.developing}}</view>
      </view>
    </view>

    <!-- 列表视图 -->
    <view class="nav-list" wx:if="{{appViewMode === 'list' && filteredPortalCards.length}}">
      <view
        class="nav-row {{item.disabled ? 'nav-row-disabled' : ''}} ui-motion-card"
        wx:for="{{filteredPortalCards}}"
        wx:key="key"
        wx:for-item="item"
        wx:for-index="i"
        style="animation: serviceCardIn 0.28s {{0.04 * i}}s ease-out both;"
        data-key="{{item.key}}"
        bindtap="onCardTap"
        hover-class="ui-press-card"
        hover-start-time="0"
        hover-stay-time="160"
       hover-stop-propagation="{{true}}">
        <view class="nav-row-icon"><ui-icon name="{{item.iconName}}" tone="primary" sizeRole="feature-leading" ariaLabel="{{item.label}}" /></view>
        <view class="nav-row-body">
          <view class="nav-row-label">{{item.label}}</view>
        </view>
        <view class="nav-row-badge" wx:if="{{item.disabled}}">{{copy.developing}}</view>
        <ui-icon wx:if="{{!item.disabled}}" name="chevron-right" tone="muted" size="32" ariaLabel="{{copy.enter}}" />
      </view>
    </view>
  </view>

  <view class="portal-session-footer">
    <view class="actions">
      <button class="secondary-btn ui-motion-button" bindtap="goLogin" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">{{copy.workContextSwitch}}</button>
      <button class="danger-btn ui-motion-button" wx:if="{{hasUser}}" bindtap="logout" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">{{copy.logout}}</button>
    </view>

    <view class="page-footer">
      <view class="footer-name">{{copy.appName}}</view>
      <view class="footer-org">{{copy.organizationName}}</view>
    </view>
  </view>

  <viewport-portal wx:if="{{showMessageSwitchDialog}}">
  <view class="dialog-layer ui-overlay">
    <view class="dialog-mask ui-overlay-blocker" bindtap="closeMessageSwitchDialog" catchtouchmove="noop"></view>
    <view class="dialog-panel message-switch-dialog ui-dialog-shell ui-dialog-shell--compact">
      <scroll-view enhanced="{{true}}" show-scrollbar="{{true}}" bounces="{{true}}" nested-scroll-enabled="{{true}}" scroll-y class="ui-dialog-body ui-dialog-content ui-dialog-scroll--fill ui-dialog-stack-scroll">
        <view class="dialog-badge message-switch-badge">{{copy.crossOrganization}}</view>
        <view class="dialog-title">{{messageSwitchTitle}}</view>
        <view class="dialog-desc">{{copy.switchDescription}}</view>
        <view class="message-switch-org-name">{{messageSwitchOrganizationName}}</view>
      </scroll-view>
      <view class="dialog-actions ui-dialog-footer">
        <button class="secondary-btn dialog-btn ui-motion-button" bindtap="closeMessageSwitchDialog" disabled="{{messageSwitchLoading}}" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">{{copy.cancel}}</button>
        <button class="primary-btn dialog-btn ui-motion-button" loading="{{messageSwitchLoading}}" bindtap="confirmMessageOrganizationSwitch" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">{{copy.switchAndView}}</button>
      </view>
    </view>
  </view>
  </viewport-portal>

</view>
