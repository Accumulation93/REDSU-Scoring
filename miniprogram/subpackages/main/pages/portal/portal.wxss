/* ═══════════════════════════════════════════════
   Portal Page — same glass-morphism design
   as home page (matching home.wxss exactly)
   ═══════════════════════════════════════════════ */

page {
  min-height: 100%;
  background:
    radial-gradient(circle at 12% 10%, rgba(96, 165, 250, 0.16) 0%, transparent 26%),
    radial-gradient(circle at 86% 18%, rgba(191, 219, 254, 0.22) 0%, transparent 24%),
    radial-gradient(circle at 18% 88%, rgba(125, 211, 252, 0.10) 0%, transparent 22%),
    linear-gradient(135deg, #f8fbff 0%, #f1f6fc 48%, #edf3fa 100%);
  color: #1e293b;
  font-family: "PingFang SC", "Microsoft YaHei", sans-serif;
}

button, input, textarea, picker, view, text, scroll-view {
  font-family: "PingFang SC", "HarmonyOS Sans SC", "Microsoft YaHei", sans-serif;
}

.page {
  position: relative;
  min-height: 100vh;
  padding: var(--ui-page-padding-top) var(--ui-page-padding-x) calc(var(--ui-page-padding-bottom) + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.page::before {
  content: "";
  position: fixed;
  top: -120rpx; right: -90rpx;
  width: 320rpx; height: 320rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(96, 165, 250, 0.18) 0%, rgba(96, 165, 250, 0) 72%);
  pointer-events: none;
}

.page::after {
  content: "";
  position: fixed;
  left: -120rpx; bottom: 150rpx;
  width: 280rpx; height: 280rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(147, 197, 253, 0.16) 0%, rgba(147, 197, 253, 0) 72%);
  pointer-events: none;
}

/* ── 头部区域（沿用主页样式） ── */
.hero {
  position: relative;
  overflow: hidden;
  margin-bottom: var(--ui-hero-gap);
  padding: var(--ui-hero-padding-top) var(--ui-hero-padding-x) var(--ui-hero-padding-bottom);
  border-radius: var(--ui-hero-radius);
  background:
    linear-gradient(135deg, rgba(37, 99, 235, 0.98) 0%, rgba(59, 130, 246, 0.95) 42%, rgba(96, 165, 250, 0.90) 100%),
    linear-gradient(180deg, rgba(255, 255, 255, 0.10), rgba(255, 255, 255, 0));
  border: 1rpx solid rgba(255, 255, 255, 0.24);
  box-shadow:
    0 24rpx 54rpx rgba(37, 99, 235, 0.22),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.24);
  animation: glassFadeUp 0.42s ease both;
}

.hero::before {
  content: "";
  position: absolute;
  top: -90rpx; right: -35rpx;
  width: 240rpx; height: 240rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.14);
}

.hero::after {
  content: "";
  position: absolute;
  left: -90rpx; bottom: -120rpx;
  width: 280rpx; height: 280rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.08);
}

.hero-badge, .hero-title, .hero-subtitle {
  position: relative;
  z-index: 1;
}

.hero-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 18rpx;
  padding: 6rpx 12rpx;
  border-radius: var(--ui-compact-radius, 18rpx);
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.22) 0%, rgba(255, 255, 255, 0.14) 100%);
  border: 1rpx solid rgba(255, 255, 255, 0.28);
  color: #f8fbff;
  font-size: var(--ui-type-meta);
  font-weight: 600;
  letter-spacing: 1rpx;
  backdrop-filter: blur(14rpx);
  -webkit-backdrop-filter: blur(14rpx);
}

.hero-title {
  color: #ffffff;
  font-size: var(--ui-type-page, 46rpx);
  font-weight: 700;
  line-height: 1.24;
  letter-spacing: 1rpx;
  text-shadow: 0 6rpx 16rpx rgba(0, 0, 0, 0.08);
}

.hero-subtitle {
  margin-top: 12rpx;
  color: rgba(255, 255, 255, 0.92);
  font-size: var(--ui-type-emphasis, 26rpx);
  line-height: 1.5;
}

/* ── 玻璃卡片 ── */
.card {
  position: relative;
  margin-bottom: var(--ui-card-gap);
  padding: var(--ui-card-padding-y) var(--ui-card-padding-x);
  border-radius: var(--ui-card-radius);
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.80) 0%, rgba(248, 251, 255, 0.72) 100%);
  border: 1rpx solid rgba(255, 255, 255, 0.62);
  box-shadow:
    0 18rpx 36rpx rgba(15, 23, 42, 0.06),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.78);
  backdrop-filter: blur(24rpx);
  -webkit-backdrop-filter: blur(24rpx);
  box-sizing: border-box;
  animation: glassFadeUp 0.46s ease both;
}

.card:active {
  transform: none !important;
  filter: none !important;
}

/* ── 信息标题与分区标题 ── */
.info-head {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--ui-inline-gap);
  margin-bottom: var(--ui-field-gap);
}

.section-title {
  position: relative;
  padding-left: var(--ui-section-title-inset);
  color: #0f172a;
  font-size: var(--ui-type-section, 30rpx);
  font-weight: 700;
  line-height: 1.4;
  letter-spacing: 0.2rpx;
}

.section-title::before {
  content: "";
  position: absolute;
  left: 0; top: 50%;
  transform: translateY(-50%);
  width: 7rpx; height: 28rpx;
  border-radius: 999rpx;
  background: linear-gradient(180deg, #2563eb 0%, #60a5fa 100%);
}

/* ── 组织名称展示 ── */
.activity-name {
  position: relative;
  z-index: 1;
  margin-top: 6rpx;
  margin-bottom: 10rpx;
  padding: 8rpx 4rpx;
  color: #0f172a;
  font-size: var(--ui-type-value, 28rpx);
  font-weight: 700;
  line-height: 1.48;
  letter-spacing: 0.2rpx;
  word-break: break-word;
}

.activity-name::after {
  content: "";
  display: block;
  width: 72rpx;
  height: 4rpx;
  margin-top: 12rpx;
  border-radius: 999rpx;
  background: linear-gradient(90deg, rgba(59, 130, 246, 0.46), rgba(59, 130, 246, 0.08));
}

/* ── 信息网格与信息块 ── */
.info-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: var(--ui-field-gap);
}

.info-block {
  width: auto;
  min-width: 0;
  padding: var(--ui-list-padding-y) var(--ui-list-padding-x);
  border-radius: 24rpx;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.92) 0%, rgba(248, 251, 255, 0.80) 100%);
  border: 1rpx solid rgba(255, 255, 255, 0.68);
  box-shadow:
    0 10rpx 24rpx rgba(15, 23, 42, 0.035),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.78);
  box-sizing: border-box;
}

.info-block-full {
  width: auto;
  grid-column: 1 / -1;
  background: linear-gradient(135deg, rgba(239, 246, 255, 0.6) 0%, rgba(219, 234, 254, 0.4) 100%);
  border: 1rpx solid rgba(191, 219, 254, 0.6);
}

.info-label {
  margin-bottom: var(--ui-label-gap);
  color: #64748b;
  font-size: var(--ui-type-label, 23rpx);
  line-height: 1.5;
}

.info-value {
  color: #0f172a;
  font-size: var(--ui-type-value, 28rpx);
  font-weight: 700;
  line-height: 1.5;
  word-break: break-word;
  overflow-wrap: anywhere;
}

/* ── 卡片内导航行 ── */
.nav-list {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.nav-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 18rpx 20rpx;
  border-radius: 18rpx;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.88) 0%, rgba(246, 249, 255, 0.78) 100%);
  border: 1rpx solid rgba(219, 229, 241, 0.82);
  transition: box-shadow 0.16s ease;
}

.nav-row-disabled {
  opacity: 0.50;
}

.nav-row-disabled:active {
  transform: none;
}

.nav-row-icon {
  font-size: var(--ui-type-dialog);
  line-height: 1;
  flex-shrink: 0;
}

.nav-row-body {
  flex: 1;
  min-width: 0;
}

.nav-row-label {
  font-size: var(--ui-type-emphasis);
  font-weight: 700;
  color: #0f172a;
  line-height: 1.35;
}

.nav-row-desc {
  font-size: var(--ui-type-caption);
  color: #94a3b8;
  font-weight: 500;
  line-height: 1.4;
  margin-top: 2rpx;
}

.nav-row-arrow {
  font-size: var(--ui-type-dialog);
  color: #94a3b8;
  font-weight: 300;
  flex-shrink: 0;
}

.nav-row-badge {
  font-size: var(--ui-type-micro);
  font-weight: 600;
  color: #c2410c;
  background: rgba(255, 237, 213, 0.78);
  padding: 4rpx 14rpx;
  border-radius: var(--ui-compact-radius, 18rpx);
  border: 1rpx solid rgba(253, 186, 116, 0.48);
  flex-shrink: 0;
}

/* ── 操作区 ── */
.portal-session-footer {
  margin-top: var(--ui-action-gap);
}

.actions {
  display: grid;
  gap: var(--ui-page-action-gap);
  margin: 0;
  padding: 0;
}

.actions button {
  position: relative;
  overflow: hidden;
  width: 100%;
  min-height: var(--ui-control-height);
  height: auto;
  padding: var(--ui-control-padding-y) var(--ui-control-padding-x);
  line-height: var(--ui-line-control);
  margin: 0;
  border: none;
  border-radius: var(--ui-control-radius, 28rpx);
  font-size: var(--ui-type-value);
  font-weight: 700;
  letter-spacing: 0.5rpx;
  box-shadow:
    0 16rpx 30rpx rgba(15, 23, 42, 0.06),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.24);
}

.actions button::after { border: none; }

.actions button::before {
  content: "";
  position: absolute;
  top: 0; left: -120%;
  width: 72%; height: 100%;
  background: linear-gradient(90deg, rgba(255, 255, 255, 0) 0%, rgba(255, 255, 255, 0.24) 50%, rgba(255, 255, 255, 0) 100%);
}

.primary-btn, .secondary-btn, .danger-btn {
  flex: 1 1 280rpx;
  min-width: 220rpx;
  min-height: var(--ui-control-height);
  height: auto;
  border-radius: var(--ui-control-radius, 28rpx);
  line-height: var(--ui-line-control);
  font-size: var(--ui-type-control);
  font-weight: 700;
  padding: var(--ui-control-padding-y) var(--ui-control-padding-x);
  letter-spacing: 0.3rpx;
  transition: box-shadow 0.24s ease, opacity 0.18s ease, filter 0.24s ease, transform 0.18s ease;
}

.primary-btn {
  background: linear-gradient(135deg, #2563eb 0%, #3b82f6 45%, #60a5fa 100%);
  color: #ffffff;
  box-shadow:
    0 20rpx 34rpx rgba(37, 99, 235, 0.20),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.24);
}

.secondary-btn {
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.96) 0%, rgba(246, 249, 255, 0.88) 100%);
  color: #1e293b;
  border: 1rpx solid rgba(219, 229, 241, 0.96);
  box-shadow:
    0 10rpx 22rpx rgba(15, 23, 42, 0.05),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.84);
}

.danger-btn {
  background: linear-gradient(135deg, #ef4444 0%, #f87171 100%);
  color: #ffffff;
  box-shadow:
    0 16rpx 30rpx rgba(239, 68, 68, 0.16),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.18);
}

.primary-btn:active, .secondary-btn:active, .danger-btn:active {
  transform: translateY(2rpx) scale(0.985);
  opacity: 0.94;
  filter: saturate(1.03);
}

/* ── 页脚 ── */
.page-footer {
  margin-top: var(--ui-footer-gap);
  text-align: center;
  padding: 0;
}

.footer-name {
  font-size: var(--ui-type-meta);
  font-weight: 600;
  color: #94a3b8;
}

.footer-org {
  font-size: var(--ui-type-caption);
  color: #94a3b8;
}

/* ── 通知卡片 ── */
.notification-badge {
  flex-shrink: 0; min-width: 40rpx; height: 40rpx; padding: 0 10rpx; border-radius: var(--ui-compact-radius, 18rpx);
  display: flex; align-items: center; justify-content: center;
  background: linear-gradient(135deg, rgba(254,242,242,0.94) 0%, rgba(254,226,226,0.84) 100%);
  color: #dc2626; font-size: var(--ui-type-meta); font-weight: 800;
  border: 1rpx solid rgba(252,165,165,0.5);
}

.todo-count {
  flex-shrink: 0;
  min-width: 64rpx;
  height: 40rpx;
  padding: 0 16rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, rgba(239,246,255,0.96) 0%, rgba(219,234,254,0.86) 100%);
  color: #2563eb;
  font-size: var(--ui-type-meta);
  font-weight: 800;
  border: 1rpx solid rgba(147,197,253,0.5);
}

.notification-list {
  position: relative; z-index: 1;
}

.message-preview-scroll {
  height: auto;
  max-height: calc(var(--ui-message-preview-row, 154rpx) * 3 + var(--ui-message-preview-gap, 8rpx) * 2);
  min-height: 52rpx;
}

.message-preview-scroll .notification-item,
.message-preview-scroll .notification-swipe-row {
  margin-bottom: 0;
}

.message-preview-scroll .notification-swipe-row + .notification-swipe-row {
  margin-top: var(--ui-message-preview-gap, 8rpx);
}

.message-preview-scroll > .notification-item + .notification-item {
  margin-top: var(--ui-message-preview-gap, 8rpx);
}

.message-head-actions {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: var(--ui-inline-gap);
  flex-wrap: wrap;
}

.message-text-action {
  color: #2563eb;
  font-size: var(--ui-type-meta);
  font-weight: 700;
  padding: var(--ui-compact-padding-y) var(--ui-compact-padding-x);
  border-radius: var(--ui-compact-radius, 18rpx);
}

.message-loading-more {
  padding: 12rpx 0 20rpx;
  text-align: center;
  color: #94a3b8;
  font-size: var(--ui-type-caption);
}

.portal-message-partial {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: var(--ui-card-gap);
  padding: 14rpx 18rpx;
  border: 1rpx solid rgba(56,189,248,0.42);
  border-radius: 18rpx;
  color: #0369a1;
  font-size: var(--ui-type-meta);
  font-weight: 650;
  background: linear-gradient(135deg, rgba(240,249,255,0.94), rgba(224,242,254,0.72));
  box-shadow: 0 10rpx 22rpx rgba(15,23,42,0.04), inset 0 1rpx 0 rgba(255,255,255,0.82);
}

.notification-item {
  position: relative;
  z-index: 1;
  display: flex; align-items: flex-start; gap: 14rpx;
  padding: 18rpx 16rpx; border-radius: 16rpx;
  background: linear-gradient(135deg, rgba(255,255,255,0.82) 0%, rgba(246,249,255,0.72) 100%);
  border: 1rpx solid rgba(219,229,241,0.76);
  transition: box-shadow 0.14s ease;
}

.todo-item {
  border-color: rgba(147,197,253,0.42);
}

.notification-swipe-row {
  position: relative;
  overflow: hidden;
  border-radius: 16rpx;
}

.notification-shifted {
  transform: translateX(-72px);
}

.notification-delete {
  position: absolute;
  right: 0;
  top: 0;
  bottom: 0;
  width: 72px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 0 16rpx 16rpx 0;
  background: linear-gradient(135deg, #ef4444 0%, #f87171 100%);
  color: #ffffff;
  font-size: var(--ui-type-control);
  font-weight: 800;
  z-index: 0;
}

.notification-unread {
  background: linear-gradient(135deg, rgba(255,255,255,0.96) 0%, rgba(239,246,255,0.84) 100%);
  border-color: rgba(147,197,253,0.55);
}

.notification-read {
  opacity: 0.78;
}

.notification-dot {
  position: absolute;
  top: 14rpx;
  left: 12rpx;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #ef4444;
  box-shadow: 0 0 0 6rpx rgba(239,68,68,0.10);
}

.notification-item:active {
  transform: translateY(1rpx) scale(0.992);
}

.notification-swipe-row .notification-item[style*="translateX"]:active {
  opacity: 0.96;
}

.notification-icon {
  flex-shrink: 0; width: 56rpx; height: 56rpx; border-radius: 16rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: var(--ui-type-value);
  background: linear-gradient(135deg, rgba(239,246,255,0.94) 0%, rgba(219,234,254,0.84) 100%);
  border: 1rpx solid rgba(147,197,253,0.4);
}

.notification-body {
  flex: 1; min-width: 0;
}

.portal-message-metadata {
  display: grid;
  grid-template-columns: minmax(0, 1fr);
  gap: 6rpx;
  margin-bottom: 7rpx;
}

.portal-message-context-line {
  display: flex;
  align-items: center;
  gap: 8rpx;
  width: 100%;
  min-width: 0;
}

.portal-organization-meta {
  display: flex;
  align-items: center;
  gap: 6rpx;
  width: 100%;
  min-width: 0;
  padding: 4rpx 9rpx;
  border: 1rpx solid rgba(186,210,232,0.72);
  border-radius: var(--ui-compact-radius, 18rpx);
  color: #475569;
  font-size: var(--ui-type-micro);
  font-weight: 700;
  line-height: 1.35;
  background: linear-gradient(135deg, rgba(248,250,252,0.94), rgba(241,245,249,0.78));
  box-sizing: border-box;
}

.portal-organization-meta-current {
  border-color: rgba(147,197,253,0.64);
  color: #2563eb;
  background: linear-gradient(135deg, rgba(239,246,255,0.94), rgba(219,234,254,0.78));
}

.portal-identity-meta {
  min-width: 0;
  max-width: 100%;
  padding: 5rpx 10rpx;
  border: 1rpx solid rgba(203,213,225,0.74);
  border-radius: 12rpx;
  color: #64748b;
  font-size: var(--ui-type-micro);
  font-weight: 700;
  line-height: 1.45;
  background: rgba(248,250,252,0.74);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.portal-identity-meta-current {
  color: #2563eb;
  border-color: rgba(147,197,253,0.56);
  background: rgba(219,234,254,0.68);
}

.portal-organization-name {
  flex: 1;
  min-width: 0;
  overflow-wrap: break-word;
}

.portal-organization-current {
  flex: 0 0 auto;
  color: #2563eb;
  font-size: var(--ui-type-micro);
  font-weight: 800;
  white-space: nowrap;
}

.notification-tag {
  flex: 0 0 auto;
  white-space: nowrap;
}

.notification-title {
  color: #0f172a; font-size: var(--ui-type-emphasis); font-weight: 700;
  white-space: normal; overflow-wrap: anywhere;
}

.notification-desc {
  color: #64748b; font-size: var(--ui-type-caption); margin-top: 2rpx;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}

.notification-time {
  color: #94a3b8; font-size: var(--ui-type-micro); margin-top: 4rpx;
}

.notification-empty {
  text-align: center;
  padding: 8rpx 0;
}

.notification-empty-text {
  color: #94a3b8; font-size: var(--ui-type-control);
}

/* ── 弹窗 ── */
.dialog-layer {
  position: fixed;
  inset: 0;
  z-index: 99;
}

.dialog-mask {
  position: absolute;
  inset: 0;
  background: rgba(15, 23, 42, 0.34);
  backdrop-filter: blur(6rpx);
  -webkit-backdrop-filter: blur(6rpx);
}

.dialog-panel {
  position: relative;
  padding: var(--ui-dialog-padding);
  border-radius: var(--ui-dialog-radius);
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.95) 0%, rgba(248, 251, 255, 0.9) 100%);
  border: 1rpx solid rgba(255, 255, 255, 0.82);
  box-shadow: 0 22rpx 44rpx rgba(15, 23, 42, 0.14);
}

.dialog-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: var(--ui-compact-padding-y) var(--ui-compact-padding-x);
  border-radius: var(--ui-compact-radius, 18rpx);
  background: linear-gradient(135deg, rgba(219, 234, 254, 0.94) 0%, rgba(191, 219, 254, 0.86) 100%);
  color: #2563eb;
  font-size: var(--ui-type-meta);
  font-weight: 700;
}

.dialog-title {
  margin-top: 18rpx;
  color: #0f172a;
  font-size: var(--ui-type-dialog, 32rpx);
  font-weight: 700;
  line-height: 1.4;
}

.dialog-desc {
  margin-top: 12rpx;
  color: #64748b;
  font-size: var(--ui-type-control, 24rpx);
  line-height: var(--ui-leading-relaxed, 1.7);
}

.dialog-actions {
  display: flex;
  gap: var(--ui-inline-gap);
  margin-top: 0;
}

.dialog-btn {
  flex: 1;
  min-width: 0;
  margin-bottom: 0 !important;
}

.message-switch-badge {
  border-radius: var(--ui-compact-radius, 18rpx);
}

.message-switch-org-name {
  margin-top: var(--ui-inline-gap);
  padding: var(--ui-list-padding-y) var(--ui-list-padding-x);
  border: 1rpx solid rgba(147,197,253,0.58);
  border-radius: 16rpx;
  color: #2563eb;
  font-size: var(--ui-type-body);
  font-weight: 750;
  line-height: 1.45;
  overflow-wrap: anywhere;
  background: linear-gradient(135deg, rgba(239,246,255,0.96), rgba(219,234,254,0.72));
}

/* ── 动画 ── */
@keyframes glassFadeUp {
  from { opacity: 0; transform: translateY(18rpx); }
  to { opacity: 1; transform: translateY(0); }
}

/* ═══════════════════════════════════════════════
   App Services — View Toggle, Search, Grid
   ═══════════════════════════════════════════════ */

/* ── 视图切换标签 ── */
.app-view-tabs {
  display: flex;
  gap: var(--ui-tab-gap, 8rpx);
  flex-shrink: 0;
  padding: var(--ui-tab-shell-padding, 8rpx);
  background: linear-gradient(135deg, rgba(255,255,255,0.80) 0%, rgba(248,251,255,0.64) 100%);
  border-radius: var(--ui-tab-shell-radius, 26rpx);
  border: 1rpx solid rgba(255,255,255,0.72);
  box-shadow: 0 10rpx 22rpx rgba(15,23,42,0.045), inset 0 1rpx 0 rgba(255,255,255,0.82);
  overflow: hidden;
  box-sizing: border-box;
}

.app-view-tab {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: var(--ui-tab-min-height, 66rpx);
  padding: var(--ui-tab-padding-y, 14rpx) var(--ui-tab-padding-x, 18rpx);
  font-size: var(--ui-tab-font-size, 24rpx);
  font-weight: 600;
  color: #64748b;
  line-height: var(--ui-leading-control, 1.35);
  border-radius: var(--ui-tab-radius, 20rpx);
  box-sizing: border-box;
  transition: color 0.18s ease, background 0.18s ease, border-color 0.18s ease, box-shadow 0.22s ease, transform 0.18s ease;
}

.app-view-tab-active {
  background: linear-gradient(135deg, #2563eb 0%, #3b82f6 58%, #60a5fa 100%);
  color: #ffffff;
  box-shadow: 0 8rpx 16rpx rgba(37, 99, 235, 0.20), inset 0 1rpx 0 rgba(255,255,255,0.24);
}

.portal-services-card > .info-head {
  flex-wrap: wrap;
}

/* ── 搜索栏 ── */
.app-search-bar {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: var(--ui-card-gap);
  padding: 14rpx 20rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.92) 0%, rgba(246, 249, 255, 0.82) 100%);
  border: 1rpx solid rgba(219, 229, 241, 0.96);
  box-shadow: 0 8rpx 18rpx rgba(15,23,42,0.035), inset 0 1rpx 0 rgba(255,255,255,0.86);
}

.app-search-icon {
  font-size: var(--ui-type-value);
  flex-shrink: 0;
  opacity: 0.55;
}

.app-search-input {
  flex: 1;
  min-width: 0;
  font-size: var(--ui-type-control);
  color: #0f172a;
  line-height: 1.4;
}

.app-search-input::placeholder {
  color: #94a3b8;
}

.app-search-clear {
  flex-shrink: 0;
  width: 36rpx;
  height: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(148, 163, 184, 0.22);
  color: #64748b;
  font-size: var(--ui-type-meta);
  font-weight: 700;
}

/* ── 宫格视图 ── */
.app-grid {
  position: relative;
  z-index: 1;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12rpx;
}

.app-grid-item {
  position: relative;
  width: auto;
  min-width: 0;
  padding: 12rpx 8rpx;
  border-radius: 18rpx;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.88) 0%, rgba(246, 249, 255, 0.78) 100%);
  border: 1rpx solid rgba(219, 229, 241, 0.76);
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  transition: transform 0.16s ease, box-shadow 0.16s ease;
}

.app-grid-item:active {
  transform: translateY(1rpx) scale(0.97);
  box-shadow: 0 6rpx 14rpx rgba(15, 23, 42, 0.05);
}

.app-grid-item-disabled {
  opacity: 0.48;
}

.app-grid-item-disabled:active {
  transform: none;
}

.app-grid-icon {
  font-size: var(--ui-type-page);
  line-height: 1;
  margin-bottom: 4rpx;
}

.app-grid-label {
  font-size: var(--ui-type-meta);
  font-weight: 700;
  color: #0f172a;
  line-height: 1.3;
  margin-bottom: 0;
  white-space: normal;
  overflow-wrap: anywhere;
  max-width: 100%;
}

.app-grid-desc {
  font-size: var(--ui-type-micro);
  color: #94a3b8;
  font-weight: 500;
  line-height: 1.3;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 100%;
}

.app-grid-badge {
  position: absolute;
  top: 6rpx;
  right: 6rpx;
  font-size: var(--ui-type-micro);
  font-weight: 600;
  color: #c2410c;
  background: rgba(255, 237, 213, 0.84);
  padding: 2rpx 10rpx;
  border-radius: var(--ui-compact-radius, 18rpx);
  border: 1rpx solid rgba(253, 186, 116, 0.44);
}

@keyframes serviceCardIn {
  from {
    opacity: 0.01;
    filter: blur(1rpx) saturate(0.98);
  }

  to {
    opacity: 1;
    filter: blur(0) saturate(1);
  }
}

/* ═══════════════════════════════════════════════════════════
   平板适配 — portal 页面独立适配（不 import home.wxss）
   必须用 px 值。520px 断点覆盖全部平板竖屏。
   ═══════════════════════════════════════════════════════════ */
@media (min-width: 520px) {
  /* ── 页面容器 ── */
  .page {
    max-width: 760px;
    margin-left: auto;
    margin-right: auto;
    padding: var(--ui-page-padding-top) var(--ui-page-padding-x) calc(var(--ui-page-padding-bottom) + env(safe-area-inset-bottom));
  }

  /* ── 二列信息网格：铺满卡片，不再二次居中限宽 ── */
  .info-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    justify-content: stretch;
    gap: 16px;
  }

  .info-block {
    width: auto;
    max-width: none;
  }

  .info-block-full {
    grid-column: 1 / -1;
  }

  /* ── 宫格：三列等分并铺满应用中心 ── */
  .app-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    justify-content: stretch;
    gap: 12px;
  }

  .app-grid-item {
    width: auto;
    max-width: none;
  }

  .info-label,
  .nav-row-desc,
  .notification-desc,
  .notification-time,
  .app-grid-desc {
    font-size: var(--ui-type-meta) !important;
    line-height: 1.55 !important;
  }

  .info-value,
  .nav-row-label,
  .notification-title,
  .app-grid-label {
    font-size: var(--ui-type-value) !important;
    line-height: 1.5 !important;
  }

  .activity-name {
    font-size: var(--ui-type-value) !important;
    line-height: 1.45 !important;
  }

  .app-search-input {
    font-size: var(--ui-type-label) !important;
    line-height: 1.55 !important;
  }

  .app-view-tab {
    font-size: var(--ui-tab-font-size) !important;
    line-height: var(--ui-leading-control) !important;
  }

  .app-grid-badge {
    font-size: var(--ui-type-micro) !important;
    line-height: 16px !important;
  }

  .portal-message-partial {
    padding: 10px 14px;
    border-radius: 12px;
    font-size: var(--ui-type-label);
  }

  .notification-item {
    gap: 10px;
    padding: 12px 14px;
    border-radius: 12px;
  }

  .notification-icon {
    width: 42px;
    height: 42px;
    border-radius: 11px;
  }

  .portal-message-metadata {
    gap: 4px;
    margin-bottom: 5px;
  }

  .portal-message-context-line {
    gap: 6px;
  }

  .portal-organization-meta {
    gap: 5px;
    padding: 3px 7px;
  }

  .portal-identity-meta {
    padding: 3px 7px;
    border-radius: 12px;
  }

  .actions {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .portal-organization-meta,
  .notification-tag {
    border-radius: 12px;
    font-size: var(--ui-type-caption);
  }
}

@media (min-width: 900px) and (orientation: landscape) {
  .page {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: start;
    gap: var(--ui-card-gap);
    max-width: 1180px;
    padding: var(--ui-page-padding-top) var(--ui-page-padding-x) calc(var(--ui-page-padding-bottom) + env(safe-area-inset-bottom));
  }

  .page > .hero,
  .page > .workspace-hero-host,
  .page > .portal-profile-card,
  .page > .portal-services-card,
  .page > .portal-message-partial,
  .page > .portal-session-footer,
  .page > .dialog-layer {
    grid-column: 1 / -1;
  }

  .page > .card,
  .page > .hero,
  .page > .workspace-hero-host,
  .page > .portal-session-footer {
    margin-bottom: 0;
  }

  .portal-session-footer {
    margin-top: 0;
  }

  .notification-item {
    gap: 8px;
    padding: 10px 12px;
  }

  .notification-icon {
    width: 36px;
    height: 36px;
    border-radius: 10px;
  }

  .portal-services-card .app-grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
  }

  .portal-services-card .app-grid-item {
    width: auto;
    max-width: none;
    min-height: 118px;
    justify-content: center;
  }
}

/* Hero 内的组织上下文只让自身响应按压，Hero 外壳始终静止。 */
.hero-org-context {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  gap: 14rpx;
  min-width: 0;
  margin-top: 26rpx;
  padding: 16rpx 18rpx;
  border-radius: 22rpx;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.20), rgba(255, 255, 255, 0.11));
  border: 1rpx solid rgba(255, 255, 255, 0.25);
  box-shadow: 0 12rpx 26rpx rgba(30, 64, 175, 0.10), inset 0 1rpx 0 rgba(255, 255, 255, 0.20);
  backdrop-filter: blur(16rpx);
  -webkit-backdrop-filter: blur(16rpx);
  transition: transform 0.20s cubic-bezier(0.16, 0.84, 0.28, 1), background 0.20s ease, box-shadow 0.22s ease;
}

.hero-org-context-pressing {
  transform: translate3d(0, 2rpx, 0) scale(0.994);
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.25), rgba(255, 255, 255, 0.14));
  box-shadow: 0 6rpx 16rpx rgba(30, 64, 175, 0.08), inset 0 1rpx 0 rgba(255, 255, 255, 0.18);
}

.hero-org-context-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 50rpx;
  height: 50rpx;
  flex-shrink: 0;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.16);
}

.hero-org-context-copy {
  flex: 1;
  min-width: 0;
}

.hero-org-context-label {
  color: rgba(255, 255, 255, 0.72);
  font-size: var(--ui-type-caption);
  line-height: 1.3;
}

.hero-org-context-name {
  margin-top: 3rpx;
  color: #ffffff;
  font-size: var(--ui-type-value);
  font-weight: 800;
  line-height: 1.45;
  overflow-wrap: anywhere;
}

.hero-context-identity {
  margin-top: 3rpx;
  color: rgba(239, 246, 255, 0.88);
  font-size: var(--ui-type-caption);
  font-weight: 700;
  line-height: 1.55;
  overflow-wrap: anywhere;
}

.hero-org-context-action {
  display: flex;
  align-items: center;
  gap: 4rpx;
  flex-shrink: 0;
  padding: 7rpx 10rpx 7rpx 14rpx;
  border-radius: var(--ui-compact-radius, 18rpx);
  color: rgba(255, 255, 255, 0.94);
  font-size: var(--ui-type-caption);
  font-weight: 700;
  white-space: nowrap;
  background: rgba(255, 255, 255, 0.13);
}

@media (min-width: 520px) {
  .hero-org-context {
    gap: 12px;
    margin-top: 20px;
    padding: 13px 15px;
    border-radius: 17px;
  }

  .hero-org-context-icon {
    width: 40px;
    height: 40px;
    border-radius: 13px;
  }

  .hero-org-context-label,
  .hero-org-context-action {
    font-size: var(--ui-type-caption);
  }

  .hero-org-context-name {
    font-size: var(--ui-type-emphasis);
  }

}
