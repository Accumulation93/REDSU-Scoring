page {
  min-height: 100%;
}

.page::before,
.page::after {
  content: "";
  /* 纯装饰层必须随登录页一起销毁，fixed 会在部分 WebKit 合成层中覆盖下一页。 */
  position: absolute;
  z-index: 0;
  border-radius: 50%;
  pointer-events: none;
}

.page::before {
  top: -120rpx;
  right: -90rpx;
  width: 320rpx;
  height: 320rpx;
  background: radial-gradient(circle, rgba(96,165,250,0.18), rgba(96,165,250,0) 72%);
}

.page::after {
  left: -120rpx;
  bottom: 150rpx;
  width: 280rpx;
  height: 280rpx;
  background: radial-gradient(circle, rgba(147,197,253,0.16), rgba(147,197,253,0) 72%);
}

.login-layout,
.page-footer {
  position: relative;
  z-index: 1;
}

.login-layout {
  width: 100%;
  max-width: 680rpx;
  margin: 0 auto var(--ui-card-gap);
}

.login-hero {
  margin-bottom: 18rpx;
  padding: 32rpx 30rpx 28rpx;
}

.login-main {
  min-width: 0;
}

.login-notice {
  display: flex;
  align-items: flex-start;
  gap: 11rpx;
  margin-bottom: 16rpx;
  padding: 16rpx 18rpx;
  border: 1rpx solid rgba(147,197,253,0.68);
  border-radius: 16rpx;
  color: #2563eb;
  font-size: var(--ui-type-body);
  font-weight: 650;
  line-height: 1.6;
  background: linear-gradient(135deg, rgba(239,246,255,0.94), rgba(219,234,254,0.72));
  box-shadow: inset 0 1rpx 0 rgba(255,255,255,0.78);
  box-sizing: border-box;
}

.login-notice text {
  flex: 1;
  min-width: 0;
  overflow-wrap: anywhere;
}

.login-card {
  margin-bottom: 0;
  padding: 26rpx 24rpx;
  animation: glassFadeUp 0.5s cubic-bezier(0.16,0.84,0.28,1) both;
}

.login-card:active {
  transform: none;
  filter: none;
}

.login-card .section-title {
  margin-bottom: 14rpx;
}

.card-desc {
  margin: 0 0 20rpx;
  color: #64748b;
  font-size: var(--ui-type-meta);
  line-height: 1.7;
}

.sheet-note {
  margin-bottom: var(--ui-action-gap);
  padding: 16rpx 18rpx;
  border: 1rpx solid rgba(191,219,254,0.72);
  border-radius: 16rpx;
  color: #52677f;
  font-size: var(--ui-type-meta);
  line-height: 1.68;
  background: rgba(239,246,255,0.72);
}

.field-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
  min-height: 86rpx;
  padding: 17rpx 20rpx;
  border: 1rpx solid rgba(203,213,225,0.82);
  border-radius: 16rpx;
  color: #1e293b;
  font-size: var(--ui-type-body);
  line-height: 1.55;
  background: rgba(255,255,255,0.78);
}

.field-picker-arrow {
  margin-left: 18rpx;
  color: #64748b;
  font-size: var(--ui-type-dialog);
}

.verification-input {
  letter-spacing: 4rpx;
  text-transform: uppercase;
}

.recovery-code-box {
  box-sizing: border-box;
  width: 100%;
  margin: 0 0 var(--ui-action-gap);
  padding: 22rpx;
  border: 1rpx solid rgba(96, 165, 250, 0.42);
  border-radius: 16rpx;
  background: rgba(239, 246, 255, 0.9);
  color: #2563eb;
  font-size: var(--ui-type-value);
  font-weight: 700;
  line-height: 1.55;
  letter-spacing: 2rpx;
  overflow-wrap: anywhere;
  text-align: center;
}

.recovery-actions {
  display: flex;
  flex-direction: column;
  gap: var(--ui-action-gap);
}

.recovery-actions .secondary-btn,
.recovery-actions .primary-btn {
  width: 100%;
  margin: 0;
}

.sheet-link {
  box-sizing: border-box;
  width: fit-content;
  max-width: 100%;
  margin: 18rpx auto 0;
  padding: 8rpx 12rpx;
  border-radius: var(--ui-compact-radius, 18rpx);
  color: #2563eb;
  font-size: var(--ui-type-label);
  font-weight: 700;
  line-height: 1.55;
  text-align: center;
}

.login-card .primary-btn {
  width: 100%;
  min-height: var(--ui-control-height);
  font-size: var(--ui-type-body);
}

.sheet {
  position: fixed;
  inset: 0;
  width: 100vw;
  height: 100vh;
  z-index: 120;
  overflow: hidden;
  pointer-events: none;
}

.sheet-show {
  pointer-events: auto;
}

.sheet-mask {
  position: fixed;
  inset: 0;
  width: 100vw;
  height: 100vh;
  background: rgba(15,23,42,0.36);
  opacity: 0;
  transition: opacity 0.24s ease;
}

.sheet-show .sheet-mask {
  opacity: 1;
}

.sheet-panel {
  position: fixed;
  left: 18rpx;
  right: 18rpx;
  bottom: calc(18rpx + env(safe-area-inset-bottom));
  padding: var(--ui-dialog-padding);
  border-radius: 30rpx;
  background: linear-gradient(135deg, rgba(255,255,255,0.97), rgba(247,250,255,0.90));
  border: 1rpx solid rgba(255,255,255,0.82);
  box-shadow:
    0 26rpx 56rpx rgba(15,23,42,0.16),
    inset 0 1rpx 0 rgba(255,255,255,0.90);
  transform: translateY(112%);
  transition: transform 0.28s cubic-bezier(0.16,0.84,0.28,1);
  backdrop-filter: blur(28rpx);
  -webkit-backdrop-filter: blur(28rpx);
  display: flex;
  flex-direction: column;
  max-height: calc(100vh - 36rpx - env(safe-area-inset-bottom));
  overflow-x: hidden;
  overflow-y: hidden;
  overscroll-behavior: contain;
  z-index: 1;
}

.login-secondary-link {
  margin: 16rpx auto 0;
  width: fit-content;
  padding: 8rpx 14rpx;
  color: #2563eb;
  font-size: var(--ui-type-label);
  line-height: 1.4;
}

.sheet-show .sheet-panel {
  transform: translateY(0);
}

.sheet-header {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-bottom: var(--ui-dialog-section-gap);
}

.sheet-title {
  color: #0f172a;
  font-size: var(--ui-type-dialog);
  font-weight: 800;
  line-height: var(--ui-leading-heading);
}

.sheet-close {
  flex-shrink: 0;
  padding: 6rpx 0 6rpx 14rpx;
  color: #475569;
  font-size: var(--ui-type-label);
  font-weight: 700;
}

.field {
  margin-bottom: var(--ui-field-gap);
}

.field-label {
  margin-bottom: var(--ui-label-gap);
  color: #64748b;
  font-size: var(--ui-type-label);
  font-weight: 650;
  line-height: 1.5;
}

.field-input {
  min-height: var(--ui-field-control-height, 82rpx);
  line-height: 1.55;
}

.sheet-panel .primary-btn {
  width: 100%;
  margin-top: 0;
}

@media (max-width: 360px) {
  .login-hero {
    padding: 28rpx 24rpx 24rpx;
  }

}

@media (min-width: 520px) {
  .page {
    max-width: 760px;
  }

  .login-layout {
    width: min(100%, 640px);
    max-width: 640px;
    margin: 0 auto var(--ui-card-gap);
  }

  .login-hero {
    margin-bottom: 14px;
    padding: 24px 26px 22px;
    border-radius: 24px;
  }

  .login-card {
    padding: 22px 24px;
  }

  .login-notice {
    gap: 9px;
    margin-bottom: 12px;
    padding: 12px 14px;
    border-radius: 11px;
  }

  .login-card .primary-btn {
    min-height: var(--ui-control-height, 44px) !important;
    height: auto !important;
    padding: var(--ui-control-padding-y, 10px) var(--ui-control-padding-x, 16px) !important;
    font-size: var(--ui-type-body) !important;
    line-height: 20px !important;
  }

  .login-card .section-title {
    margin-bottom: 10px;
  }

  .card-desc {
    margin: 0 0 16px;
    font-size: var(--ui-type-meta);
    line-height: 1.65;
  }

  .sheet-title {
    font-size: var(--ui-type-dialog);
    line-height: 1.4;
  }

  .sheet-note,
  .field-picker,
  .sheet-link {
    font-size: var(--ui-type-meta);
  }

  .field-picker {
    min-height: 48px;
    padding: 12px 14px;
    border-radius: 12px;
  }

  .sheet-panel {
    left: 50%;
    right: auto;
    width: calc(100vw - 48px);
    width: min(520px, calc(100vw - 48px));
    bottom: 24px;
    transform: translate(-50%, 112%);
  }

  .sheet-show .sheet-panel {
    transform: translate(-50%, 0);
  }
}

@media (min-width: 900px) {
  .page {
    display: block;
    max-width: 820px;
  }

  .login-layout {
    display: block;
    width: 100%;
    max-width: 680px;
  }

  .login-hero {
    min-height: 0;
    margin-bottom: 14px;
    padding: 24px 28px 22px;
  }

  .login-main {
    display: block;
  }

  .login-card {
    padding: 22px 24px;
  }

}
