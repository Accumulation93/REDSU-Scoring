/* Shared Blue Luxury Glass polish for venue subpackage */
.subapp-venue-page {
  min-height: 100%;
  background:
    radial-gradient(circle at 12% 10%, rgba(96, 165, 250, 0.16) 0%, transparent 26%),
    radial-gradient(circle at 86% 18%, rgba(191, 219, 254, 0.22) 0%, transparent 24%),
    radial-gradient(circle at 18% 88%, rgba(125, 211, 252, 0.10) 0%, transparent 22%),
    linear-gradient(135deg, #f8fbff 0%, #f1f6fc 48%, #edf3fa 100%);
}

.page {
  position: relative;
  min-height: 100vh;
  padding: var(--ui-page-padding-top) var(--ui-page-padding-x) calc(var(--ui-page-padding-bottom) + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.card,
.edit-box,
.list-card,
.filter-section {
  position: relative;
  margin-bottom: var(--ui-card-gap, 24rpx);
  padding: var(--ui-card-padding-y, 28rpx) var(--ui-card-padding-x, 26rpx);
  border-radius: 30rpx;
  background: linear-gradient(135deg, rgba(255,255,255,0.80) 0%, rgba(248,251,255,0.72) 100%);
  border: 1rpx solid rgba(255,255,255,0.62);
  box-shadow: 0 18rpx 36rpx rgba(15,23,42,0.06), inset 0 1rpx 0 rgba(255,255,255,0.78);
  backdrop-filter: blur(24rpx);
  -webkit-backdrop-filter: blur(24rpx);
  box-sizing: border-box;
}

/* Section is a conditional/layout host. Its child card owns the visual surface and spacing. */
.section-host {
  position: relative;
  margin: 0;
  padding: 0;
  border: 0;
  background: transparent;
  box-shadow: none;
  backdrop-filter: none;
  -webkit-backdrop-filter: none;
}

.section-title,
.list-title,
.filter-label {
  position: relative;
  padding-left: var(--ui-section-title-inset, 20rpx);
  margin-bottom: var(--ui-field-gap, 16rpx);
  color: #0f172a;
  font-size: var(--ui-type-section);
  font-weight: 700;
  line-height: 1.4;
}

.section-title::before,
.list-title::before,
.filter-label::before {
  content: "";
  position: absolute;
  left: 0;
  top: 50%;
  width: 8rpx;
  height: 28rpx;
  border-radius: 999rpx;
  transform: translateY(-50%);
  background: linear-gradient(180deg, #2563eb 0%, #60a5fa 100%);
  box-shadow: 0 0 14rpx rgba(59,130,246,0.24);
}

.venue-card,
.booking-item,
.list-item,
.nav-row {
  border-radius: 22rpx;
  background: linear-gradient(135deg, rgba(255,255,255,0.92), rgba(249,251,255,0.82));
  border: 1rpx solid rgba(226,237,247,0.96);
  box-shadow: 0 12rpx 24rpx rgba(15,23,42,0.04), inset 0 1rpx 0 rgba(255,255,255,0.78);
}

.venue-name,
.booking-title,
.booking-item-title,
.list-name,
.detail-title {
  color: #0f172a;
  line-height: 1.42;
  word-break: break-word;
}

.venue-loc,
.booking-meta,
.booking-item-meta,
.list-desc,
.detail-val,
.field-hint {
  color: #64748b;
  font-size: var(--ui-type-label);
  line-height: 1.42;
  white-space: pre-wrap;
  word-break: break-word;
}

.field {
  margin-bottom: var(--ui-field-gap, 16rpx);
}

.field-label {
  margin-bottom: var(--ui-label-gap, 6rpx);
  color: #64748b;
  font-size: var(--ui-type-label);
  font-weight: 600;
  line-height: 1.5;
}

.field-input,
.field-textarea,
.picker-display,
.time-val {
  width: 100%;
  min-height: var(--ui-control-height, 82rpx);
  padding: var(--ui-control-padding-y, 16rpx) var(--ui-control-padding-x, 28rpx);
  border-radius: 22rpx;
  color: #0f172a;
  font-size: var(--ui-type-emphasis);
  line-height: 1.5;
  background: linear-gradient(135deg, rgba(255,255,255,0.96), rgba(246,249,255,0.88));
  border: 1rpx solid rgba(219,229,241,0.96);
  box-shadow: 0 10rpx 22rpx rgba(15,23,42,0.04), inset 0 1rpx 0 rgba(255,255,255,0.84);
  box-sizing: border-box;
}

.field-input,
.field-textarea {
  display: block;
}

/* Compact picker chips — not full-width inputs */
.time-pick, .picker-sm {
  width: auto;
  min-height: auto;
  padding: var(--ui-compact-padding-y, 6rpx) var(--ui-compact-padding-x, 14rpx);
  border-radius: 16rpx;
  font-size: var(--ui-type-meta);
  line-height: 1.35;
  background: linear-gradient(135deg, rgba(255,255,255,0.92), rgba(247,250,255,0.82));
  border: 1rpx solid rgba(226,232,240,0.68);
  box-shadow: inset 0 1rpx 0 rgba(255,255,255,0.78), 0 6rpx 14rpx rgba(15,23,42,0.03);
  box-sizing: border-box;
}

.field-textarea {
  min-height: 156rpx;
  white-space: pre-wrap;
}

.header-nav,
.rules-tabs {
  display: flex;
  gap: var(--ui-tab-gap, 8rpx);
  margin-bottom: var(--ui-card-gap, 24rpx);
}

.header-nav-btn,
.filter-chip,
.chip,
.venue-tag,
.status-tag,
.booking-status {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 34rpx;
  padding: var(--ui-compact-padding-y, 6rpx) var(--ui-compact-padding-x, 14rpx);
  border-radius: var(--ui-compact-radius, 18rpx);
  font-size: var(--ui-type-meta);
  font-weight: 700;
  line-height: 1.25;
  border: 1rpx solid rgba(147,197,253,0.64);
  background: rgba(219,234,254,0.76);
  color: #2563eb;
}

/* Rules tabs — distinct style: light bg, slate text, no blue border */
.rules-tab {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: var(--ui-tab-min-height, 66rpx);
  padding: var(--ui-tab-padding-y, 14rpx) var(--ui-tab-padding-x, 18rpx);
  border-radius: var(--ui-tab-radius, 20rpx);
  font-size: var(--ui-tab-font-size, 24rpx);
  font-weight: 600;
  line-height: 1.35;
  border: 1rpx solid rgba(203,213,225,0.48);
  background: rgba(248,250,252,0.88);
  color: #64748b;
  transition: color 0.2s ease, background 0.2s ease, border-color 0.2s ease, box-shadow 0.24s ease, transform 0.2s ease;
}

.filter-chip.active,
.chip.active {
  color: #ffffff;
  background: linear-gradient(135deg, #2563eb 0%, #3b82f6 58%, #60a5fa 100%);
  box-shadow: 0 16rpx 30rpx rgba(37,99,235,0.22), inset 0 1rpx 0 rgba(255,255,255,0.24);
}

.rules-tab.active {
  color: #ffffff;
  background: linear-gradient(135deg, #2563eb 0%, #3b82f6 58%, #60a5fa 100%);
  box-shadow: 0 12rpx 24rpx rgba(37,99,235,0.20), inset 0 1rpx 0 rgba(255,255,255,0.24);
  border-color: transparent;
}

.popup-mask {
  background: rgba(15,23,42,0.34);
  backdrop-filter: blur(6rpx);
}

.popup-card {
  border-radius: 28rpx;
  background: linear-gradient(135deg, rgba(255,255,255,0.95), rgba(248,251,255,0.90));
  border: 1rpx solid rgba(255,255,255,0.82);
  box-shadow: 0 22rpx 44rpx rgba(15,23,42,0.14), inset 0 1rpx 0 rgba(255,255,255,0.78);
}

.popup-title {
  color: #0f172a;
  font-size: var(--ui-type-dialog);
  font-weight: 700;
  line-height: 1.42;
}

.primary-btn,
.secondary-btn,
.danger-btn,
.approve-btn,
.reject-btn {
  border-radius: var(--ui-control-radius, 28rpx);
  font-weight: 700;
}

.empty-state,
.audit-empty-state,
.empty-inline {
  padding: 34rpx 24rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, rgba(255,255,255,0.72), rgba(248,251,255,0.60));
  border: 1rpx dashed rgba(147,197,253,0.46);
  color: #64748b;
}

/* ── Shared utility classes (used across venue pages) ── */
.large-scroll { max-height: 820rpx; }

.card-loading-overlay {
  display: flex; align-items: center; justify-content: center;
  padding: 32rpx 0;
}
.card-loading-spinner {
  width: 40rpx; height: 40rpx;
  border: 5rpx solid rgba(37,99,235,0.16);
  border-top-color: #2563eb;
  border-radius: 50%;
  animation: venueSpin 0.7s linear infinite;
}
@keyframes venueSpin { to { transform: rotate(360deg); } }

/* Non-flat status surfaces. Press feedback is driven by each target's hover-class. */
.booking-status.pending,
.status-tag.pending {
  color: #c2410c;
  background: linear-gradient(135deg, rgba(255, 247, 237, 0.96), rgba(254, 215, 170, 0.84));
  border-color: rgba(253, 186, 116, 0.58);
}

.booking-status.approved,
.status-tag.approved {
  color: #15803d;
  background: linear-gradient(135deg, rgba(220, 252, 231, 0.96), rgba(167, 243, 208, 0.84));
  border-color: rgba(110, 231, 183, 0.58);
}

.booking-status.inUse,
.booking-status.completed,
.status-tag.inUse,
.status-tag.completed {
  color: #0369a1;
  background: linear-gradient(135deg, rgba(224, 242, 254, 0.96), rgba(186, 230, 253, 0.84));
  border-color: rgba(56, 189, 248, 0.56);
}

.booking-status.rejected,
.booking-status.cancelled,
.status-tag.rejected,
.status-tag.cancelled {
  color: #64748b;
  background: linear-gradient(135deg, rgba(248, 250, 252, 0.96), rgba(226, 232, 240, 0.84));
  border-color: rgba(203, 213, 225, 0.58);
}

.timeline-bar,
.timeline-drag-container .timeline-bar,
.audit-flow-progress-bar,
.progress-track {
  background: linear-gradient(135deg, rgba(226, 237, 247, 0.78), rgba(248, 251, 255, 0.68));
  border: 1rpx solid rgba(255, 255, 255, 0.66);
  box-shadow:
    inset 0 1rpx 5rpx rgba(15, 23, 42, 0.08),
    0 8rpx 18rpx rgba(15, 23, 42, 0.025);
}

.timeline-selection,
.audit-flow-progress-fill,
.progress-fill {
  background: linear-gradient(90deg, #2563eb 0%, #3b82f6 54%, #60a5fa 100%);
  box-shadow: 0 0 18rpx rgba(37, 99, 235, 0.24);
}

.tt-time-header,
.tt-col-header,
.tt-time-label {
  background: linear-gradient(135deg, rgba(248, 251, 255, 0.94), rgba(239, 246, 255, 0.82));
  border-color: rgba(226, 237, 247, 0.76);
}

.tt-event-block,
.tt-open-block,
.tl-dot,
.tt-dot {
  box-shadow:
    0 5rpx 12rpx rgba(15, 23, 42, 0.035),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.56);
}

.venue-card.control-pressing,
.booking-item.control-pressing,
.pending-item.control-pressing,
.list-item.control-pressing,
.nav-row.control-pressing {
  transform: translate3d(0, 2rpx, 0) scale(0.992) !important;
  opacity: 0.975 !important;
  filter: saturate(1.018) brightness(1.004) !important;
  transition:
    transform 0.18s cubic-bezier(0.2, 0.78, 0.22, 1),
    box-shadow 0.20s ease,
    opacity 0.18s ease,
    filter 0.20s ease !important;
}

@media (min-width: 520px) {
  .large-scroll {
    max-height: 65vh;
  }

  .venue-card,
  .booking-item,
  .pending-item,
  .list-item,
  .nav-row {
    padding: 18px;
    border-radius: 18px;
  }

  .venue-card-title,
  .booking-title,
  .pending-item-name,
  .list-item-title,
  .nav-row-label {
    font-size: var(--ui-type-emphasis) !important;
    line-height: 1.5 !important;
  }

  .venue-card-meta,
  .booking-meta,
  .pending-item-meta,
  .list-item-meta,
  .nav-row-desc,
  .time-pick,
  .picker-sm {
    font-size: var(--ui-type-meta) !important;
    line-height: 1.55 !important;
  }
}

@media (min-width: 900px) and (orientation: landscape) {
  .venue-card,
  .booking-item,
  .pending-item,
  .list-item,
  .nav-row {
    padding: 12px 14px;
    border-radius: 14px;
  }
}
.rule-edit-box--spaced {
  margin-top: var(--ui-dialog-section-gap, 12rpx);
}

.danger-clear-link {
  color: #ef4444;
  font-size: var(--ui-type-meta);
}

.audit-flow-summary--spaced {
  margin-top: 8rpx;
}

.audit-flow--spaced {
  margin-top: 6rpx;
}

.flow-step-status-tag--inline {
  margin-left: 8rpx;
}

.flow-info-comment {
  color: #94a3b8;
  font-style: italic;
}

.rule-filter-row--dialog {
  padding: 0 0 var(--ui-dialog-section-gap);
}

.rule-filter-field--grow {
  flex: 1 1 0;
  min-width: 0;
}

.compact-row--dialog {
  padding: 0 0 var(--ui-inline-gap, 10rpx);
}

.approval-action-area .field {
  margin-bottom: 0;
}

.approval-action-area .field + .field {
  margin-top: var(--ui-field-gap, 16rpx);
}

.field--approval-comment {
  margin-top: 0;
}

.field-placeholder {
  color: #94a3b8;
  font-size: var(--ui-type-body);
  line-height: var(--ui-leading-control);
}

@media (min-width: 520px) {
  .audit-flow-summary--spaced {
    margin-top: 6px;
  }

  .audit-flow--spaced {
    margin-top: 4px;
  }

  .flow-step-status-tag--inline {
    margin-left: 6px;
  }

  .compact-row--dialog {
    padding-bottom: var(--ui-inline-gap, 7px);
  }
}

.pick-row {
  display: flex;
  align-items: center;
}
