<view class="page page-narrow subapp-venue-page">
  <workspace-hero class="workspace-hero-host" app-name="{{localeCopy.copy_aa4f0ed6cd}}" page-name="{{localeCopy.copy_9ba3b8c8a9}} · {{localeCopy.copy_5aaf844f1e}}"></workspace-hero>

  <view class="section-host">
    <view class="card">
      <view class="section-title">{{localeCopy.copy_109f042664}}</view>
      <view class="pending-header">
        <text class="pending-update-time">{{pendingHeaderText}}</text>
        <view class="pending-header-actions">
          <text class="pending-history-entry ui-motion-chip" bindtap="goApprovalHistory" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">{{localeCopy.copy_8650ae5bf6}}</text>
          <text class="pending-refresh-btn ui-motion-chip" bindtap="loadData" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">⟳ {{localeCopy.copy_545113905f}}</text>
        </view>
      </view>
      <scroll-view enhanced="{{true}}" show-scrollbar="{{true}}" bounces="{{true}}" class="inner-scroll large-scroll" scroll-y>
        <view class="card-loading-overlay" wx:if="{{loading}}"><view class="card-loading-spinner"></view></view>
        <block wx:else>
        <view class="pending-item ui-motion-card" wx:for="{{pending}}" wx:key="id" data-id="{{item.id}}" bindtap="viewDetail" hover-class="ui-press-card" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">
          <view class="pending-item-main">
            <view class="pending-item-name">{{item.title || localeCopy.copy_9639901862}}</view>
            <view class="pending-item-meta">
              <view class="audit-chip audit-chip-progress">{{localeCopy.copy_36be0dfa1c}}</view>
              <view class="pending-item-step">{{localeCopy.copy_ef8b7ffa9b}}{{item.currentStepIndex + 1}}{{localeCopy.copy_9e545997b0}} · {{item.currentStepName}}</view>
              <view class="pending-item-step" wx:if="{{item.approvalCurrentStep > 0}}">{{item.approvalCurrentStep}}/{{item.approvalTotalSteps}} {{localeCopy.copy_dc59906817}}</view>
            </view>
            <view class="pending-item-info">{{item.venueName}} · {{item.userName}} · {{item.timeStartText}} {{localeCopy.copy_e8d9493a44}} {{item.timeEndText}}</view>
            <view class="assignment-chip" wx:if="{{item._creatorAssignmentText}}">{{localeCopy.applicantAssignment}} · {{item._creatorAssignmentText}}</view>
            <view class="context-switch-notice" wx:if="{{item._requiresContextSwitch}}">
              <view class="context-switch-title">{{localeCopy.contextSwitchRequired}}</view>
              <view class="context-switch-detail" wx:if="{{item._requiredContextText}}">{{item._requiredContextText}}</view>
            </view>
          </view>
          <view class="pending-actions-col" wx:if="{{!item._requiresContextSwitch}}">
            <text class="pending-action-link approve ui-motion-chip" data-id="{{item.id}}" catchtap="openApprove" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">{{localeCopy.copy_1bb7eb3e1a}}</text>
            <text class="pending-action-link reject ui-motion-chip" data-id="{{item.id}}" catchtap="openReject" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">{{localeCopy.copy_0c90eb0204}}</text>
          </view>
          <view class="pending-actions-col" wx:else>
            <text class="pending-action-link switch-context ui-motion-chip" catchtap="goWorkContextSwitch" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">{{localeCopy.switchWorkContext}}</text>
          </view>
        </view>
        <view class="audit-empty-state" wx:if="{{!pending.length && !loading}}">
          <view class="audit-empty-icon"><ui-icon name="check" tone="primary" size="54" ariaLabel="{{localeCopy.copy_a14c4e583b}}" /></view>
          <view class="audit-empty-text">{{localeCopy.copy_a14c4e583b}}</view>
        </view>
        </block>
      </scroll-view>
    </view>
  </view>

  <!-- ═══ Approval / Detail Popup ═══ -->
  <viewport-portal wx:if="{{approvalVisible}}">
  <view class="popup-mask ui-overlay" wx:if="{{approvalVisible}}" bindtap="closeApproval">
    <view class="ui-overlay-blocker" catchtouchmove="noop"></view>
    <view class="popup-card ui-dialog-shell ui-dialog-shell--complex" catchtap="noop">
      <view class="popup-header ui-dialog-header">
        <view class="popup-title">{{approvalTarget.title || localeCopy.copy_48283f4043}}</view>
        <text class="popup-close ui-motion-chip" catchtap="closeApproval" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">{{localeCopy.copy_09614cef6c}}</text>
      </view>
      <scroll-view enhanced="{{true}}" show-scrollbar="{{true}}" bounces="{{true}}" nested-scroll-enabled="{{true}}" class="popup-scroll ui-dialog-body ui-dialog-content ui-dialog-scroll--fill" scroll-y>
        <view class="detail-body ui-dialog-stack">
          <!-- Flow progress bar -->
          <view wx:if="{{approvalTarget.approvalTotalSteps > 0}}" class="audit-flow-summary">
            <view class="audit-flow-progress-bar">
              <view class="audit-flow-progress-fill" style="width:{{approvalTarget._approvalPercent}}%;"></view>
            </view>
            <text class="audit-flow-progress-text">{{approvalTarget.approvalCurrentStep}}/{{approvalTarget.approvalTotalSteps}}</text>
          </view>

          <!-- Full flow timeline -->
          <view wx:if="{{approvalTarget._flowTimeline && approvalTarget._flowTimeline.length}}" class="audit-flow">
            <view class="{{node.nodeClass}} {{expandedNodeKey === node._key ? 'flow-node-expanded' : ''}} ui-motion-chip" wx:for="{{approvalTarget._flowTimeline}}" wx:key="_key" wx:for-item="node" catchtap="toggleFlowNode" data-node-key="{{node._key}}" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">
              <view class="flow-left-col">
                <view class="{{node.dotClass}}">{{node.icon}}</view>
                <view class="flow-connector" wx:if="{{!node.isLast}}"></view>
              </view>
              <view class="flow-right-col">
                <view class="flow-info {{expandedNodeKey === node._key ? 'flow-info-expanded' : ''}}">
                  <view class="flow-info-title">{{node.stepName}}<text class="flow-step-status-tag flow-step-status-tag--inline flow-tag-{{node.state}}">{{node.label}}</text></view>
                  <view class="flow-info-desc" wx:if="{{node.meta}}">{{node.meta}}</view>
                  <view wx:if="{{node.state === 'done' || node.state === 'rejected'}}" class="flow-expand-hint">{{expandedNodeKey === node._key ? localeCopy.copy_4edcf754ff : localeCopy.copy_baec508307}}</view>
                  <view wx:if="{{expandedNodeKey === node._key && (node.state === 'done' || node.state === 'rejected')}}" class="flow-expand-detail">
                    <view wx:if="{{node.approverName}}" class="flow-detail-processed-text"><text class="flow-detail-label">{{localeCopy.copy_866290fa02}}</text>{{node.approverName}}</view>
                    <view wx:if="{{node.approverAssignmentText}}" class="flow-detail-processed-meta"><text class="flow-detail-label">{{localeCopy.approverAssignment}}</text>{{node.approverAssignmentText}}</view>
                    <view wx:if="{{node.approvedAtText}}" class="flow-detail-processed-meta">{{localeCopy.copy_dcadcebf08}}{{node.approvedAtText}}</view>
                    <view wx:if="{{node.comment}}" class="flow-detail-comment"><text class="flow-detail-label">{{localeCopy.copy_3b3b392755}}</text>{{node.comment}}</view>
                  </view>
                </view>
              </view>
            </view>
          </view>

          <view class="detail-row"><text class="detail-key">{{localeCopy.copy_bbbebc1abf}}</text><text class="detail-val">{{approvalTarget.venueName}}<text wx:if="{{approvalTarget.venueLocation}}"> · {{approvalTarget.venueLocation}}</text></text></view>
          <view class="detail-row" wx:if="{{approvalTarget.orgName}}"><text class="detail-key">{{localeCopy.copy_34e2d1f8a0}}</text><text class="detail-val">{{approvalTarget.orgName}}</text></view>
          <view class="detail-row"><text class="detail-key">{{localeCopy.copy_ce30bda5a2}}</text><text class="detail-val">{{approvalTarget.userName}}</text></view>
          <view class="detail-row" wx:if="{{approvalTarget._creatorAssignmentText}}"><text class="detail-key">{{localeCopy.applicantAssignment}}</text><text class="detail-val"><text class="assignment-chip">{{approvalTarget._creatorAssignmentText}}</text></text></view>
          <view class="context-switch-notice context-switch-notice--detail" wx:if="{{approvalTarget._requiresContextSwitch}}">
            <view class="context-switch-title">{{localeCopy.contextSwitchRequired}}</view>
            <view class="context-switch-detail" wx:if="{{approvalTarget._requiredContextText}}">{{approvalTarget._requiredContextText}}</view>
            <text class="context-switch-action ui-motion-chip" catchtap="goWorkContextSwitch" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160">{{localeCopy.switchWorkContext}}</text>
          </view>
          <view class="detail-row"><text class="detail-key">{{localeCopy.copy_4202a27ca6}}</text><text class="detail-val">{{approvalTarget.timeStartText}} — {{approvalTarget.timeEndText}}</text></view>
          <view class="detail-row" wx:if="{{approvalTarget.description}}"><text class="detail-key">{{localeCopy.copy_c5d9511809}}</text><text class="detail-val">{{approvalTarget.description}}</text></view>
          <view class="detail-row"><text class="detail-key">{{localeCopy.copy_8aee737e64}}</text><text class="status-tag pending">{{localeCopy.copy_310d71700e}}</text></view>
          <view class="detail-row" wx:if="{{approvalTarget.approvalCurrentStep >= 0}}"><text class="detail-key">{{localeCopy.copy_9e26c149ee}}</text><text class="detail-val">{{localeCopy.copy_ef8b7ffa9b}}{{approvalTarget.currentStepIndex + 1}}{{localeCopy.copy_9e545997b0}} · {{approvalTarget.currentStepName}}</text></view>

          <!-- Approval action area -->
          <view wx:if="{{approvalAction}}" class="approval-action-area">
            <view class="field" wx:if="{{approvalAction === 'approve' && canDesignateNext}}">
              <view class="field-label">{{localeCopy.copy_3fc6899daa}}</view>
              <view class="pick-row" catchtap="openNextApproverPicker">
                <text class="picker-display {{nextApproverAssignmentIds.length ? 'picker-has-value' : ''}}">{{nextApproverName || localeCopy.copy_6986f4a5fd}}</text>
              </view>
            </view>
            <view class="field field--approval-comment">
              <view class="field-label">{{localeCopy.copy_bddb855314}}</view>
              <textarea class="field-textarea" auto-height maxlength="-1" value="{{approvalComment}}" bindinput="onApprovalCommentInput" placeholder="{{approvalAction === 'approve' ? localeCopy.copy_bef4bbef62 : localeCopy.copy_a93266a8d4}}"/>
            </view>
          </view>
        </view>
      </scroll-view>
      <view class="button-row ui-dialog-footer" wx:if="{{approvalAction}}">
        <button class="secondary-btn ui-motion-button" catchtap="closeApproval" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">{{localeCopy.copy_06dbb49961}}</button>
        <button class="{{approvalAction === 'approve' ? 'primary-btn' : 'danger-btn'}} ui-motion-button" loading="{{approvalSubmitting}}" catchtap="submitApproval" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">
          {{approvalAction === 'approve' ? localeCopy.copy_49ef170f0b : localeCopy.copy_cd42af3f87}}
        </button>
      </view>
    </view>
  </view>
  </viewport-portal>
  <personnel-picker visible="{{nextApproverPickerVisible}}" title="{{localeCopy.copy_1f13a570b9}}" options="{{nextApproverCandidates}}" value="{{nextApproverSelections}}" selectionLevel="assignment" multiple="{{true}}" bindconfirm="confirmNextApprovers" bindcancel="closeNextApproverPicker" bindretry="openNextApproverPicker" />

  <view class="page-footer">
    <view class="footer-name">{{localeCopy.copy_aa4f0ed6cd}}</view>
    <view class="footer-org">{{localeCopy.copy_638da8ae60}}</view>
  </view>
</view>
