@import '../../../main/styles/home.wxss';
@import '../../styles/blue-polish.wxss';

/* ── Pending approval list items ── */
.pending-item {
  display: flex; align-items: center; gap: 12rpx;
  padding: 14rpx 16rpx; margin-bottom: 8rpx; border-radius: 16rpx;
  background: linear-gradient(135deg, rgba(255,255,255,0.90) 0%, rgba(248,251,255,0.80) 100%);
  border: 1rpx solid rgba(226,237,247,0.94);
  box-shadow: 0 10rpx 24rpx rgba(15,23,42,0.035), inset 0 1rpx 0 rgba(255,255,255,0.78);
  box-sizing: border-box; transition: transform 0.18s ease, box-shadow 0.22s ease;
  animation: glassFadeUp 0.36s ease both;
}
.pending-item:last-child { margin-bottom: 4rpx; }
.pending-item:active { transform: translateY(1rpx) scale(0.992); }

.pending-item-main { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 4rpx; }
.pending-item-name { color: #0f172a; font-size: var(--ui-type-value); font-weight: 700; line-height: 1.3; }

.pending-item-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 6rpx; }
.pending-item-step {
  font-size: var(--ui-type-caption); font-weight: 600; color: #475569;
  padding: 4rpx 10rpx; border-radius: 10rpx;
  background: rgba(241,245,249,0.7); border: 1rpx solid rgba(148,163,184,0.2);
}
.pending-item-info {
  color: #94a3b8;
  font-size: var(--ui-type-meta);
  line-height: 1.4;
  overflow-wrap: anywhere;
}
.assignment-chip {
  display: inline-flex;
  align-self: flex-start;
  max-width: 100%;
  padding: 5rpx 12rpx;
  border: 1rpx solid rgba(147, 197, 253, 0.58);
  border-radius: var(--ui-compact-radius, 18rpx);
  background: linear-gradient(135deg, rgba(239, 246, 255, 0.96), rgba(219, 234, 254, 0.82));
  color: #2563eb;
  font-size: var(--ui-type-caption);
  font-weight: 700;
  line-height: 1.45;
  white-space: normal;
  overflow-wrap: anywhere;
  box-sizing: border-box;
}
.context-switch-notice {
  margin-top: 4rpx;
  padding: 10rpx 12rpx;
  border: 1rpx solid rgba(251, 191, 36, 0.46);
  border-radius: 14rpx;
  background: linear-gradient(135deg, rgba(255, 251, 235, 0.96), rgba(254, 243, 199, 0.78));
}
.context-switch-notice--detail { margin: 10rpx 0; }
.context-switch-title { color: #92400e; font-size: var(--ui-type-caption); font-weight: 700; line-height: 1.45; }
.context-switch-detail { margin-top: 4rpx; color: #a16207; font-size: var(--ui-type-micro); line-height: 1.5; overflow-wrap: anywhere; }
.context-switch-action { display: inline-flex; margin-top: 8rpx; color: #2563eb; font-size: var(--ui-type-caption); font-weight: 700; }

/* Action links column */
.pending-actions-col {
  display: flex; flex-direction: column; gap: 10rpx; flex-shrink: 0;
}
.pending-action-link {
  display: flex; align-items: center; justify-content: center;
  min-width: 80rpx; min-height: 48rpx; height: auto;
  padding: var(--ui-compact-padding-y, 6rpx) var(--ui-compact-padding-x, 14rpx);
  border-radius: var(--ui-compact-radius, 18rpx);
  font-size: var(--ui-type-meta); font-weight: 700; line-height: var(--ui-leading-control, 1.35);
  box-sizing: border-box;
  transition: transform 0.12s ease, opacity 0.12s ease;
}
.pending-action-link:active { transform: scale(0.94); opacity: 0.85; }
.pending-action-link.approve {
  color: #ffffff;
  background: linear-gradient(135deg, #2563eb 0%, #60a5fa 100%);
  box-shadow: 0 8rpx 18rpx rgba(37,99,235,0.16);
}
.pending-action-link.reject {
  color: #dc2626;
  background: linear-gradient(135deg, rgba(255,255,255,0.92) 0%, rgba(254,226,226,0.56) 100%);
  border: 1rpx solid rgba(252,165,165,0.45);
  box-shadow: 0 6rpx 14rpx rgba(239,68,68,0.06);
}

/* ── Update header ── */
.pending-header {
  display: flex; align-items: center; justify-content: space-between;
  padding: 0 0 14rpx 0;
}
.pending-action-link.switch-context {
  max-width: 132rpx;
  color: #2563eb;
  background: linear-gradient(135deg, rgba(239,246,255,0.98), rgba(219,234,254,0.86));
  border: 1rpx solid rgba(147,197,253,0.58);
  text-align: center;
}
.pending-header-actions { display: flex; align-items: center; gap: 10rpx; flex-shrink: 0; }
.pending-update-time { font-size: var(--ui-type-caption); color: #94a3b8; }
.pending-history-entry {
  display: inline-flex; align-items: center; justify-content: center;
  min-height: 42rpx; padding: 6rpx 16rpx;
  border-radius: var(--ui-compact-radius, 18rpx);
  color: #2563eb; font-size: var(--ui-type-caption); font-weight: 700;
  line-height: var(--ui-leading-control);
  background: linear-gradient(135deg, rgba(255,255,255,0.92), rgba(219,234,254,0.72));
  border: 1rpx solid rgba(147,197,253,0.58);
  box-shadow: 0 6rpx 14rpx rgba(37,99,235,0.06), inset 0 1rpx 0 rgba(255,255,255,0.72);
}
.pending-refresh-btn {
  display: inline-flex; align-items: center; gap: 6rpx;
  font-size: var(--ui-type-caption); font-weight: 600; color: #2563eb;
  padding: 6rpx 18rpx; border-radius: var(--ui-compact-radius, 18rpx);
  background: rgba(219,234,254,0.65); border: 1rpx solid rgba(147,197,253,0.4);
  line-height: 1;
}
.pending-refresh-btn:active { transform: scale(0.95); opacity: 0.85; }

/* ── Approval action area ── */
.approval-action-area {
  margin-top: var(--ui-inline-gap, 10rpx);
  padding-top: var(--ui-inline-gap, 10rpx);
  border-top: 1rpx solid rgba(226,232,240,0.5);
}

/* ── Empty state ── */
.audit-empty-state {
  display: flex; flex-direction: column; align-items: center;
  padding: 40rpx 20rpx;
}
.audit-empty-icon { font-size: var(--ui-type-page); margin-bottom: 16rpx; }
.audit-empty-text { font-size: var(--ui-type-emphasis); font-weight: 700; color: #475569; margin-bottom: 6rpx; }
.audit-empty-tip {
  font-size: var(--ui-type-meta); color: #94a3b8; margin-top: 8rpx;
  text-align: center; line-height: 1.6;
}

@media (min-width: 900px) and (orientation: landscape) {
  .pending-item {
    gap: 10px;
    padding: 10px 12px;
    margin-bottom: 6px;
    border-radius: 14px;
  }

  .pending-item-main { gap: 3px; }
  .pending-item-meta { gap: 5px; }
  .pending-item-info { line-height: 1.35; }
}

/* ── Status tag ── */
.status-tag {
  display: inline-flex; align-items: center; justify-content: center;
  padding: 4rpx 14rpx; border-radius: var(--ui-compact-radius, 18rpx); font-size: var(--ui-type-caption); font-weight: 700;
}
.status-tag.pending { background: rgba(255,237,213,0.78); color: #c2410c; border: 1rpx solid rgba(253,186,116,0.58); }

/* ── Flow info (audit-style timeline) ── */
.flow-info-title { font-size: var(--ui-type-meta); font-weight: 700; color: #0f172a; line-height: 1.4; }
.flow-info-desc {
  margin-top: 4rpx;
  color: #64748b;
  font-size: var(--ui-type-caption);
  line-height: 1.6;
  overflow-wrap: anywhere;
}

/* ── Detail popup ── */
.detail-title {
  margin-bottom: 16rpx;
  color: #0f172a;
  font-size: var(--ui-type-dialog);
  font-weight: 700;
  line-height: 1.45;
  overflow-wrap: anywhere;
}
.detail-row {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  padding: 10rpx 0;
  border-bottom: 1rpx solid rgba(226,232,240,0.4);
  line-height: 1.62;
}
.detail-row:last-child { border-bottom: none; }
.detail-key {
  flex-shrink: 0;
  width: 100rpx;
  color: #64748b;
  font-size: var(--ui-type-control);
  line-height: 1.62;
}
.detail-val {
  flex: 1;
  min-width: 0;
  color: #0f172a;
  font-size: var(--ui-type-control);
  font-weight: 600;
  line-height: 1.62;
  white-space: pre-wrap;
  overflow-wrap: anywhere;
}

/* ── Button row ── */
.button-row { display: flex; gap: var(--ui-inline-gap, 10rpx); }
.button-row button {
  flex: 1;
  min-height: var(--ui-control-height, 82rpx);
  height: auto;
  padding: var(--ui-control-padding-y, 16rpx) var(--ui-control-padding-x, 28rpx);
  line-height: var(--ui-leading-control, 1.35);
  border-radius: var(--ui-control-radius, 28rpx);
  font-size: var(--ui-type-control);
  font-weight: 700;
  border: none;
  box-shadow: 0 16rpx 32rpx rgba(37,99,235,0.18);
}
.button-row button::after { border: none; }

/* Final pending approval polish */
.pending-item-step,
.pending-refresh-btn {
  color: #2563eb;
  background: linear-gradient(135deg, rgba(219,234,254,0.92), rgba(191,219,254,0.76));
  border: 1rpx solid rgba(147,197,253,0.58);
  box-shadow:
    0 6rpx 14rpx rgba(37,99,235,0.06),
    inset 0 1rpx 0 rgba(255,255,255,0.62);
}

.pending-action-link {
  box-shadow:
    0 10rpx 20rpx rgba(15,23,42,0.06),
    inset 0 1rpx 0 rgba(255,255,255,0.18);
}

.pending-action-link.approve {
  background: linear-gradient(135deg, #2563eb 0%, #3b82f6 58%, #60a5fa 100%);
  box-shadow:
    0 14rpx 28rpx rgba(37,99,235,0.20),
    0 0 18rpx rgba(96,165,250,0.10),
    inset 0 1rpx 0 rgba(255,255,255,0.20);
}

.pending-action-link.reject {
  background: linear-gradient(135deg, rgba(255,255,255,0.94), rgba(254,226,226,0.66));
  box-shadow:
    0 10rpx 20rpx rgba(239,68,68,0.07),
    inset 0 1rpx 0 rgba(255,255,255,0.70);
}

.button-row button {
  box-shadow:
    0 16rpx 32rpx rgba(37,99,235,0.18),
    inset 0 1rpx 0 rgba(255,255,255,0.20);
  transition: transform 0.14s ease, box-shadow 0.2s ease, opacity 0.14s ease;
}

.button-row button:active,
.pending-refresh-btn:active {
  transform: translateY(1rpx) scale(0.985);
  opacity: 0.92;
}

/* Final local motion: row cards animate only through hover-class. */
.card:active,
.section:active,
.pending-item:active {
  transform: none !important;
  filter: none !important;
}

.pending-item.control-pressing {
  transform: translate3d(0, 2rpx, 0) scale(0.992) !important;
  opacity: 0.975 !important;
  transition:
    transform 0.18s cubic-bezier(0.2, 0.78, 0.22, 1),
    box-shadow 0.20s ease,
    opacity 0.18s ease !important;
}

.pending-action-link:active,
.pending-refresh-btn:active {
  transform: translate3d(0, 1rpx, 0) scale(0.984) !important;
  opacity: 0.94 !important;
  transition:
    transform 0.16s cubic-bezier(0.2, 0.78, 0.22, 1),
    opacity 0.16s ease,
    box-shadow 0.18s ease !important;
}

@media (min-width: 520px) {
  .assignment-chip { padding: 4px 9px; border-radius: 12px; }
  .context-switch-notice { padding: 7px 9px; border-radius: 10px; }
  .context-switch-action { margin-top: 6px; }
}

@media (min-width: 900px) and (orientation: landscape) {
  .pending-action-link.switch-context { max-width: 104px; }
}
