                <text class="time-kb-display-colon">:</text>
                <view class="time-kb-display-box {{_kbTarget === 'startMin' && _kbVisible ? 'time-kb-display-active' : ''}} ui-motion-chip" data-target="startMin" catchtap="onKbOpen" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">{{fmt.min(bookingTimeStart)}}</view>
                <text wx:if="{{bookingTimeStart}}" class="time-valid-badge">✓</text>
              </view>
            </view>
            <view wx:else class="field-hint">{{bookingStartDate ? localeCopy.copy_824768a506 : localeCopy.copy_6ce770a0a6}}</view>
          </view>

          <!-- ★ Quick duration chips ★ -->
          <view wx:if="{{bookingTimeStart && timelineBlocks.length}}" class="field">
            <view class="field-label">{{localeCopy.copy_552d783261}}</view>
            <view class="duration-row">
              <text class="duration-chip {{bookingTimeEnd && item.minutes === _activeDuration ? 'duration-chip-active' : ''}} ui-motion-chip" wx:for="{{durationChips}}" wx:key="label" data-minutes="{{item.minutes}}" catchtap="onDurationTap" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">{{item.label}}</text>
            </view>
          </view>

          <!-- ★ End time ★ -->
          <view class="field">
            <view class="field-label">{{localeCopy.copy_2bd6adcbb9}} <text class="required">*</text></view>
            <view wx:if="{{timelineBlocks.length && bookingTimeStart}}" class="time-section-new">
              <view class="time-kb-display-row ui-field-control">
                <view class="time-kb-display-box {{_kbTarget === 'endHour' && _kbVisible ? 'time-kb-display-active' : ''}} ui-motion-chip" data-target="endHour" catchtap="onKbOpen" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">{{fmt.hour(bookingTimeEnd)}}</view>
                <text class="time-kb-display-colon">:</text>
                <view class="time-kb-display-box {{_kbTarget === 'endMin' && _kbVisible ? 'time-kb-display-active' : ''}} ui-motion-chip" data-target="endMin" catchtap="onKbOpen" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">{{fmt.min(bookingTimeEnd)}}</view>
                <text wx:if="{{bookingTimeEnd}}" class="time-valid-badge end-badge">✓</text>
              </view>
            </view>
            <view wx:else class="field-hint">{{bookingTimeStart ? '' : localeCopy.copy_560bd817fb}}</view>
          </view>

          <!-- Description -->
          <view class="field">
            <view class="field-label">{{localeCopy.copy_5b5ccadb74}}</view>
            <textarea class="field-textarea" auto-height maxlength="-1" value="{{bookingDesc}}" data-field="bookingDesc" bindinput="onFieldInput" placeholder="{{localeCopy.copy_2edf3fde90}}"/>
          </view>
          <view class="field" wx:if="{{allowUserSelectFlow}}">
            <view class="field-label">{{localeCopy.copy_3bc010171a}} <text class="required">*</text></view>
            <picker class="ui-field-control-host" range="{{approvalFlowOptions}}" range-key="name" bindchange="onBookingFlowSelect">
              <view class="picker-display ui-field-control {{selectedFlowId ? 'picker-has-value' : ''}}">{{selectedFlowId ? selectedFlowName : localeCopy.copy_29ea17e75c}}</view>
            </picker>
          </view>
          <view class="field" wx:if="{{selectedFlowId && selectedFlowAllowDesignateFirst}}">
            <view class="field-label">{{localeCopy.copy_66a92fc57e}}</view>
            <view class="pick-row ui-field-control-host" catchtap="openFirstApproverPicker">
              <view class="picker-display ui-field-control {{firstApproverAssignmentIds.length ? 'picker-has-value' : ''}}">{{firstApproverName || localeCopy.copy_6986f4a5fd}}</view>
            </view>
          </view>
        </view>
      </scroll-view>
      <view class="button-row booking-form-actions ui-dialog-footer">
        <button class="primary-btn ui-motion-button" loading="{{loading}}" catchtap="submitBooking" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">{{localeCopy.copy_02ef2f799d}}</button>
      </view>
    </view>
    </view>
  </viewport-portal>
  <personnel-picker visible="{{firstApproverPickerVisible}}" title="{{localeCopy.copy_0522689efc}}" options="{{approverCandidates}}" value="{{firstApproverSelections}}" selectionLevel="assignment" multiple="{{true}}" bindconfirm="confirmFirstApprovers" bindcancel="closeFirstApproverPicker" bindretry="openFirstApproverPicker" />

  <!-- ═══════════════════ APPROVAL / DETAIL POPUP ═══════════════════ -->
  <viewport-portal wx:if="{{approvalVisible}}">
  <view class="popup-mask ui-overlay" wx:if="{{approvalVisible}}" bindtap="closeApproval">
    <view class="ui-overlay-blocker" catchtouchmove="noop"></view>
    <view class="popup-card ui-dialog-shell ui-dialog-shell--complex" catchtap="noop">
      <view class="popup-header ui-dialog-header">
        <view class="popup-title">{{approvalTarget.title || localeCopy.copy_48283f4043}}</view>
        <text class="popup-close ui-motion-chip" catchtap="closeApproval" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">{{localeCopy.copy_09614cef6c}}</text>
      </view>
      <scroll-view enhanced="{{true}}" show-scrollbar="{{true}}" bounces="{{true}}" nested-scroll-enabled="{{true}}" class="popup-scroll ui-dialog-body ui-dialog-content ui-dialog-scroll--fill" scroll-y>
        <view class="detail-body ui-dialog-stack">
          <!-- Flow progress bar -->
          <view wx:if="{{approvalTarget.approvalTotalSteps > 0}}" class="audit-flow-summary">
            <view class="audit-flow-progress-bar">
              <view class="audit-flow-progress-fill" style="width:{{approvalTarget._approvalPercent}}%;"></view>
            </view>
            <text class="audit-flow-progress-text">{{approvalTarget.approvalCurrentStep}}/{{approvalTarget.approvalTotalSteps}}</text>
          </view>

          <!-- Full flow timeline -->
          <view wx:if="{{approvalTarget._flowTimeline && approvalTarget._flowTimeline.length}}" class="audit-flow">
            <view class="{{node.nodeClass}} {{expandedNodeKey === node._key ? 'flow-node-expanded' : ''}} ui-motion-chip" wx:for="{{approvalTarget._flowTimeline}}" wx:key="_key" wx:for-item="node" catchtap="toggleFlowNode" data-node-key="{{node._key}}" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">
              <view class="flow-left-col">
                <view class="{{node.dotClass}}">{{node.icon}}</view>
                <view class="flow-connector" wx:if="{{!node.isLast}}"></view>
              </view>
              <view class="flow-right-col">
                <view class="flow-info {{expandedNodeKey === node._key ? 'flow-info-expanded' : ''}}">
                  <view class="flow-info-title">{{node.stepName}}<text class="flow-step-status-tag flow-step-status-tag--inline flow-tag-{{node.state}}">{{node.label}}</text></view>
                  <view class="flow-info-desc" wx:if="{{node.meta}}">{{node.meta}}</view>
                  <view wx:if="{{node.state === 'done' || node.state === 'rejected'}}" class="flow-expand-hint">{{expandedNodeKey === node._key ? localeCopy.copy_4edcf754ff : localeCopy.copy_baec508307}}</view>
                  <view wx:if="{{expandedNodeKey === node._key && (node.state === 'done' || node.state === 'rejected')}}" class="flow-expand-detail">
                    <view wx:if="{{node.approverName}}" class="flow-detail-processed-text"><text class="flow-detail-label">{{localeCopy.copy_866290fa02}}</text>{{node.approverName}}</view>
                    <view wx:if="{{node.approverAssignmentText}}" class="flow-detail-processed-meta"><text class="flow-detail-label">{{localeCopy.approverAssignment}}</text>{{node.approverAssignmentText}}</view>
                    <view wx:if="{{node.approvedAtText}}" class="flow-detail-processed-meta">{{localeCopy.copy_dcadcebf08}}{{node.approvedAtText}}</view>
                    <view wx:if="{{node.comment}}" class="flow-detail-comment"><text class="flow-detail-label">{{localeCopy.copy_3b3b392755}}</text>{{node.comment}}</view>
                  </view>
                </view>
              </view>
            </view>
          </view>

          <view class="detail-row"><text class="detail-key">{{localeCopy.copy_bbbebc1abf}}</text><text class="detail-val">{{approvalTarget.venueName}}<text wx:if="{{approvalTarget.venueLocation}}"> · {{approvalTarget.venueLocation}}</text></text></view>
          <view class="detail-row" wx:if="{{approvalTarget.orgName}}"><text class="detail-key">{{localeCopy.copy_34e2d1f8a0}}</text><text class="detail-val">{{approvalTarget.orgName}}</text></view>
          <view class="detail-row"><text class="detail-key">{{localeCopy.copy_ce30bda5a2}}</text><text class="detail-val">{{approvalTarget.userName}}</text></view>
          <view class="detail-row" wx:if="{{approvalTarget._creatorAssignmentText}}"><text class="detail-key">{{localeCopy.applicantAssignment}}</text><text class="detail-val"><text class="assignment-chip">{{approvalTarget._creatorAssignmentText}}</text></text></view>
          <view class="context-switch-notice context-switch-notice--detail" wx:if="{{approvalTarget._requiresContextSwitch}}">
            <view class="context-switch-title">{{localeCopy.contextSwitchRequired}}</view>
            <view class="context-switch-detail" wx:if="{{approvalTarget._requiredContextText}}">{{approvalTarget._requiredContextText}}</view>
            <text class="context-switch-action ui-motion-chip" catchtap="goWorkContextSwitch" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160">{{localeCopy.switchWorkContext}}</text>
          </view>
          <view class="detail-row"><text class="detail-key">{{localeCopy.copy_4202a27ca6}}</text><text class="detail-val">{{approvalTarget.timeStartText}} — {{approvalTarget.timeEndText}}</text></view>
          <view class="detail-row" wx:if="{{approvalTarget.description}}"><text class="detail-key">{{localeCopy.copy_c5d9511809}}</text><text class="detail-val">{{approvalTarget.description}}</text></view>
          <view class="detail-row"><text class="detail-key">{{localeCopy.copy_8aee737e64}}</text><text class="status-tag pending">{{localeCopy.copy_310d71700e}}</text></view>
          <view class="detail-row" wx:if="{{approvalTarget.approvalCurrentStep >= 0}}"><text class="detail-key">{{localeCopy.copy_9e26c149ee}}</text><text class="detail-val">{{localeCopy.copy_ef8b7ffa9b}}{{approvalTarget.currentStepIndex + 1}}{{localeCopy.copy_9e545997b0}} · {{approvalTarget.currentStepName}}</text></view>

          <!-- Approval action area -->
          <view wx:if="{{approvalAction}}" class="approval-action-area">
            <view class="field" wx:if="{{approvalAction === 'approve' && canDesignateNext}}">
              <view class="field-label">{{localeCopy.copy_3fc6899daa}}</view>
              <view class="pick-row ui-field-control-host" catchtap="openNextApproverPicker">
                <view class="picker-display ui-field-control {{nextApproverAssignmentIds.length ? 'picker-has-value' : ''}}">{{nextApproverName || localeCopy.copy_6986f4a5fd}}</view>
              </view>
            </view>
            <view class="field field--approval-comment">
              <view class="field-label">{{localeCopy.copy_bddb855314}}</view>
              <textarea class="field-textarea" auto-height maxlength="-1" value="{{approvalComment}}" bindinput="onApprovalCommentInput" placeholder="{{approvalAction === 'approve' ? localeCopy.copy_bef4bbef62 : localeCopy.copy_a93266a8d4}}"/>
            </view>
          </view>
        </view>
      </scroll-view>
      <view class="button-row ui-dialog-footer" wx:if="{{approvalAction}}">
        <button class="secondary-btn ui-motion-button" catchtap="closeApproval" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">{{localeCopy.copy_06dbb49961}}</button>
        <button class="{{approvalAction === 'approve' ? 'primary-btn' : 'danger-btn'}} ui-motion-button" loading="{{approvalSubmitting}}" catchtap="submitApproval" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">
          {{approvalAction === 'approve' ? localeCopy.copy_49ef170f0b : localeCopy.copy_cd42af3f87}}
        </button>
      </view>
    </view>
  </view>
  </viewport-portal>
  <personnel-picker visible="{{nextApproverPickerVisible}}" title="{{localeCopy.copy_1f13a570b9}}" options="{{nextApproverCandidates}}" value="{{nextApproverSelections}}" selectionLevel="assignment" multiple="{{true}}" bindconfirm="confirmNextApprovers" bindcancel="closeNextApproverPicker" bindretry="openNextApproverPicker" />

  <view class="page-footer">
    <view class="footer-name">{{localeCopy.copy_aa4f0ed6cd}}</view>
    <view class="footer-org">{{localeCopy.copy_638da8ae60}}</view>
  </view>

  <!-- ★ Custom time keyboard ★ (independent viewport portal above the booking dialog) -->
  <viewport-portal wx:if="{{_kbVisible}}">
  <view class="time-keyboard ui-portal-surface" catchtap="noop">
    <view class="time-kb-display">
      <view class="time-kb-box {{_kbField === 'hour' ? 'time-kb-box-active' : ''}} {{_kbField === 'hour' && _kbSelected ? 'time-kb-box-selected' : ''}} ui-motion-chip" data-field="hour" catchtap="onKbSwitchField" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">{{_kbHourVal || '--'}}</view>
      <text class="time-kb-colon">:</text>
      <view class="time-kb-box {{_kbField === 'min' ? 'time-kb-box-active' : ''}} {{_kbField === 'min' && _kbSelected ? 'time-kb-box-selected' : ''}} ui-motion-chip" data-field="min" catchtap="onKbSwitchField" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">{{_kbMinVal || '--'}}</view>
      <view class="time-kb-confirm ui-motion-chip" catchtap="onKbConfirm" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">{{localeCopy.copy_bd24ac5b0c}}</view>
    </view>
    <view class="time-kb-numpad">
      <view class="time-kb-row">
        <view class="time-kb-key {{_kbGray[1] ? 'time-kb-key-gray' : ''}} ui-motion-chip" data-key="1" catchtap="onKbKey" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">1</view>
        <view class="time-kb-key {{_kbGray[2] ? 'time-kb-key-gray' : ''}} ui-motion-chip" data-key="2" catchtap="onKbKey" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">2</view>
        <view class="time-kb-key {{_kbGray[3] ? 'time-kb-key-gray' : ''}} ui-motion-chip" data-key="3" catchtap="onKbKey" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">3</view>
      </view>
      <view class="time-kb-row">
        <view class="time-kb-key {{_kbGray[4] ? 'time-kb-key-gray' : ''}} ui-motion-chip" data-key="4" catchtap="onKbKey" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">4</view>
        <view class="time-kb-key {{_kbGray[5] ? 'time-kb-key-gray' : ''}} ui-motion-chip" data-key="5" catchtap="onKbKey" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">5</view>
        <view class="time-kb-key {{_kbGray[6] ? 'time-kb-key-gray' : ''}} ui-motion-chip" data-key="6" catchtap="onKbKey" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">6</view>
      </view>
      <view class="time-kb-row">
        <view class="time-kb-key {{_kbGray[7] ? 'time-kb-key-gray' : ''}} ui-motion-chip" data-key="7" catchtap="onKbKey" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">7</view>
        <view class="time-kb-key {{_kbGray[8] ? 'time-kb-key-gray' : ''}} ui-motion-chip" data-key="8" catchtap="onKbKey" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">8</view>
        <view class="time-kb-key {{_kbGray[9] ? 'time-kb-key-gray' : ''}} ui-motion-chip" data-key="9" catchtap="onKbKey" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">9</view>
      </view>
      <view class="time-kb-row">
        <view class="time-kb-key time-kb-key-colon {{_kbGray[':'] ? 'time-kb-key-gray' : ''}} ui-motion-chip" data-key=":" catchtap="onKbKey" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">:</view>
        <view class="time-kb-key {{_kbGray[0] ? 'time-kb-key-gray' : ''}} ui-motion-chip" data-key="0" catchtap="onKbKey" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">0</view>
        <view class="time-kb-key time-kb-key-bs ui-motion-chip" catchtap="onKbBackspace" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">⌫</view>
      </view>
    </view>
  </view>
  </viewport-portal>
</view>
