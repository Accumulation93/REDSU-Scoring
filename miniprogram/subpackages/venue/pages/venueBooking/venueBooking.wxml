<wxs module="fmt">
function hour(t) {
  if (!t) return '--';
  var p = (''+t).split(':');
  return p[0] || '--';
}
function min(t) {
  if (!t) return '--';
  var p = (''+t).split(':');
  return p[1] || '--';
}
module.exports = { hour: hour, min: min };
</wxs>
