@import '../../../main/styles/home.wxss';
@import '../../styles/blue-polish.wxss';

/* ═══ Venue cards — 参考 mySubmissions 审核列表卡片样式 ═══ */
.venue-card {
  display:flex; align-items:center; gap:18rpx;
  padding:24rpx 22rpx; margin-bottom:12rpx; border-radius:22rpx;
  background:linear-gradient(135deg, rgba(255,255,255,0.90) 0%, rgba(248,251,255,0.80) 100%);
  border:1rpx solid rgba(226,237,247,0.94);
  box-shadow:0 10rpx 24rpx rgba(15,23,42,0.035), inset 0 1rpx 0 rgba(255,255,255,0.78);
  box-sizing:border-box; transition:transform 0.18s ease, box-shadow 0.22s ease;
  animation:glassFadeUp 0.36s ease both;
}
.venue-card:active { transform:translateY(1rpx) scale(0.992); }

.venue-main { flex:1; min-width:0; display:flex; flex-direction:column; gap:8rpx; }
.venue-name { color:#0f172a; font-size: var(--ui-type-value); font-weight:700; line-height:1.4; }
.venue-loc { color:#64748b; font-size: var(--ui-type-label); }

.venue-meta {
  display:flex;
  flex-wrap:nowrap;
  align-items:center;
  gap:10rpx;
  max-width:100%;
  overflow-x:auto;
  overflow-y:hidden;
  -webkit-overflow-scrolling:touch;
}
.venue-tag {
  display:inline-flex; align-items:center; justify-content:center;
  flex-shrink:0;
  min-height:38rpx; padding:6rpx 14rpx; border-radius: var(--ui-compact-radius, 18rpx);
  font-size: var(--ui-type-caption); font-weight:700; line-height:1.35;
  white-space:nowrap;
  border:1rpx solid transparent;
}
.venue-tag.direct {
  color:#15803d; background:rgba(209,250,229,0.78);
  border-color:rgba(110,231,183,0.58);
}
.venue-tag.approval {
  color:#c2410c; background:rgba(255,237,213,0.78);
  border-color:rgba(253,186,116,0.58);
}
.venue-actions { display:flex; flex-direction:row; gap:12rpx; flex-shrink:0; align-items:center; }
.action-btn-disabled { opacity: 0.52; filter: saturate(0.56); }
.work-context-notice {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-bottom: 14rpx;
  padding: 12rpx 14rpx;
  border: 1rpx solid rgba(251, 191, 36, 0.46);
  border-radius: 18rpx;
  background: linear-gradient(135deg, rgba(255, 251, 235, 0.96), rgba(254, 243, 199, 0.78));
}
.work-context-notice-text { flex: 1; min-width: 0; color: #92400e; font-size: var(--ui-type-caption); line-height: 1.55; }
.work-context-notice-action { flex-shrink: 0; color: #2563eb; font-size: var(--ui-type-caption); font-weight: 700; }

/* Final local motion: venue containers do not move when inner buttons are tapped. */
.venue-card:active,
.card:active,
.section:active {
  transform: none !important;
  filter: none !important;
}

/* Action buttons — 参考管理端部门卡片 .link 药丸按钮样式 */
.action-btn {
  display:inline-flex; align-items:center; justify-content:center;
  padding:6rpx 16rpx; border-radius: var(--ui-compact-radius, 18rpx); font-size: var(--ui-type-control); font-weight:600;
  line-height:1; white-space:nowrap;
  background:rgba(219,234,254,0.65); color:#2563eb;
  border:1rpx solid rgba(147,197,253,0.45);
  transition:transform 0.12s ease, opacity 0.12s ease;
}
.action-btn:active { transform:scale(0.94); opacity:0.85; }
.action-btn.primary {
  background:linear-gradient(135deg, #2563eb 0%, #3b82f6 45%, #60a5fa 100%);
  color:#fff; border-color:transparent;
  box-shadow:0 8rpx 18rpx rgba(37,99,235,0.22);
}

/* ═══ Booking items ═══ */
.booking-item {
  padding:24rpx 22rpx; margin-bottom:14rpx; border-radius:22rpx;
  background:linear-gradient(135deg, rgba(255,255,255,0.90) 0%, rgba(248,251,255,0.80) 100%);
  border:1rpx solid rgba(226,237,247,0.92);
  box-shadow:0 10rpx 22rpx rgba(15,23,42,0.035), inset 0 1rpx 0 rgba(255,255,255,0.74);
  animation:glassFadeUp 0.36s ease both;
}
.booking-item-head { display:flex; justify-content:space-between; align-items:center; gap:12rpx; margin-bottom:10rpx; }
.booking-item-title { flex:1; min-width:0; font-size: var(--ui-type-value); font-weight:700; color:#0f172a; overflow-wrap:anywhere; }
.booking-item-meta { font-size: var(--ui-type-control); color:#64748b; line-height:1.7; }
.booking-item-foot { margin-top:12rpx; display:flex; justify-content:flex-end; }

/* Status tag — 状态色统一由 ../styles/blue-polish.wxss 的玻璃渐变体系接管 */
.status-tag {
  font-size: var(--ui-type-meta); padding:6rpx 16rpx; border-radius: var(--ui-compact-radius, 18rpx); font-weight:600;
}

/* ═══ Empty state ═══ */
.empty-state { text-align:center; padding:40rpx 20rpx; }
.empty-text { color:#94a3b8; font-size: var(--ui-type-emphasis); line-height:1.7; }

/* ═══ Popup detail ═══ */
.detail-title {
  margin-bottom: 16rpx;
  color: #0f172a;
  font-size: var(--ui-type-section);
  font-weight: 700;
  line-height: 1.45;
  overflow-wrap: anywhere;
}
.detail-row {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  padding: 9rpx 0;
  color: #334155;
  font-size: var(--ui-type-emphasis);
  line-height: 1.62;
}
.detail-key {
  width: 120rpx;
  flex-shrink: 0;
  color: #94a3b8;
  line-height: 1.62;
}
.detail-val {
  flex: 1;
  min-width: 0;
  color: #1e293b;
  line-height: 1.62;
  white-space: pre-wrap;
  overflow-wrap: anywhere;
}

/* ═══ Form ═══ */

/* ═══ Chips ═══ */
.chip-row { display:flex; flex-wrap:wrap; gap:10rpx; margin-top:10rpx; }
.chip {
  font-size: var(--ui-type-control); padding:6rpx 16rpx; border-radius: var(--ui-compact-radius, 18rpx); font-weight:500;
  background:linear-gradient(135deg, rgba(248,250,252,0.96) 0%, rgba(241,245,249,0.84) 100%);
  color:#475569;
  border:1rpx solid rgba(203,213,225,0.58);
  box-shadow:inset 0 1rpx 0 rgba(255,255,255,0.72);
}
.chip.active {
  background:linear-gradient(135deg, #2563eb 0%, #3b82f6 58%, #60a5fa 100%);
  color:#fff; border-color:transparent;
  box-shadow:0 8rpx 18rpx rgba(37,99,235,0.22), inset 0 1rpx 0 rgba(255,255,255,0.24);
}

/* ═══ Date picker display ═══ */
.picker-display {
  width:100%; padding:24rpx 20rpx; border-radius:18rpx;
  background:rgba(255,255,255,0.72); border:1rpx solid rgba(203,213,225,0.75);
  font-size: var(--ui-type-value); color:#1e293b; box-sizing:border-box;
}
/* 已选择日期 → 蓝色强调 */
.picker-has-value {
  color:#2563eb; font-weight:700;
  border-color:rgba(37,99,235,0.32);
  background:rgba(239,246,255,0.72);
}

/* ═══ ★ Draggable timeline + chip selectors ★ ═══ */

/* ── Timeline hint ── */
.timeline-hint {
  font-size: var(--ui-type-caption); color:#64748b; padding:0 0 10rpx 4rpx;
}

/* ── Drag container ── */
.timeline-drag-container {
  position:relative; height:120rpx;
}

/* Timeline bar (behind handles) */
.timeline-drag-container .timeline-bar {
  position:absolute; left:0; right:0; top:38rpx; height:44rpx;
  border-radius:22rpx; background:#f1f5f9; overflow:hidden;
}

/* Selected range overlay */
.timeline-selection {
  position:absolute; top:0; height:100%;
  background:rgba(37,99,235,0.35);
  border-radius:0; pointer-events:none; z-index:1;
}

/* ── Drag handles ── */
.tl-handle-wrap {
  position:absolute;
  display:flex; flex-direction:column; align-items:center;
  width:52rpx; margin-left:-26rpx;
}

/* Start handle — above the bar, ▼ arrow points down to bar top */
.tl-handle-start {
  top:-18rpx; z-index:4;
}

/* End handle — below the bar, ▲ arrow points up to bar bottom */
.tl-handle-end {
  top:80rpx; z-index:3;
}

/* Arrow indicators */
.tl-arrow {
  font-size: var(--ui-type-value); line-height:1; flex-shrink:0;
}
.tl-arrow-down {
  color:#2563eb;
}
.tl-arrow-up {
  color:#059669;
}

/* Handle time label */
.tl-tag {
  font-size: var(--ui-type-caption); font-weight:700; white-space:nowrap;
  padding:4rpx 12rpx; border-radius: var(--ui-compact-radius, 18rpx);
  pointer-events:none;
}
.tl-tag-start {
  color:#2563eb; background:rgba(219,234,254,0.85);
  margin-bottom:2rpx;
}
.tl-tag-end {
  color:#059669; background:rgba(209,250,229,0.85);
  margin-top:2rpx;
}

/* ── Timeline legend ── */
.timeline-legend {
  display:flex; gap:16rpx; padding:6rpx 4rpx 0; font-size: var(--ui-type-caption);
}
.tl-leg { display:flex; align-items:center; gap:4rpx; color:#64748b; }
.tl-dot { width:16rpx; height:16rpx; border-radius:4rpx; flex-shrink:0; }
.tl-dot.free { background:linear-gradient(135deg, #86efac 0%, #4ade80 100%); }
.tl-dot.booked { background:linear-gradient(135deg, #fdba74 0%, #fb923c 100%); }
.tl-dot.activity { background:linear-gradient(135deg, #93c5fd 0%, #60a5fa 100%); }

/* ── New time section (chips + input) ── */
.time-section-new {
  display:flex; flex-direction:column; gap:8rpx;
}

/* ── Chip selector rows ── */
.chip-select-row {
  display:flex; align-items:center; gap:10rpx;
}
.chip-select-label {
  font-size: var(--ui-type-meta); font-weight:700; color:#64748b;
  width:36rpx; text-align:center; flex-shrink:0;
}
.chip-scroll {
  flex:1; white-space:nowrap;
}

/* Hour chip */
.hour-chip {
  display:inline-block; font-size: var(--ui-type-control); font-weight:700;
  padding:6rpx 14rpx; margin-right:8rpx; border-radius: var(--ui-compact-radius, 18rpx);
  color:#475569; background:rgba(241,245,249,0.85);
  border:1rpx solid rgba(203,213,225,0.55);
  transition:color 0.16s ease, background 0.16s ease, border-color 0.16s ease, box-shadow 0.2s ease, transform 0.16s ease;
}
.hour-chip:active { transform:scale(0.94); }
.hour-chip-active {
  color:#fff;
  background:linear-gradient(135deg, #2563eb 0%, #3b82f6 100%);
  border-color:transparent;
  box-shadow:0 4rpx 12rpx rgba(37,99,235,0.20);
}

/* Minute chip row */
.min-chip-row {
  display:flex; gap:8rpx; flex:1;
}
.min-chip {
  flex:1; text-align:center; font-size: var(--ui-type-control); font-weight:700;
  padding:6rpx 0; border-radius: var(--ui-compact-radius, 18rpx);
  color:#475569; background:rgba(241,245,249,0.85);
  border:1rpx solid rgba(203,213,225,0.55);
  transition:color 0.16s ease, background 0.16s ease, border-color 0.16s ease, box-shadow 0.2s ease, transform 0.16s ease;
}
.min-chip:active { transform:scale(0.94); }
.min-chip-active {
  color:#fff;
  background:linear-gradient(135deg, #2563eb 0%, #3b82f6 100%);
  border-color:transparent;
  box-shadow:0 4rpx 12rpx rgba(37,99,235,0.20);
}

/* ── Time text input ── */
.time-input-wrap {
  display:flex; align-items:center; gap:12rpx;
}
.time-field-input {
  flex:1; height:72rpx; padding:0 20rpx; border-radius:16rpx;
  font-size: var(--ui-type-value); font-weight:700; color:#1e293b; letter-spacing:2rpx;
  background:linear-gradient(135deg, rgba(255,255,255,0.96), rgba(246,249,255,0.88));
  border:1rpx solid rgba(219,229,241,0.96);
  box-shadow:0 8rpx 18rpx rgba(15,23,42,0.035), inset 0 1rpx 0 rgba(255,255,255,0.84);
  box-sizing:border-box;
}
.time-field-input:focus {
  border-color:rgba(37,99,235,0.45);
  box-shadow:0 0 0 6rpx rgba(37,99,235,0.06);
}
.time-valid-badge {
  display:flex; align-items:center; justify-content:center;
  width:40rpx; height:40rpx; border-radius:50%;
  background:#10b981; color:#fff; font-size: var(--ui-type-meta); font-weight:700;
  flex-shrink:0;
}
.end-badge {}

/* ── Duration chips ── */
.duration-row {
  display:flex; flex-wrap:wrap; gap:10rpx;
}
.duration-chip {
  font-size: var(--ui-type-control); padding:6rpx 16rpx; border-radius: var(--ui-compact-radius, 18rpx); font-weight:600;
  background:rgba(241,245,249,0.85); color:#475569;
  border:1rpx solid rgba(203,213,225,0.55);
  transition:color 0.16s ease, background 0.16s ease, border-color 0.16s ease, box-shadow 0.2s ease, transform 0.16s ease;
}
.duration-chip:active { transform:scale(0.94); }
.duration-chip-active {
  background:linear-gradient(135deg, #2563eb 0%, #3b82f6 100%);
  color:#fff; border-color:transparent;
  box-shadow:0 6rpx 16rpx rgba(37,99,235,0.20);
}

/* ── Summary row ── */
.time-summary {
  display:flex; align-items:center; gap:10rpx;
  padding:18rpx 22rpx; margin-top:8rpx; border-radius:20rpx;
  background:linear-gradient(135deg, rgba(37,99,235,0.06) 0%, rgba(59,130,246,0.04) 100%);
  border:1rpx solid rgba(37,99,235,0.14);
}
.time-summary-icon { font-size: var(--ui-type-value); }
.time-summary-text { font-size: var(--ui-type-value); font-weight:800; color:#2563eb; }
.time-summary-dur { font-size: var(--ui-type-control); color:#64748b; margin-left:auto; }

/* ── 无可用时段提示 ── */
.field-hint { font-size: var(--ui-type-control); color:#94a3b8; padding:18rpx 20rpx; }

/* ═══ Schedule / Timetable ═══ */
.schedule-nav { display:flex; align-items:center; justify-content:center; gap:28rpx; padding:8rpx 16rpx 16rpx; }
.nav-arrow {
  font-size: var(--ui-type-page); padding:6rpx 22rpx; border-radius:16rpx; font-weight:300; color:#2563eb;
  background:rgba(255,255,255,0.85); border:1rpx solid rgba(59,130,246,0.20);
}
.nav-label { font-size: var(--ui-type-emphasis); font-weight:700; color:#1e293b; }

.timetable-popup { max-height:95vh; width:96vw; }
.timetable-scroll { width:100%; height:68vh; min-height:520rpx; max-height:760rpx; }
.timetable-body { display:flex; }

.tt-time-col { width:64rpx; min-width:64rpx; flex-shrink:0; }
.tt-time-header {
  height:58rpx; display:flex; align-items:center; justify-content:center;
  font-size: var(--ui-type-caption); font-weight:700; color:#475569; background:#f1f5f9;
  border-bottom:1rpx solid rgba(226,232,240,0.6); box-sizing:border-box;
}
.tt-time-label {
  height:64rpx; display:flex; align-items:center; justify-content:center;
  font-size: var(--ui-type-micro); color:#64748b; border-bottom:1rpx solid rgba(226,232,240,0.3);
  background:#f8fafc; box-sizing:border-box;
}

.tt-col-scroll { flex:1; overflow-x:visible; }
.tt-cols-row { display:flex; min-width:700rpx; }
.tt-col { flex:0 0 100rpx; min-width:100rpx; position:relative; }
.tt-col-header {
  height:58rpx; display:flex; flex-direction:column; align-items:center; justify-content:center;
  font-size: var(--ui-type-meta); font-weight:600; color:#475569; background:#f1f5f9;
  border-right:1rpx solid rgba(226,232,240,0.4); border-bottom:1rpx solid rgba(226,232,240,0.6);
  position:sticky; top:0; z-index:1; padding:2rpx 0; box-sizing:border-box;
}
.tt-col-sub { font-size: var(--ui-type-micro); font-weight:400; color:#64748b; display:block; }

.tt-open-block {
  position:absolute; left:2rpx; right:2rpx; background:rgba(219,234,254,0.38);
  border-radius:6rpx; border:1rpx dashed rgba(147,197,253,0.40);
}
.tt-time-target { position:absolute; left:0; right:0; z-index:1; opacity:0; }

.tt-event-block {
  position:absolute; left:3rpx; right:3rpx; display:flex; align-items:center; justify-content:center;
  border-radius:7rpx; overflow:hidden; z-index:2;
}
.tt-event-block.booked { background:rgba(254,215,170,0.80); border:1rpx solid rgba(253,186,116,0.55); }
.tt-event-block.pending { background:rgba(224,242,254,0.80); border:1rpx solid rgba(56,189,248,0.50); }
.tt-event-block.activity { background:rgba(219,234,254,0.75); border:1rpx solid rgba(147,197,253,0.55); }
.tt-event-label {
  font-size: var(--ui-type-micro); color:#475569; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;
  max-width:90rpx; text-align:center; line-height:1.1;
}

/* Legend */
.tt-legend { display:flex; gap:16rpx; padding:12rpx 18rpx; font-size: var(--ui-type-caption); color:#64748b; flex-wrap:wrap; }
.tt-leg-item { display:flex; align-items:center; gap:6rpx; }
.tt-dot { width:22rpx; height:22rpx; border-radius:6rpx; flex-shrink:0; }
.tt-dot.open { background:rgba(209,250,229,0.94); border:1rpx solid rgba(110,231,183,0.62); }
.tt-dot.booked { background:rgba(254,215,170,0.94); border:1rpx solid rgba(253,186,116,0.66); }
.tt-dot.pending { background:rgba(224,242,254,0.94); border:1rpx solid rgba(56,189,248,0.60); }
.tt-dot.activity { background:rgba(219,234,254,0.94); border:1rpx solid rgba(147,197,253,0.66); }
.tt-dot.closed { background:#e2e8f0; border:1rpx solid #cbd5e1; }

/* ═══ Timeline ═══ */
.timeline-wrap { margin:6rpx 0 12rpx; }
.timeline-bar { position:relative; height:48rpx; background:linear-gradient(135deg, rgba(226,237,247,0.78) 0%, rgba(248,251,255,0.68) 100%); border:1rpx solid rgba(255,255,255,0.66); border-radius:12rpx; overflow:hidden; box-shadow:inset 0 1rpx 4rpx rgba(15,23,42,0.08); }
.timeline-block { position:absolute; top:0; height:100%; min-width:3rpx; }
.timeline-block.tl-free { background:linear-gradient(180deg, #86efac 0%, #4ade80 100%); }
.timeline-block.tl-booked { background:linear-gradient(180deg, #fdba74 0%, #fb923c 100%); }
.timeline-block.tl-pending { background:linear-gradient(180deg, #7dd3fc 0%, #38bdf8 100%); }
.timeline-block.tl-activity { background:linear-gradient(180deg, #93c5fd 0%, #60a5fa 100%); }
.timeline-block.tl-closed { background:linear-gradient(180deg, #e2e8f0 0%, #cbd5e1 100%); }
.timeline-ticks { display:flex; justify-content:space-between; font-size: var(--ui-type-caption); color:#94a3b8; margin-top:4rpx; }

/* ═══ Misc ═══ */
.required { color:#ef4444; }

/* ═══ Inner scroll ═══ */
.inner-scroll { max-height:700rpx; }

/* ═══ Pending approvals entry (prominent bar) ═══ */
.pending-entry-bar {
  display: flex; align-items: center; justify-content: space-between;
  padding: 18rpx 22rpx; margin-bottom: 16rpx; border-radius: 22rpx;
  background: linear-gradient(135deg, rgba(239,246,255,0.90) 0%, rgba(219,234,254,0.78) 100%);
  border: 1rpx solid rgba(147,197,253,0.52);
  box-shadow: 0 8rpx 20rpx rgba(37,99,235,0.07), inset 0 1rpx 0 rgba(255,255,255,0.78);
  transition: transform 0.14s ease, box-shadow 0.18s ease;
}
.pending-entry-bar:active { transform: translateY(1rpx) scale(0.988); box-shadow: 0 4rpx 12rpx rgba(37,99,235,0.04); }
.pending-entry-left { display: flex; align-items: center; gap: 10rpx; }
.pending-entry-icon { font-size: var(--ui-type-value); }
.pending-entry-label { font-size: var(--ui-type-emphasis); font-weight: 700; color: #1e3a5f; }
.pending-entry-badge {
  display: inline-flex; align-items: center; justify-content: center;
  min-width: 36rpx; height: 36rpx; padding: 0 8rpx; border-radius: 999rpx;
  background: linear-gradient(135deg, #ef4444 0%, #f87171 100%);
  color: #fff; font-size: var(--ui-type-caption); font-weight: 700;
  box-shadow: 0 4rpx 10rpx rgba(239,68,68,0.18);
}
.pending-entry-arrow { font-size: var(--ui-type-dialog); font-weight: 600; color: #2563eb; }

/* ═══ Flow info (audit-style timeline in booking cards) ═══ */
.flow-info-title { font-size: var(--ui-type-meta); font-weight: 700; color: #0f172a; line-height: 1.4; }
.flow-info-desc {
  margin-top: 4rpx;
  color: #64748b;
  font-size: var(--ui-type-caption);
  line-height: 1.6;
  overflow-wrap: anywhere;
}

/* WHUSU Smart Workspace style polish for user venue borrowing */
page {
  min-height: 100%;
  background:
    radial-gradient(circle at 12% 10%, rgba(96, 165, 250, 0.16) 0%, transparent 26%),
    radial-gradient(circle at 86% 18%, rgba(191, 219, 254, 0.22) 0%, transparent 24%),
    radial-gradient(circle at 18% 88%, rgba(125, 211, 252, 0.10) 0%, transparent 22%),
    linear-gradient(135deg, #f8fbff 0%, #f1f6fc 48%, #edf3fa 100%);
}

.page {
  position: relative;
  min-height: 100vh;
  padding: var(--ui-page-padding-top) var(--ui-page-padding-x) calc(var(--ui-page-padding-bottom) + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.page::before {
  content: "";
  position: fixed;
  top: -120rpx;
  right: -90rpx;
  width: 320rpx;
  height: 320rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(96, 165, 250, 0.18) 0%, rgba(96, 165, 250, 0) 72%);
  pointer-events: none;
}

.page::after {
  content: "";
  position: fixed;
  left: -120rpx;
  bottom: 150rpx;
  width: 280rpx;
  height: 280rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(147, 197, 253, 0.16) 0%, rgba(147, 197, 253, 0) 72%);
  pointer-events: none;
}

.hero {
  margin-bottom: 22rpx;
  padding: 40rpx 34rpx 36rpx;
  border-radius: 38rpx;
  background:
    linear-gradient(135deg, rgba(37, 99, 235, 0.98) 0%, rgba(59, 130, 246, 0.95) 42%, rgba(96, 165, 250, 0.90) 100%),
    linear-gradient(180deg, rgba(255, 255, 255, 0.10), rgba(255, 255, 255, 0));
  border: 1rpx solid rgba(255, 255, 255, 0.24);
  box-shadow:
    0 24rpx 54rpx rgba(37, 99, 235, 0.20),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.24);
}

.hero-title {
  font-size: var(--ui-type-page);
  font-weight: 800;
  line-height: 1.22;
  letter-spacing: 0;
}

.hero-subtitle {
  margin-top: 10rpx;
  font-size: var(--ui-type-body);
  line-height: 1.62;
}

.card {
  margin-bottom: var(--ui-card-gap, 24rpx);
  padding: var(--ui-card-padding-y, 28rpx) var(--ui-card-padding-x, 26rpx);
  border-radius: var(--ui-card-radius, 30rpx);
  background: linear-gradient(135deg, rgba(255,255,255,0.82) 0%, rgba(248,251,255,0.72) 100%);
  border: 1rpx solid rgba(255,255,255,0.66);
  box-shadow:
    0 18rpx 36rpx rgba(15,23,42,0.06),
    inset 0 1rpx 0 rgba(255,255,255,0.78);
  backdrop-filter: blur(24rpx);
  -webkit-backdrop-filter: blur(24rpx);
  animation: glassFadeUp 0.42s ease both;
}

.section-title {
  margin: 0 0 var(--ui-field-gap, 16rpx);
  padding-left: var(--ui-section-title-inset, 20rpx);
  color: #0f172a;
  font-size: var(--ui-type-section);
  font-weight: 800;
  line-height: 1.4;
}

.section-title::before {
  width: 7rpx;
  height: 28rpx;
  background: linear-gradient(180deg, #2563eb 0%, #60a5fa 100%);
}

.venue-card,
.booking-item,
.approval-progress-bar {
  background: linear-gradient(135deg, rgba(255,255,255,0.92), rgba(249,251,255,0.82));
  border: 1rpx solid rgba(226,237,247,0.96);
  box-shadow:
    0 12rpx 24rpx rgba(15,23,42,0.04),
    inset 0 1rpx 0 rgba(255,255,255,0.78);
}

.venue-card {
  gap: 18rpx;
  padding: 24rpx 22rpx;
  border-radius: 22rpx;
}

.venue-name,
.booking-item-title {
  color: #0f172a;
  font-size: var(--ui-type-value);
  font-weight: 800;
  line-height: 1.45;
}

.venue-loc,
.booking-item-meta {
  color: #64748b;
  font-size: var(--ui-type-label);
  line-height: 1.68;
}

.venue-tag,
.status-tag {
  min-height: 38rpx;
  padding: 6rpx 16rpx;
  border-radius: var(--ui-compact-radius, 18rpx);
  font-size: var(--ui-type-caption);
  font-weight: 800;
  line-height: 1.35;
  border: 1rpx solid transparent;
}

.venue-tag.direct,
.status-tag.approved {
  color: #15803d;
  background: rgba(209,250,229,0.78);
  border-color: rgba(110,231,183,0.58);
}

.venue-tag.approval,
.status-tag.pending {
  color: #c2410c;
  background: rgba(255,237,213,0.78);
  border-color: rgba(253,186,116,0.58);
}

.venue-tag.window-open {
  color: #2563eb;
  background: rgba(219,234,254,0.76);
  border-color: rgba(147,197,253,0.58);
}

.venue-tag.window-deadline {
  color: #0369a1;
  background: rgba(224,242,254,0.76);
  border-color: rgba(56,189,248,0.56);
}

.status-tag.inUse,
.status-tag.completed {
  color: #0369a1;
  background: rgba(224,242,254,0.76);
  border-color: rgba(56,189,248,0.56);
}

.status-tag.rejected,
.status-tag.cancelled {
  color: #64748b;
  background: rgba(241,245,249,0.88);
  border-color: rgba(203,213,225,0.58);
}

.venue-actions {
  gap: 12rpx;
  flex-direction: row;
}

.action-btn,
.link {
  min-height: 36rpx;
  padding: 6rpx 16rpx;
  border-radius: var(--ui-compact-radius, 18rpx);
  color: #2563eb;
  font-size: var(--ui-type-control);
  font-weight: 600;
  line-height: 1.25;
  background: rgba(219,234,254,0.65);
  border: 1rpx solid rgba(147,197,253,0.45);
  transition: transform 0.12s ease, opacity 0.12s ease;
}

.action-btn:active { transform: scale(0.94); opacity: 0.85; }

.action-btn.primary {
  color: #ffffff;
  background: linear-gradient(135deg, #2563eb 0%, #3b82f6 45%, #60a5fa 100%);
  box-shadow: 0 8rpx 18rpx rgba(37,99,235,0.22);
  border-color: transparent;
}

.link.danger {
  color: #dc2626;
  background: rgba(254,226,226,0.78);
  border-color: rgba(252,165,165,0.58);
}

.field-label {
  margin-bottom: 10rpx;
  color: #52647c;
  font-size: var(--ui-type-label);
  font-weight: 700;
}

.field-input,
.field-textarea,
.picker-display {
  min-height: var(--ui-field-control-height, 82rpx);
  padding: 18rpx 20rpx;
  border-radius: 20rpx;
  color: #10233d;
  font-size: var(--ui-type-body);
  background: linear-gradient(135deg, rgba(255,255,255,0.96), rgba(246,249,255,0.88));
  border: 1rpx solid rgba(219,229,241,0.96);
  box-shadow:
    0 8rpx 18rpx rgba(15,23,42,0.035),
    inset 0 1rpx 0 rgba(255,255,255,0.84);
}

/* ── textarea：独立 min-height + 行高，修复文字偏上 ── */
.field-textarea {
  min-height: 156rpx;
  line-height: 1.6;
}

/* ── picker-display：flex 居中，修复文字偏位 ── */
.picker-display {
  display: flex;
  align-items: center;
}


.chip {
  border-radius: var(--ui-compact-radius, 18rpx);
  color: #2563eb;
  font-size: var(--ui-type-meta);
  font-weight: 800;
  background: rgba(219,234,254,0.76);
  border: 1rpx solid rgba(147,197,253,0.64);
}

.chip.active {
  background: linear-gradient(135deg, #2563eb 0%, #3b82f6 58%, #60a5fa 100%);
  box-shadow: 0 12rpx 22rpx rgba(37,99,235,0.16);
}

.primary-btn {
  min-height: var(--ui-control-height, 82rpx);
  height: auto;
  padding: 14rpx 20rpx;
  line-height: 1.35;
  border-radius: var(--ui-control-radius, 28rpx);
  color: #ffffff;
  font-size: var(--ui-type-control);
  font-weight: 700;
  white-space: normal;
  word-break: normal;
  overflow-wrap: anywhere;
  box-sizing: border-box;
  background: linear-gradient(135deg, #2563eb 0%, #3b82f6 58%, #60a5fa 100%);
  box-shadow:
    0 16rpx 32rpx rgba(37,99,235,0.20),
    inset 0 1rpx 0 rgba(255,255,255,0.20);
}

.primary-btn::after {
  border: none;
}

.empty-state {
  padding: 42rpx 24rpx;
  border-radius: 22rpx;
  background: linear-gradient(135deg, rgba(255,255,255,0.72), rgba(248,251,255,0.58));
  border: 1rpx dashed rgba(147,197,253,0.52);
}

.empty-text {
  color: #64748b;
  font-size: var(--ui-type-control);
}

.popup-card {
  border-radius: 30rpx;
  background: linear-gradient(135deg, rgba(255,255,255,0.94), rgba(248,251,255,0.88));
  border: 1rpx solid rgba(255,255,255,0.82);
  box-shadow: 0 24rpx 52rpx rgba(15,23,42,0.16);
}

/* 借用表单按内容自然生长，超出视口后由统一弹窗滚动契约接管。 */
.booking-form-popup {
  max-height: calc(100vh - 32rpx - env(safe-area-inset-bottom));
}
.booking-form-popup .popup-scroll {
  max-height: 56vh;
}

.booking-form-popup .field {
  margin-bottom: var(--ui-field-gap, 16rpx);
}
.booking-form-popup .field-label {
  margin-bottom: var(--ui-label-gap, 6rpx);
  font-size: var(--ui-type-caption);
}
.booking-form-popup .field-input {
  min-height: var(--ui-field-control-height, 82rpx);
  padding: 14rpx 18rpx;
  font-size: var(--ui-type-control);
  line-height: 1.45;
  display: block;
  box-sizing: border-box;
}
.booking-form-popup .picker-display {
  padding: 14rpx 18rpx;
  min-height: var(--ui-field-control-height, 82rpx);
  font-size: var(--ui-type-control);
  line-height: 1.45;
  justify-content: flex-start;
  overflow-wrap: anywhere;
}
.booking-form-popup .field-textarea {
  min-height: 96rpx;              /* 156→120→96 */
}
.booking-form-popup .chip {
  font-size: var(--ui-type-caption);
  padding: 6rpx 14rpx;
}
.booking-form-popup .chip-row {
  margin-top: 6rpx;
  gap: 6rpx;
}
.booking-form-popup .timeline-drag-container {
  height: 88rpx;                  /* 120→100→88 */
}
.booking-form-popup .timeline-hint {
  font-size: var(--ui-type-micro);
  padding: 0 0 4rpx 4rpx;
}
.booking-form-popup .time-field-input {
  height: 56rpx;                  /* 72→64→56 */
  font-size: var(--ui-type-control);
}
.booking-form-popup .duration-chip {
  font-size: var(--ui-type-caption);
  padding: 8rpx 16rpx;            /* 12/24→10/20→8/16 */
}
.booking-form-popup .time-summary {
  padding: 10rpx 14rpx;           /* 18/22→14/18→10/14 */
}
.booking-form-popup .primary-btn {
  font-size: var(--ui-type-control);
}
.booking-form-popup .form-body > .field:last-child {
  margin-bottom: 0;
}
.booking-form-actions {
  gap: 0;
}
.booking-form-actions .primary-btn {
  width: 100%;
  margin: 0;
}

.approval-section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.approval-section-head .section-title { margin-bottom: 0; }

/* ═══ Custom time keyboard ═══ */

/* ── Display row (replaces text input) ── */
.time-kb-display-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  width: 100%;
  min-height: var(--ui-field-control-height, 82rpx);
  padding: 8rpx 14rpx;
  border: 1rpx solid rgba(219,229,241,0.96);
  border-radius: var(--ui-field-radius, 20rpx);
  background: linear-gradient(135deg, rgba(255,255,255,0.98), rgba(246,249,255,0.92));
  box-shadow: 0 7rpx 16rpx rgba(15,23,42,0.032), inset 0 1rpx 0 rgba(255,255,255,0.88);
  box-sizing: border-box;
}
.time-kb-display-box {
  width: 88rpx; height: 64rpx;
  display: flex; align-items: center; justify-content: center;
  border-radius: 16rpx;
  background: rgba(255,255,255,0.82);
  border: 1rpx solid rgba(203,213,225,0.75);
  font-size: var(--ui-type-value); font-weight: 800; color: #0f172a;
  font-variant-numeric: tabular-nums;
}
.time-kb-display-colon {
  font-size: var(--ui-type-value); font-weight: 800; color: #64748b;
}
.time-kb-display-active {
  border-color: #2563eb;
  box-shadow: 0 0 0 3rpx rgba(37,99,235,0.18);
}

/* ── Keyboard panel ── (page-level fixed bottom) */
.time-keyboard {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 101;
  background: linear-gradient(180deg, rgba(255,255,255,0.995), rgba(248,251,255,0.985));
  backdrop-filter: blur(12rpx);
  border-radius: 24rpx 24rpx 0 0;
  border: 1rpx solid rgba(255,255,255,0.94);
  border-bottom: none;
  padding: 20rpx 20rpx calc(28rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -16rpx 42rpx rgba(15,23,42,0.16), inset 0 1rpx 0 rgba(255,255,255,0.96);
  box-sizing: border-box;
}

/* ── Display inside keyboard ── */
.time-kb-display {
  display: flex; align-items: center; gap: 10rpx;
  margin-bottom: 16rpx; padding: 12rpx 16rpx;
  border-radius: 18rpx;
  background: rgba(255,255,255,0.72);
  border: 1rpx solid rgba(203,213,225,0.55);
}
.time-kb-box {
  flex: 1; height: 68rpx;
  display: flex; align-items: center; justify-content: center;
  border-radius: 14rpx;
  background: rgba(241,245,249,0.72);
  font-size: var(--ui-type-dialog); font-weight: 800; color: #334155;
  transition: background 0.12s, box-shadow 0.12s;
}
.time-kb-box-active {
  background: rgba(255,255,255,0.95);
  color: #2563eb;
  box-shadow: 0 0 0 3rpx rgba(37,99,235,0.22);
}
.time-kb-box-selected {
  background: #2563eb !important;
  color: #fff !important;
  box-shadow: 0 0 0 4rpx rgba(37,99,235,0.35) !important;
}
.time-kb-colon {
  font-size: var(--ui-type-dialog); font-weight: 800; color: #64748b;
  width: 32rpx; text-align: center;
}
.time-kb-confirm {
  height: 68rpx; padding: 0 28rpx;
  display: flex; align-items: center; justify-content: center;
  border-radius: 16rpx;
  background: linear-gradient(135deg, #2563eb, #3b82f6);
  color: #fff; font-size: var(--ui-type-control); font-weight: 800;
  box-shadow: 0 8rpx 18rpx rgba(37,99,235,0.20);
  flex-shrink: 0;
}
.time-kb-confirm:active {
  transform: scale(0.96); opacity: 0.9;
}

/* ── Numpad ── */
.time-kb-numpad {
  /* container */
}
.time-kb-row {
  display: flex; gap: 14rpx; margin-bottom: 14rpx;
}
.time-kb-row:last-child { margin-bottom: 0; }
.time-kb-key {
  flex: 1; height: 88rpx;
  display: flex; align-items: center; justify-content: center;
  border-radius: 18rpx;
  background: rgba(255,255,255,0.88);
  border: 1rpx solid rgba(203,213,225,0.55);
  font-size: var(--ui-type-dialog); font-weight: 700; color: #1e293b;
  box-shadow: 0 3rpx 8rpx rgba(15,23,42,0.04);
  transition: transform 0.08s, background 0.08s;
}
.time-kb-key:active {
  transform: scale(0.94);
  background: rgba(241,245,249,0.92);
}
.time-kb-key-gray {
  background: rgba(241,245,249,0.55);
  color: #cbd5e1;
  border-color: rgba(226,232,240,0.35);
  box-shadow: none;
}
.time-kb-key-gray:active {
  transform: none;
  background: rgba(241,245,249,0.55);
}
.time-kb-key-colon {
  color: #2563eb; font-size: var(--ui-type-dialog);
}
.time-kb-key-bs {
  background: rgba(239,246,255,0.78);
  border-color: rgba(147,197,253,0.42);
  color: #2563eb; font-size: var(--ui-type-value);
}


/* ── 待我审批 tab badge ── */
.feature-tab-approvals {
  position: relative;
}

.approval-tab-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 36rpx;
  height: 36rpx;
  padding: 0 8rpx;
  margin-left: 6rpx;
  border-radius: 18rpx;
  background: linear-gradient(135deg, #ef4444 0%, #f87171 100%);
  color: #ffffff;
  font-size: var(--ui-type-caption);
  font-weight: 800;
  box-shadow: 0 4rpx 10rpx rgba(239, 68, 68, 0.30);
  vertical-align: middle;
}

/* ═══ Approvals tab ═══ */

/* ── Pending approval list items ── */
.pending-item {
  display: flex; align-items: center; gap: 18rpx;
  padding: 24rpx 22rpx; margin-bottom: 12rpx; border-radius: 22rpx;
  background: linear-gradient(135deg, rgba(255,255,255,0.90) 0%, rgba(248,251,255,0.80) 100%);
  border: 1rpx solid rgba(226,237,247,0.94);
  box-shadow: 0 10rpx 24rpx rgba(15,23,42,0.035), inset 0 1rpx 0 rgba(255,255,255,0.78);
  box-sizing: border-box; transition: transform 0.18s ease, box-shadow 0.22s ease;
  animation: glassFadeUp 0.36s ease both;
}
.pending-item:last-child { margin-bottom: 4rpx; }
.pending-item:active { transform: translateY(1rpx) scale(0.992); }

.pending-item-main { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 8rpx; }
.pending-item-name { color: #0f172a; font-size: var(--ui-type-value); font-weight: 700; line-height: 1.4; }

.pending-item-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 10rpx; }
.pending-item-step {
  font-size: var(--ui-type-caption); font-weight: 600; color: #475569;
  padding: 4rpx 12rpx; border-radius: 999rpx;
  background: rgba(241,245,249,0.7); border: 1rpx solid rgba(148,163,184,0.2);
}
.pending-item-info {
  color: #94a3b8;
  font-size: var(--ui-type-meta);
  line-height: 1.6;
  overflow-wrap: anywhere;
}

/* Action links column */
.pending-actions-col {
  display: flex; flex-direction: column; gap: 10rpx; flex-shrink: 0;
}
.pending-action-link {
  display: flex; align-items: center; justify-content: center;
  min-width: 80rpx; min-height: 48rpx; height: auto;
  padding: var(--ui-compact-padding-y, 6rpx) var(--ui-compact-padding-x, 14rpx);
  border-radius: var(--ui-compact-radius, 18rpx);
  font-size: var(--ui-type-meta); font-weight: 700; line-height: var(--ui-leading-control, 1.35);
  box-sizing: border-box;
  transition: transform 0.12s ease, opacity 0.12s ease;
}
.pending-action-link:active { transform: scale(0.94); opacity: 0.85; }
.pending-action-link.approve {
  color: #ffffff;
  background: linear-gradient(135deg, #2563eb 0%, #60a5fa 100%);
  box-shadow: 0 8rpx 18rpx rgba(37,99,235,0.16);
}
.pending-action-link.reject {
  color: #dc2626;
  background: linear-gradient(135deg, rgba(255,255,255,0.92) 0%, rgba(254,226,226,0.56) 100%);
  border: 1rpx solid rgba(252,165,165,0.45);
  box-shadow: 0 6rpx 14rpx rgba(239,68,68,0.06);
}

/* ── Update header ── */
.pending-header {
  display: flex; align-items: center; justify-content: space-between;
  padding: 0 0 14rpx 0;
}
.pending-update-time { font-size: var(--ui-type-caption); color: #94a3b8; }
.pending-refresh-btn {
  display: inline-flex; align-items: center; gap: 6rpx;
  font-size: var(--ui-type-caption); font-weight: 600; color: #2563eb;
  padding: 6rpx 18rpx; border-radius: var(--ui-compact-radius, 18rpx);
  background: rgba(219,234,254,0.65); border: 1rpx solid rgba(147,197,253,0.4);
  line-height: 1;
}
.pending-refresh-btn:active { transform: scale(0.95); opacity: 0.85; }

/* ── Approval action area ── */
.approval-action-area {
  margin-top: var(--ui-inline-gap, 10rpx);
  padding-top: var(--ui-inline-gap, 10rpx);
  border-top: 1rpx solid rgba(226,232,240,0.5);
}

/* ── Button row ── */
.button-row { display: flex; gap: var(--ui-inline-gap, 10rpx); }
.button-row button {
  flex: 1;
  min-height: var(--ui-control-height, 82rpx);
  height: auto;
  padding: var(--ui-control-padding-y, 16rpx) var(--ui-control-padding-x, 28rpx);
  line-height: var(--ui-leading-control, 1.35);
  border-radius: var(--ui-control-radius, 28rpx);
  font-size: var(--ui-type-control); font-weight: 700; border: none;
  box-shadow: 0 16rpx 32rpx rgba(37,99,235,0.18);
}
.button-row button::after { border: none; }

/* ── Danger button ── */
.danger-btn {
  background: linear-gradient(135deg, #dc2626 0%, #ef4444 100%);
  color: #ffffff;
}

/* ── Audit chip ── */
.audit-chip {
  display: inline-flex; align-items: center; justify-content: center;
  padding: 4rpx 14rpx; border-radius: var(--ui-compact-radius, 18rpx); font-size: var(--ui-type-caption); font-weight: 700;
}
.audit-chip-progress {
  background: rgba(255,237,213,0.78); color: #c2410c;
  border: 1rpx solid rgba(253,186,116,0.58);
}

/* ── Empty state ── */
.audit-empty-state {
  display: flex; flex-direction: column; align-items: center;
  padding: 40rpx 20rpx;
}
.audit-empty-icon { font-size: var(--ui-type-page); margin-bottom: 16rpx; }
.audit-empty-text { font-size: var(--ui-type-emphasis); font-weight: 700; color: #475569; margin-bottom: 6rpx; }
.audit-empty-tip {
  font-size: var(--ui-type-meta); color: #94a3b8; margin-top: 8rpx;
  text-align: center; line-height: 1.6;
}

/* ── Large scroll area for approvals ── */
.large-scroll { max-height: 900rpx; }

/* Final venue borrowing polish: remove flat timeline/table surfaces */
.timeline-drag-container .timeline-bar,
.timeline-bar {
  background: linear-gradient(135deg, rgba(226, 237, 247, 0.78), rgba(248, 251, 255, 0.70));
  border: 1rpx solid rgba(255, 255, 255, 0.66);
  box-shadow:
    inset 0 1rpx 5rpx rgba(15, 23, 42, 0.08),
    0 8rpx 18rpx rgba(15, 23, 42, 0.025);
}

.timeline-selection {
  background: linear-gradient(90deg, rgba(37, 99, 235, 0.72), rgba(96, 165, 250, 0.62));
  border-radius: 999rpx;
  box-shadow: 0 0 20rpx rgba(37, 99, 235, 0.22);
}

.timeline-block.tl-free {
  background: linear-gradient(180deg, rgba(187, 247, 208, 0.92), rgba(74, 222, 128, 0.74));
}

.timeline-block.tl-booked {
  background: linear-gradient(180deg, rgba(254, 202, 202, 0.92), rgba(248, 113, 113, 0.74));
}

.timeline-block.tl-pending {
  background: linear-gradient(180deg, rgba(254, 243, 199, 0.94), rgba(251, 191, 36, 0.74));
}

.timeline-block.tl-activity {
  background: linear-gradient(180deg, rgba(219, 234, 254, 0.94), rgba(96, 165, 250, 0.74));
}

.timeline-block.tl-closed {
  background: linear-gradient(180deg, rgba(241, 245, 249, 0.92), rgba(203, 213, 225, 0.72));
}

.tl-tag,
.hour-chip,
.min-chip,
.duration-chip,
.time-valid-badge {
  box-shadow:
    0 6rpx 14rpx rgba(15, 23, 42, 0.035),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.58);
}

.hour-chip,
.min-chip,
.duration-chip {
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.92), rgba(247, 250, 255, 0.82));
  border-color: rgba(226, 237, 247, 0.86);
}

/* 激活态必须放在通用白底规则之后，防止出现白底白字。 */
.duration-chip.duration-chip-active {
  background: linear-gradient(135deg, #2563eb 0%, #3b82f6 100%) !important;
  color: #ffffff !important;
  border-color: rgba(37, 99, 235, 0.72) !important;
  box-shadow: 0 6rpx 16rpx rgba(37, 99, 235, 0.18) !important;
}

.tt-time-header,
.tt-col-header,
.tt-time-label {
  background: linear-gradient(135deg, rgba(248, 251, 255, 0.95), rgba(239, 246, 255, 0.84));
  border-color: rgba(226, 237, 247, 0.76);
}

.tt-open-block {
  background: linear-gradient(135deg, rgba(219, 234, 254, 0.42), rgba(239, 246, 255, 0.34));
  border-radius: 10rpx;
}

.tt-event-block {
  border-radius: 10rpx;
  box-shadow:
    0 5rpx 12rpx rgba(15, 23, 42, 0.04),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.54);
}

.tt-event-block.booked {
  background: linear-gradient(135deg, rgba(255, 247, 237, 0.88), rgba(254, 215, 170, 0.76));
}

.tt-event-block.pending {
  background: linear-gradient(135deg, rgba(255, 237, 213, 0.88), rgba(253, 186, 116, 0.72));
}

.tt-event-block.activity {
  background: linear-gradient(135deg, rgba(219, 234, 254, 0.88), rgba(191, 219, 254, 0.74));
  border-color: rgba(147, 197, 253, 0.46);
}

.pending-entry-bar,
.time-summary,
.audit-flow-summary {
  box-shadow:
    0 14rpx 28rpx rgba(37, 99, 235, 0.08),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.78);
}

.status-tag.pending {
  color: #c2410c;
  background: linear-gradient(135deg, rgba(255,247,237,0.96), rgba(254,215,170,0.84));
  border-color: rgba(253,186,116,0.58);
}

.status-tag.approved {
  color: #15803d;
  background: linear-gradient(135deg, rgba(220,252,231,0.96), rgba(167,243,208,0.84));
  border-color: rgba(110,231,183,0.58);
}

.status-tag.rejected,
.status-tag.cancelled {
  color: #64748b;
  background: linear-gradient(135deg, rgba(248,250,252,0.96), rgba(226,232,240,0.84));
  border-color: rgba(203,213,225,0.58);
}

.status-tag.inUse,
.status-tag.completed {
  color: #0369a1;
  background: linear-gradient(135deg, rgba(224,242,254,0.96), rgba(186,230,253,0.84));
  border-color: rgba(56,189,248,0.56);
}

.tl-dot.free {
  background: linear-gradient(135deg, rgba(187,247,208,0.96), rgba(74,222,128,0.78));
}

.tl-dot.booked {
  background: linear-gradient(135deg, rgba(254,202,202,0.96), rgba(248,113,113,0.76));
}

.tl-dot.activity {
  background: linear-gradient(135deg, rgba(219,234,254,0.96), rgba(96,165,250,0.76));
}

.tt-dot.open { background: linear-gradient(135deg, #dbeafe, #bfdbfe); }
.tt-dot.booked { background: linear-gradient(135deg, #fff7ed, #fed7aa); }
.tt-dot.pending { background: linear-gradient(135deg, #ffedd5, #fdba74); }
.tt-dot.activity { background: linear-gradient(135deg, #dbeafe, #93c5fd); border-color: #93c5fd; }
.tt-dot.closed { background: linear-gradient(135deg, #f8fafc, #e2e8f0); }

/* Final local motion override loaded after legacy :active rules. */
.card:active,
.section:active,
.venue-card:active {
  transform: none !important;
  filter: none !important;
}

@media (max-width: 519px) {
  .tabs-card {
    gap: var(--ui-tab-gap, 8rpx);
    padding: var(--ui-tab-shell-padding, 8rpx);
  }

  .tabs-card .feature-tab {
    min-width: 0;
    min-height: var(--ui-tab-min-height, 66rpx);
    padding: var(--ui-tab-padding-y, 14rpx) 6rpx;
    font-size: var(--ui-tab-font-size, 24rpx);
    line-height: var(--ui-leading-control, 1.35);
    white-space: nowrap;
    word-break: keep-all;
  }

  .venue-card {
    flex-direction: column;
    align-items: stretch;
  }

  .venue-actions {
    width: 100%;
    justify-content: flex-end;
  }
}

@media (min-width: 520px) {
  .page {
    max-width: 760px;
  }

  .timetable-popup {
    width: calc(100vw - 48px);
    width: min(920px, calc(100vw - 48px));
  }

  .timetable-scroll {
    height: calc(90vh - 190px);
    min-height: 420px;
    max-height: 720px;
  }

  .tt-time-col {
    width: 56px;
    min-width: 56px;
  }

  .tt-cols-row {
    min-width: 504px;
  }

  .tt-col {
    flex: 0 0 72px;
    min-width: 72px;
  }

  .tt-time-header,
  .tt-time-label,
  .tt-col-header,
  .tt-col-sub,
  .tt-event-label,
  .tt-legend {
    font-size: var(--ui-type-caption);
  }

  .inner-scroll,
  .large-scroll {
    max-height: 65vh !important;
  }
}

@media (min-width: 900px) {
  .page {
    display: block;
    max-width: 1180px;
  }

  .page > .hero,
  .page > .workspace-hero-host,
  .page > .page-footer {
    width: 100%;
  }

  .page > .workspace-hero-host {
    margin-bottom: 0;
  }

  .page > .tabs-card {
    position: static;
    z-index: 24;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--ui-tab-gap);
    padding: var(--ui-tab-shell-padding);
    margin-bottom: 14px;
    border-radius: var(--ui-tab-shell-radius);
  }

  .page > .tabs-card .feature-tab {
    width: 100%;
    min-height: var(--ui-tab-min-height);
    justify-content: center;
    padding: var(--ui-tab-padding-y) var(--ui-tab-padding-x);
    text-align: center;
  }

  .page > .venue-workspace-panel {
    min-width: 0;
  }

  .venue-workspace-panel .card {
    margin-bottom: 0;
  }
}

.booking-item:active,
.pending-item:active,
.pending-entry-bar:active {
  transform: none !important;
}

.booking-item.control-pressing,
.pending-item.control-pressing,
.pending-entry-bar.control-pressing {
  transform: translate3d(0, 2rpx, 0) scale(0.992) !important;
  opacity: 0.975 !important;
  transition:
    transform 0.18s cubic-bezier(0.2, 0.78, 0.22, 1),
    box-shadow 0.20s ease,
    opacity 0.18s ease !important;
}

.action-btn:active,
.pending-action-link:active,
.hour-chip:active,
.min-chip:active,
.duration-chip:active {
  transform: translate3d(0, 1rpx, 0) scale(0.984) !important;
  opacity: 0.94 !important;
  transition:
    transform 0.16s cubic-bezier(0.2, 0.78, 0.22, 1),
    opacity 0.16s ease,
    box-shadow 0.18s ease !important;
}

@media (min-width: 520px) {
  .time-keyboard {
    left: 50%;
    right: auto;
    width: calc(100vw - 48px);
    max-width: 560px;
    transform: translateX(-50%);
    padding: 16px 18px calc(18px + env(safe-area-inset-bottom));
    border-radius: 20px 20px 0 0;
  }

  .time-kb-display {
    gap: 8px;
    margin-bottom: 12px;
    padding: 10px 12px;
  }

  .time-kb-box {
    height: 48px;
    border-radius: 12px;
    font-size: var(--ui-type-section);
  }

  .time-kb-colon {
    width: 24px;
    font-size: var(--ui-type-section);
  }

  .time-kb-confirm {
    height: 48px;
    padding: 0 18px;
    border-radius: 12px;
    font-size: var(--ui-type-label);
  }

  .time-kb-row {
    gap: 8px;
    margin-bottom: 8px;
  }

  .time-kb-key {
    height: 52px;
    border-radius: 12px;
    font-size: var(--ui-type-emphasis);
  }

  .time-kb-key-colon,
  .time-kb-key-bs {
    font-size: var(--ui-type-emphasis);
  }
}

@media (min-width: 520px) and (max-width: 899px) {
  .booking-form-popup .time-kb-display-row {
    min-height: var(--ui-field-control-height, 44px);
    gap: 6px;
    padding: 6px 10px;
    border-radius: var(--ui-field-radius, 10px);
  }

  .booking-form-popup .time-kb-display-box {
    width: 54px;
    height: 32px;
    border-radius: 10px;
  }

  .booking-form-popup .time-valid-badge {
    width: 24px;
    height: 24px;
  }
}

@media (min-width: 900px) and (orientation: landscape) {
  .booking-form-popup .time-kb-display-row {
    min-height: var(--ui-field-control-height, 44px);
    gap: 6px;
    padding: 6px 10px;
    border-radius: var(--ui-field-radius, 10px);
  }

  .booking-form-popup .time-kb-display-box {
    width: 52px;
    height: 32px;
    border-radius: 10px;
  }

  .booking-form-popup .time-valid-badge {
    width: 24px;
    height: 24px;
  }

  .time-keyboard {
    max-width: 620px;
  }
}

.pick-row {
  display: flex;
  align-items: center;
  width: 100%;
  min-width: 0;
}

.assignment-chip {
  display: inline-flex;
  align-self: flex-start;
  max-width: 100%;
  padding: 5rpx 12rpx;
  border: 1rpx solid rgba(147, 197, 253, 0.58);
  border-radius: var(--ui-compact-radius, 18rpx);
  background: linear-gradient(135deg, rgba(239, 246, 255, 0.96), rgba(219, 234, 254, 0.82));
  color: #2563eb;
  font-size: var(--ui-type-caption);
  font-weight: 700;
  line-height: 1.45;
  white-space: normal;
  overflow-wrap: anywhere;
  box-sizing: border-box;
}
.context-switch-notice {
  margin-top: 4rpx;
  padding: 10rpx 12rpx;
  border: 1rpx solid rgba(251, 191, 36, 0.46);
  border-radius: 14rpx;
  background: linear-gradient(135deg, rgba(255, 251, 235, 0.96), rgba(254, 243, 199, 0.78));
}
.context-switch-notice--detail { margin: 10rpx 0; }
.context-switch-title { color: #92400e; font-size: var(--ui-type-caption); font-weight: 700; line-height: 1.45; }
.context-switch-detail { margin-top: 4rpx; color: #a16207; font-size: var(--ui-type-micro); line-height: 1.5; overflow-wrap: anywhere; }
.context-switch-action { display: inline-flex; margin-top: 8rpx; color: #2563eb; font-size: var(--ui-type-caption); font-weight: 700; }
.pending-action-link.switch-context {
  max-width: 132rpx;
  color: #2563eb;
  background: linear-gradient(135deg, rgba(239,246,255,0.98), rgba(219,234,254,0.86));
  border: 1rpx solid rgba(147,197,253,0.58);
  text-align: center;
}

@media (min-width: 520px) {
  .work-context-notice { gap: 10px; margin-bottom: 10px; padding: 8px 10px; border-radius: 12px; }
  .assignment-chip { padding: 4px 9px; border-radius: 12px; }
  .context-switch-notice { padding: 7px 9px; border-radius: 10px; }
}

@media (min-width: 900px) and (orientation: landscape) {
  .pending-action-link.switch-context { max-width: 104px; }
}
