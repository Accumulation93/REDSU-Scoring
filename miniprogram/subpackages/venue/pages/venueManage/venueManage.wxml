  <!-- ═══ Approval Popup (step-aware approve/reject with comment) ═══ -->
  <viewport-portal wx:if="{{approvalPopupVisible}}">
  <view class="popup-mask ui-overlay" wx:if="{{approvalPopupVisible}}" bindtap="closeApprovalPopup">
    <view class="ui-overlay-blocker" catchtouchmove="noop"></view>
    <view class="popup-card ui-dialog-shell ui-dialog-shell--complex" catchtap="noop">
      <view class="popup-header ui-dialog-header">
        <view class="popup-title">{{approvalPopupAction === 'approve' ? localeCopy.copy_a63100b45d : localeCopy.copy_689e8f08db}}</view>
        <text class="popup-close ui-motion-chip" catchtap="closeApprovalPopup" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">{{localeCopy.copy_09614cef6c}}</text>
      </view>
      <scroll-view enhanced="{{true}}" show-scrollbar="{{true}}" bounces="{{true}}" nested-scroll-enabled="{{true}}" class="popup-scroll ui-dialog-body ui-dialog-content ui-dialog-scroll--fill" scroll-y>
        <view class="detail-body ui-dialog-stack">
          <view wx:if="{{approvalPopupTarget}}">
            <view class="detail-title">{{approvalPopupTarget.title || localeCopy.copy_9639901862}}</view>
            <view class="detail-row"><text class="detail-key">{{localeCopy.copy_bbbebc1abf}}</text><text class="detail-val">{{approvalPopupTarget.venueName}}</text></view>
            <view class="detail-row" wx:if="{{approvalPopupTarget.orgName}}"><text class="detail-key">{{localeCopy.copy_34e2d1f8a0}}</text><text class="detail-val">{{approvalPopupTarget.orgName}}</text></view>
            <view class="detail-row"><text class="detail-key">{{localeCopy.copy_ce30bda5a2}}</text><text class="detail-val">{{approvalPopupTarget.userName}}<text wx:if="{{approvalPopupTarget.userDept}}"> · {{approvalPopupTarget.userDept}}</text></text></view>
            <view class="detail-row" wx:if="{{approvalPopupTarget._creatorAssignmentText}}"><text class="detail-key">{{localeCopy.bookingAssignment}}</text><text class="detail-val"><text class="booking-assignment-chip">{{approvalPopupTarget._creatorAssignmentText}}</text></text></view>
            <view class="detail-row"><text class="detail-key">{{localeCopy.copy_4202a27ca6}}</text><text class="detail-val">{{approvalPopupTarget.timeStartText}} — {{approvalPopupTarget.timeEndText}}</text></view>
            <!-- Flow progress bar -->
            <view wx:if="{{approvalPopupTarget.approvalProgress}}" class="audit-flow-summary audit-flow-summary--spaced">
              <view class="audit-flow-progress-bar">
                <view class="audit-flow-progress-fill" style="width:{{approvalPopupTarget._approvalPercent}}%;{{approvalPopupTarget._approvalBarColor || ''}}"></view>
              </view>
              <text class="audit-flow-progress-text">{{approvalPopupTarget.approvalProgress.isRejected ? localeCopy.copy_5d5af942c5 : (approvalPopupTarget.approvalProgress.isApproved ? localeCopy.copy_2220286f1c : (approvalPopupTarget.approvalProgress.currentStep + '/' + approvalPopupTarget.approvalProgress.totalSteps))}}</text>
            </view>
            <view wx:if="{{approvalPopupTarget._flowTimeline && approvalPopupTarget._flowTimeline.length}}" class="audit-flow audit-flow--spaced">
              <view class="{{node.nodeClass}} {{expandedNodeKey === node._key ? 'flow-node-expanded' : ''}} ui-motion-chip" wx:for="{{approvalPopupTarget._flowTimeline}}" wx:key="_key" wx:for-item="node" catchtap="toggleFlowNode" data-node-key="{{node._key}}" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">
                <view class="flow-left-col">
                  <view class="{{node.dotClass}}">{{node.icon}}</view>
                  <view class="flow-connector" wx:if="{{!node.isLast}}"></view>
                </view>
                <view class="flow-right-col">
                  <view class="flow-info {{expandedNodeKey === node._key ? 'flow-info-expanded' : ''}}">
                    <view class="flow-info-title">{{node.stepName}}<text class="flow-step-status-tag flow-step-status-tag--inline flow-tag-{{node.state}}">{{node.label}}</text></view>
                    <view class="flow-info-desc" wx:if="{{node.meta}}">{{node.meta}}</view>
                    <view wx:if="{{node.state === 'done' || node.state === 'rejected'}}" class="flow-expand-hint">{{expandedNodeKey === node._key ? localeCopy.copy_4edcf754ff : localeCopy.copy_baec508307}}</view>
                    <view wx:if="{{expandedNodeKey === node._key && (node.state === 'done' || node.state === 'rejected')}}" class="flow-expand-detail">
                      <view wx:if="{{node.approverName}}" class="flow-detail-processed-text"><text class="flow-detail-label">{{localeCopy.copy_866290fa02}}</text>{{node.approverName}}</view>
                      <view wx:if="{{node.approverAssignmentText}}" class="flow-detail-processed-meta"><text class="flow-detail-label">{{localeCopy.approverAssignment}}</text>{{node.approverAssignmentText}}</view>
                      <view wx:if="{{node.approvedAtText}}" class="flow-detail-processed-meta">{{localeCopy.copy_dcadcebf08}}{{node.approvedAtText}}</view>
                      <view wx:if="{{node.comment}}" class="flow-detail-comment"><text class="flow-detail-label">{{localeCopy.copy_3b3b392755}}</text>{{node.comment}}</view>
                    </view>
                  </view>
                </view>
              </view>
            </view>
          </view>
          <view class="field field--approval-comment">
            <view class="field-label">{{localeCopy.copy_bddb855314}}</view>
            <textarea class="field-textarea" auto-height maxlength="-1" value="{{approvalPopupComment}}" bindinput="onApprovalCommentInput" placeholder="{{approvalPopupAction === 'approve' ? localeCopy.copy_bef4bbef62 : localeCopy.copy_a93266a8d4}}"/>
          </view>
        </view>
      </scroll-view>
      <view class="button-row ui-dialog-footer">
        <button class="secondary-btn ui-motion-button" catchtap="closeApprovalPopup" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">{{localeCopy.copy_06dbb49961}}</button>
        <button class="{{approvalPopupAction === 'approve' ? 'primary-btn' : 'danger-btn'}} ui-motion-button" loading="{{loading}}" catchtap="submitApprovalAction" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">
          {{approvalPopupAction === 'approve' ? localeCopy.copy_49ef170f0b : localeCopy.copy_cd42af3f87}}
        </button>
      </view>
    </view>
  </view>
  </viewport-portal>

