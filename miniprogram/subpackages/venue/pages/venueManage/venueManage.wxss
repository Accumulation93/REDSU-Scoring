@import '../../../main/styles/home.wxss';
@import '../../styles/blue-polish.wxss';

.booking-assignment-chip {
  display: inline-flex;
  max-width: 100%;
  margin-top: 6rpx;
  padding: 5rpx 12rpx;
  border: 1rpx solid rgba(147,197,253,0.58);
  border-radius: var(--ui-compact-radius, 18rpx);
  background: linear-gradient(135deg, rgba(239,246,255,0.96), rgba(219,234,254,0.82));
  color: #2563eb;
  font-size: var(--ui-type-caption);
  font-weight: 700;
  line-height: 1.45;
  overflow-wrap: anywhere;
  box-sizing: border-box;
}

@media (min-width: 520px) {
  .booking-assignment-chip { margin-top: 5px; padding: 4px 9px; border-radius: 12px; }
}

/* ═══ Page background (matching HR admin exactly) ═══ */
page {
  min-height: 100%;
  background:
    radial-gradient(circle at 12% 10%, rgba(96, 165, 250, 0.16) 0%, transparent 26%),
    radial-gradient(circle at 86% 18%, rgba(191, 219, 254, 0.22) 0%, transparent 24%),
    radial-gradient(circle at 18% 88%, rgba(125, 211, 252, 0.10) 0%, transparent 22%),
    linear-gradient(135deg, #f8fbff 0%, #f1f6fc 48%, #edf3fa 100%);
  color: #1f2a37;
  font-family: "PingFang SC", "Microsoft YaHei", sans-serif;
}

.page {
  position: relative;
  min-height: 100vh;
  padding: var(--ui-page-padding-top) var(--ui-page-padding-x) calc(var(--ui-page-padding-bottom) + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.page::before {
  content: "";
  position: fixed;
  top: -120rpx; right: -90rpx;
  width: 320rpx; height: 320rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(96, 165, 250, 0.18) 0%, rgba(96, 165, 250, 0) 72%);
  pointer-events: none;
}

.page::after {
  content: "";
  position: fixed;
  left: -120rpx; bottom: 150rpx;
  width: 280rpx; height: 280rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(147, 197, 253, 0.16) 0%, rgba(147, 197, 253, 0) 72%);
  pointer-events: none;
}

/* ═══ Admin dark hero card (matching HR admin .hero-admin) ═══ */
.hero-admin {
  position: relative;
  overflow: hidden;
  margin-bottom: 28rpx;
  padding: 40rpx 34rpx 36rpx;
  border-radius: 34rpx;
  background:
    linear-gradient(135deg, rgba(15, 23, 42, 0.96) 0%, rgba(30, 41, 59, 0.96) 42%, rgba(37, 99, 235, 0.92) 100%);
  border: 1rpx solid rgba(255, 255, 255, 0.24);
  box-shadow:
    0 26rpx 54rpx rgba(15, 23, 42, 0.22),
    0 0 28rpx rgba(37, 99, 235, 0.08),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.14);
  animation: glassFadeUp 0.42s ease both;
}

.hero-admin::before {
  content: "";
  position: absolute;
  top: -130rpx; right: -56rpx;
  width: 280rpx; height: 280rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(96, 165, 250, 0.30) 0%, rgba(96, 165, 250, 0.06) 46%, rgba(96, 165, 250, 0) 72%);
}

.hero-admin::after {
  content: "";
  position: absolute;
  left: 34rpx; right: 34rpx; bottom: 20rpx;
  height: 1rpx;
  background: linear-gradient(90deg, rgba(255, 255, 255, 0.16) 0%, rgba(191, 219, 254, 0.34) 52%, rgba(255, 255, 255, 0) 100%);
}

.hero-admin .hero-badge,
.hero-admin .hero-title,
.hero-admin .hero-subtitle {
  position: relative; z-index: 1;
}

.hero-admin .hero-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 14rpx;
  padding: 10rpx 24rpx;
  border-radius: var(--ui-compact-radius, 18rpx);
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.22), rgba(255, 255, 255, 0.14));
  border: 1rpx solid rgba(255, 255, 255, 0.28);
  color: #f8fbff;
  font-size: var(--ui-type-caption); font-weight: 700;
  letter-spacing: 0.4rpx;
}

.hero-admin .hero-title {
  color: #ffffff;
  font-size: var(--ui-type-page); font-weight: 800;
  line-height: 1.24; letter-spacing: 0.3rpx;
  text-shadow: 0 6rpx 16rpx rgba(0, 0, 0, 0.08);
}

.hero-subtitle,
.hero-admin-subtitle {
  margin-top: 12rpx;
  color: rgba(241, 245, 249, 0.90);
  font-size: var(--ui-type-emphasis); line-height: 1.72;
}

.hero-admin .hero-org-context {
  background: linear-gradient(135deg, rgba(96, 165, 250, 0.20), rgba(255, 255, 255, 0.08));
  border-color: rgba(191, 219, 254, 0.24);
  box-shadow: 0 12rpx 28rpx rgba(2, 6, 23, 0.16), inset 0 1rpx 0 rgba(255, 255, 255, 0.16);
}

.hero-admin .hero-org-context-pressing {
  background: linear-gradient(135deg, rgba(96, 165, 250, 0.26), rgba(255, 255, 255, 0.11));
  box-shadow: 0 6rpx 16rpx rgba(2, 6, 23, 0.13), inset 0 1rpx 0 rgba(255, 255, 255, 0.18);
}

/* ═══ Main tabs — exact HR admin pill style ═══ */
.tabs {
  display: flex;
  flex-wrap: wrap;
  gap: var(--ui-tab-gap, 8rpx);
  margin-bottom: var(--ui-card-gap, 24rpx);
}

.tab {
  min-height: var(--ui-tab-min-height, 66rpx);
  padding: var(--ui-tab-padding-y, 14rpx) var(--ui-tab-padding-x, 18rpx);
  border-radius: var(--ui-tab-radius, 20rpx);
  background: rgba(255, 255, 255, 0.74);
  border: 1rpx solid rgba(255, 255, 255, 0.54);
  color: #53687f;
  font-size: var(--ui-tab-font-size, 24rpx); font-weight: 600;
  line-height: var(--ui-leading-control, 1.35);
  box-shadow: 0 10rpx 22rpx rgba(15, 23, 42, 0.04);
  transition: transform 0.18s ease, box-shadow 0.22s ease, background 0.22s ease, color 0.22s ease;
}

.tab-active {
  color: #ffffff;
  background: linear-gradient(135deg, #2563eb 0%, #3b82f6 58%, #60a5fa 100%);
  box-shadow: 0 16rpx 30rpx rgba(37, 99, 235, 0.22);
}

.tab:active {
  transform: translateY(1rpx) scale(0.985);
}

/* ═══ Section container ═══ */
.section-host {
  margin: 0;
  padding: 0;
  border: none; background: transparent; box-shadow: none;
  backdrop-filter: none;
  -webkit-backdrop-filter: none;
}

/* ═══ Section title — blue gradient accent bar (exact HR admin) ═══ */
.section-title,
.list-title {
  position: relative;
  padding-left: var(--ui-section-title-inset, 20rpx);
  margin-bottom: var(--ui-field-gap, 16rpx);
  color: #0f172a;
  font-size: var(--ui-type-section); font-weight: 700;
  line-height: 1.4;
}

.section-title::before,
.list-title::before {
  content: "";
  position: absolute;
  left: 0; top: 50%;
  width: 8rpx; height: 28rpx;
  border-radius: 999rpx;
  transform: translateY(-50%);
  background: linear-gradient(180deg, #2563eb 0%, #60a5fa 100%);
  box-shadow: 0 0 14rpx rgba(59, 130, 246, 0.24);
}

/* ═══ Glass cards — exact HR admin .edit-box / .list-card ═══ */
.edit-box,
.list-card,
.booking-panel {
  margin-top: 0;
  margin-bottom: var(--ui-card-gap, 24rpx);
  padding: var(--ui-card-padding-y, 28rpx) var(--ui-card-padding-x, 26rpx);
  border-radius: 26rpx;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.72) 0%, rgba(247, 250, 255, 0.62) 100%);
  border: 1rpx solid rgba(255, 255, 255, 0.62);
  box-shadow:
    inset 0 1rpx 0 rgba(255, 255, 255, 0.78),
    0 12rpx 26rpx rgba(15, 23, 42, 0.04);
  backdrop-filter: none;
  -webkit-backdrop-filter: none;
  transition: transform 0.22s ease, box-shadow 0.28s ease, border-color 0.24s ease, background 0.24s ease;
  animation: glassFadeUp 0.48s ease both;
  box-sizing: border-box;
}

/* ═══ Panel head — HR-style title + note + add btn ═══ */
.panel-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--ui-inline-gap, 10rpx);
  margin-bottom: var(--ui-field-gap, 16rpx);
}

.panel-title-group {
  flex: 1; min-width: 0;
}

.panel-head .section-title {
  margin-bottom: 0;
}

.panel-note {
  margin-top: 6rpx;
  color: #7a8799;
  font-size: var(--ui-type-label); line-height: 1.5;
}

/* ═══ Field labels ═══ */
.field-label {
  margin-bottom: var(--ui-label-gap, 6rpx);
  color: #52647c;
  font-size: var(--ui-type-label); font-weight: 700;
  line-height: 1.45;
  padding-left: 0;
}

.field-label::before {
  display: none;
}

/* ═══ Form inputs — HR glass style ═══ */
.field-input,
.field-textarea,
.picker-value,
.picker-display {
  width: 100%;
  box-sizing: border-box;
  border-radius: 22rpx;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.92) 0%, rgba(247, 250, 255, 0.82) 100%);
  border: 1rpx solid rgba(226, 232, 240, 0.68);
  color: #0f172a;
  box-shadow:
    inset 0 1rpx 0 rgba(255, 255, 255, 0.78),
    0 8rpx 18rpx rgba(15, 23, 42, 0.03);
  transition: box-shadow 0.22s ease, border-color 0.22s ease, background 0.22s ease;
}

.field-input,
.picker-value,
.picker-display {
  min-height: var(--ui-control-height, 82rpx);
  font-size: var(--ui-type-emphasis);
}

.field-input {
  display: block;
  padding: var(--ui-control-padding-y, 16rpx) var(--ui-control-padding-x, 28rpx);
  line-height: var(--ui-leading-control, 1.35);
}

.picker-value,
.picker-display {
  display: flex;
  align-items: center;
  padding: var(--ui-control-padding-y, 16rpx) var(--ui-control-padding-x, 28rpx);
}

.field-textarea {
  min-height: 160rpx;
  padding: var(--ui-control-padding-y, 16rpx) var(--ui-control-padding-x, 28rpx);
  font-size: var(--ui-type-emphasis);
}

.field-input:focus,
.field-textarea:focus {
  border-color: rgba(96, 165, 250, 0.92);
  box-shadow:
    0 14rpx 28rpx rgba(37, 99, 235, 0.10),
    0 0 0 4rpx rgba(191, 219, 254, 0.55),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.9);
}

.picker-value:active {
  transform: translateY(1rpx) scale(0.992);
  border-color: rgba(96, 165, 250, 0.92);
  box-shadow:
    0 12rpx 24rpx rgba(37, 99, 235, 0.12),
    0 0 0 4rpx rgba(191, 219, 254, 0.62);
}

/* ═══ Buttons — compact blue-glass rounded rectangles ═══ */
.primary-btn,
.secondary-btn,
.danger-btn,
.approve-btn,
.reject-btn {
  flex: 1 1 280rpx;
  min-width: 220rpx;
  min-height: var(--ui-control-height, 82rpx);
  height: auto;
  padding: var(--ui-control-padding-y, 16rpx) var(--ui-control-padding-x, 28rpx);
  border-radius: var(--ui-control-radius, 28rpx);
  line-height: 1.35;
  font-size: var(--ui-type-control); font-weight: 700;
  white-space: normal;
  word-break: normal;
  overflow-wrap: anywhere;
  transition: box-shadow 0.24s ease, opacity 0.18s ease, filter 0.24s ease;
  margin: 0;
}

.primary-btn,
.approve-btn {
  color: #ffffff;
  background: linear-gradient(135deg, #2563eb 0%, #60a5fa 100%);
  box-shadow: 0 16rpx 32rpx rgba(37, 99, 235, 0.18);
}

.secondary-btn {
  color: #2563eb;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.92) 0%, rgba(235, 243, 255, 0.86) 100%);
  border: 1rpx solid rgba(191, 219, 254, 0.8);
  box-shadow: 0 12rpx 24rpx rgba(37, 99, 235, 0.08);
}

.danger-btn,
.reject-btn {
  color: #ffffff;
  background: linear-gradient(135deg, #ef4444 0%, #f87171 100%);
  box-shadow: 0 16rpx 30rpx rgba(239, 68, 68, 0.16);
}

.primary-btn:active,
.secondary-btn:active,
.approve-btn:active,
.reject-btn:active {
  transform: translateY(2rpx) scale(0.986);
  filter: saturate(1.03);
}

.primary-btn::after,
.secondary-btn::after,
.danger-btn::after,
.approve-btn::after,
.reject-btn::after {
  border: none;
}

/* Small button variants */
.secondary-btn.sm {
  flex: 0 0 auto;
  min-width: 0; min-height: var(--ui-compact-height, 52rpx);
  height: auto; line-height: var(--ui-leading-control, 1.35);
  font-size: var(--ui-type-meta); padding: var(--ui-compact-padding-y, 6rpx) var(--ui-compact-padding-x, 14rpx);
  border-radius: var(--ui-compact-radius, 18rpx);
}

.primary-btn.sm {
  flex: 0 0 auto;
  min-width: 0; min-height: var(--ui-compact-height, 52rpx);
  height: auto; line-height: var(--ui-leading-control, 1.35);
  font-size: var(--ui-type-meta); padding: var(--ui-compact-padding-y, 6rpx) var(--ui-compact-padding-x, 14rpx);
  border-radius: var(--ui-compact-radius, 18rpx);
}

/* ═══ Compact add button (panel head right side) ═══ */
.panel-add-btn {
  flex: 0 0 auto;
  min-width: 108rpx; width: auto;
  min-height: var(--ui-compact-height, 52rpx); height: auto;
  line-height: var(--ui-leading-control, 1.35);
  padding: var(--ui-compact-padding-y, 6rpx) var(--ui-compact-padding-x, 14rpx);
  border-radius: var(--ui-control-radius, 28rpx);
  font-size: var(--ui-type-control); font-weight: 700;
}

/* ═══ Purpose save button ═══ */
.purpose-save-btn {
  flex: 0 0 auto;
  min-width: 104rpx; width: auto;
  min-height: 72rpx; height: auto;
  line-height: var(--ui-leading-control, 1.35);
  padding: var(--ui-compact-padding-y, 6rpx) var(--ui-compact-padding-x, 14rpx);
  border-radius: var(--ui-control-radius, 28rpx);
  font-size: var(--ui-type-label); font-weight: 700;
  color: #ffffff;
  background: linear-gradient(135deg, #2563eb 0%, #60a5fa 100%);
  box-shadow: 0 10rpx 22rpx rgba(37, 99, 235, 0.18);
}

.purpose-save-btn::after {
  border: none;
}

.purpose-cancel-btn {
  flex: 0 0 auto;
  min-width: 104rpx;
  width: auto;
  min-height: 72rpx;
  height: auto;
  line-height: var(--ui-leading-control, 1.35);
  padding: var(--ui-compact-padding-y, 6rpx) var(--ui-compact-padding-x, 14rpx);
  font-size: var(--ui-type-label);
}

/* ═══ Purpose input row ═══ */
.purpose-input-row {
  display: flex;
  align-items: stretch;
  gap: 12rpx;
}

.purpose-input-row .field-input {
  flex: 1; min-width: 0;
}

.admin-timeline-drag { margin: 14rpx 0 8rpx; }
.admin-timeline-drag .timeline-bar { position: relative; height: 54rpx; overflow: visible; border-radius: 16rpx; background: linear-gradient(135deg, rgba(226,232,240,.92), rgba(241,245,249,.82)); border: 1rpx solid rgba(203,213,225,.78); }
.admin-timeline-drag .timeline-block { position: absolute; top: 0; height: 100%; min-width: 3rpx; }
.admin-timeline-drag .tl-free { background: linear-gradient(180deg, #86efac, #4ade80); }
.admin-timeline-drag .tl-booked { background: linear-gradient(180deg, #fdba74, #fb923c); }
.admin-timeline-drag .tl-activity { background: linear-gradient(180deg, #93c5fd, #60a5fa); }
.admin-timeline-drag .timeline-selection { position: absolute; top: 0; bottom: 0; background: rgba(37,99,235,.38); border: 2rpx solid #2563eb; box-sizing: border-box; }
.admin-timeline-drag .timeline-handle { position: absolute; top: 50%; z-index: 4; width: 34rpx; height: 34rpx; margin: -17rpx 0 0 -17rpx; border-radius: 999rpx; background: linear-gradient(135deg, #2563eb, #3b82f6); border: 4rpx solid #fff; box-shadow: 0 8rpx 18rpx rgba(37,99,235,.28); }
.timeline-hint { color: #64748b; font-size: var(--ui-type-meta); line-height: 1.5; }
.timeline-ticks { display: flex; justify-content: space-between; margin-top: 7rpx; color: #94a3b8; font-size: var(--ui-type-caption); }

/* ═══ List items — HR glass card style ═══ */
.list-item,
.booking-item,
.flow-step-card,
.flow-rule-card,
.rule-edit-box {
  margin-bottom: 14rpx;
  padding: 22rpx 20rpx;
  border-radius: 22rpx;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.92) 0%, rgba(249, 251, 255, 0.82) 100%);
  border: 1rpx solid rgba(226, 237, 247, 0.96);
  box-shadow:
    0 12rpx 24rpx rgba(15, 23, 42, 0.04),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.78);
  backdrop-filter: none;
  -webkit-backdrop-filter: none;
  box-sizing: border-box;
  transition: transform 0.18s ease, box-shadow 0.24s ease, border-color 0.24s ease;
}

.list-item:last-child,
.booking-item:last-child {
  margin-bottom: 0;
}

.list-item-stacked {
  display: block;
}

.list-main {
  flex: 1; min-width: 0;
}

.list-name,
.booking-item-title,
.flow-step-name {
  color: #0f172a;
  font-size: var(--ui-type-value); font-weight: 700;
  line-height: 1.45;
  margin-bottom: 10rpx;
}

.list-desc,
.booking-item-meta,
.flow-rule-summary,
.flow-rule-tag,
.field-hint,
.detail-val {
  color: #64748b;
  font-size: var(--ui-type-meta);
  line-height: 1.72;
  white-space: pre-wrap;
  word-break: break-word;
}

/* ═══ Inline action links — HR admin pill style ═══ */
.link {
  display: inline-flex;
  align-items: center; justify-content: center;
  min-height: 36rpx;
  padding: 6rpx 16rpx;
  border-radius: var(--ui-compact-radius, 18rpx);
  font-size: var(--ui-type-control); font-weight: 600;
  line-height: 1.25;
  background: rgba(219, 234, 254, 0.65);
  color: #2563eb;
  border: 1rpx solid rgba(147, 197, 253, 0.45);
  transition: transform 0.12s ease, opacity 0.12s ease;
}

.link:active {
  transform: scale(0.94);
  opacity: 0.85;
}

.link.danger {
  background: rgba(254, 226, 226, 0.65);
  color: #dc2626;
  border-color: rgba(252, 165, 165, 0.45);
}

.link.sm {
  font-size: var(--ui-type-caption); padding: 6rpx 14rpx;
}

/* Final small-control motion: reduce harsh link compression. */
.link:active {
  transform: translate3d(0, 1rpx, 0) scale(0.984) !important;
  opacity: 0.94 !important;
  transition:
    transform 0.16s cubic-bezier(0.2, 0.78, 0.22, 1),
    opacity 0.16s ease,
    box-shadow 0.18s ease !important;
}

.inline-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  align-items: center;
  justify-content: flex-end;
  min-width: 140rpx;
  align-content: flex-start;
}

.list-actions-below {
  margin-top: 16rpx;
  justify-content: flex-start;
  min-width: 0;
}

/* ═══ Filter group: subordinate surface inside the booking panel ═══ */
.filter-group {
  margin-bottom: var(--ui-field-gap, 16rpx);
  padding: var(--ui-field-gap, 16rpx);
  border-radius: 20rpx;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.72) 0%, rgba(248, 251, 255, 0.58) 100%);
  border: 1rpx solid rgba(255, 255, 255, 0.58);
  box-shadow:
    inset 0 1rpx 0 rgba(255, 255, 255, 0.72),
    0 8rpx 20rpx rgba(15, 23, 42, 0.03);
  backdrop-filter: none;
  -webkit-backdrop-filter: none;
}

.filter-label {
  margin-bottom: var(--ui-label-gap, 6rpx); padding-left: 0;
  color: #52647c;
  font-size: var(--ui-type-label); font-weight: 700;
  line-height: 1.45;
}

.filter-label::before {
  display: none;
}

.filter-scroll {
  width: 100%; white-space: nowrap;
}

.filter-row {
  display: inline-flex; gap: 10rpx;
}

/* ═══ Filter chips — HR pill style ═══ */
.filter-chip,
.chip {
  display: inline-flex;
  align-items: center; justify-content: center;
  min-height: 34rpx;
  padding: 6rpx 14rpx;
  border-radius: var(--ui-compact-radius, 18rpx);
  font-size: var(--ui-type-meta); font-weight: 700;
  line-height: 1.35;
  background: rgba(219, 234, 254, 0.76);
  color: #2563eb;
  border: 1rpx solid rgba(147, 197, 253, 0.64);
  transition: transform 0.12s ease, opacity 0.12s ease;
}

.filter-chip.active,
.chip.active {
  color: #ffffff;
  background: linear-gradient(135deg, #2563eb 0%, #3b82f6 58%, #60a5fa 100%);
  box-shadow: 0 10rpx 22rpx rgba(37, 99, 235, 0.20);
  border-color: transparent;
}

.chip.sm {
  width: 56rpx; height: 52rpx; padding: 0;
  font-size: var(--ui-type-meta); border-radius: var(--ui-compact-radius, 18rpx);
}

/* ═══ Booking status chips — HR pill style ═══ */
.booking-status,
.status-tag {
  display: inline-flex;
  align-items: center; justify-content: center;
  min-height: 38rpx; min-width: 48rpx;
  padding: 4rpx 8rpx;
  border-radius: var(--ui-compact-radius, 18rpx);
  font-size: var(--ui-type-micro); font-weight: 700;
  line-height: 1.1;
  border: 1rpx solid transparent;
}

.booking-status.pending,
.status-tag.pending {
  color: #c2410c;
  background: linear-gradient(135deg, rgba(255, 247, 237, 0.96) 0%, rgba(254, 215, 170, 0.88) 100%);
  border-color: rgba(253, 186, 116, 0.58);
}

.booking-status.approved,
.status-tag.approved {
  color: #15803d;
  background: linear-gradient(135deg, rgba(220, 252, 231, 0.96) 0%, rgba(167, 243, 208, 0.88) 100%);
  border-color: rgba(134, 239, 172, 0.55);
}

.booking-status.inUse,
.booking-status.completed {
  color: #0369a1;
  background: linear-gradient(135deg, rgba(224, 242, 254, 0.96) 0%, rgba(186, 230, 253, 0.88) 100%);
  border-color: rgba(56, 189, 248, 0.55);
}

.booking-status.rejected,
.booking-status.cancelled,
.status-tag.rejected,
.status-tag.cancelled {
  color: #dc2626;
  background: linear-gradient(135deg, rgba(254, 242, 242, 0.96) 0%, rgba(254, 202, 202, 0.88) 100%);
  border-color: rgba(252, 165, 165, 0.45);
}

/* ═══ Select chip (inline multi-picker) ═══ */
.select-chip {
  display: inline-flex;
  align-items: center; justify-content: center;
  padding: 6rpx 14rpx;
  border-radius: var(--ui-compact-radius, 18rpx);
  font-size: var(--ui-type-caption); font-weight: 700;
  background: linear-gradient(135deg, rgba(239, 246, 255, 0.98) 0%, rgba(219, 234, 254, 0.90) 100%);
  color: #2563eb;
  border: 1rpx solid rgba(147, 197, 253, 0.8);
}

.select-chip-active {
  background: linear-gradient(135deg, rgba(220, 252, 231, 0.98) 0%, rgba(187, 247, 208, 0.9) 100%);
  color: #15803d;
  border-color: rgba(134, 239, 172, 0.8);
}

/* ═══ Layout rows ═══ */
.time-filter-row,
.input-row,
.time-picker-row {
  display: flex;
  gap: 12rpx;
  align-items: center;
}

.time-filter-row {
  flex-wrap: wrap;
}

.time-to {
  font-size: var(--ui-type-control); color: #94a3b8; font-weight: 500;
  margin: 0 2rpx; flex-shrink: 0;
}

.filter-clear {
  display: inline-flex;
  align-items: center; justify-content: center;
  height: var(--ui-inline-control-height, 56rpx);
  min-height: var(--ui-inline-control-height, 56rpx);
  margin: 0;
  padding: 0 16rpx;
  border-radius: 999rpx;
  color: #dc2626;
  font-size: var(--ui-type-caption); font-weight: 600;
  background: rgba(254, 226, 226, 0.65);
  border: 1rpx solid rgba(252, 165, 165, 0.45);
}

/* ═══ Time picker ═══ */
.time-pick {
  height: var(--ui-inline-control-height, 56rpx);
  min-height: var(--ui-inline-control-height, 56rpx);
  width: auto;
  padding: 0 16rpx;
  font-size: var(--ui-type-meta);
}

.time-val {
  min-width: 100rpx; width: auto;
  min-height: auto;
  height: 68rpx; line-height: 68rpx; text-align: center;
  font-size: var(--ui-type-section); font-weight: 700; color: #0f172a;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.92) 0%, rgba(247, 250, 255, 0.82) 100%);
  border-radius: 18rpx;
  border: 1rpx solid rgba(226, 232, 240, 0.68);
  box-shadow:
    inset 0 1rpx 0 rgba(255, 255, 255, 0.78),
    0 6rpx 14rpx rgba(15, 23, 42, 0.03);
  padding: 0 14rpx;
}

.time-sep {
  font-size: var(--ui-type-section); color: #64748b; font-weight: 500;
}

.time-result {
  font-size: var(--ui-type-value); color: #2563eb; font-weight: 700; min-width: 100rpx;
}

/* ═══ Picker display ═══ */
.picker-display {
  width: 100%; min-height: var(--ui-field-control-height, 82rpx);
  padding: 0 24rpx; border-radius: var(--ui-field-radius, 20rpx);
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.92) 0%, rgba(247, 250, 255, 0.82) 100%);
  border: 1rpx solid rgba(226, 232, 240, 0.68);
  box-shadow:
    inset 0 1rpx 0 rgba(255, 255, 255, 0.78),
    0 8rpx 18rpx rgba(15, 23, 42, 0.03);
  font-size: var(--ui-type-emphasis); color: #0f172a;
  box-sizing: border-box;
  display: flex; align-items: center;
}

/* Small picker for yearly ranges */
.picker-sm {
  min-width: 100rpx; width: auto;
  min-height: auto;
  height: 64rpx; line-height: 64rpx; text-align: center;
  font-size: var(--ui-type-control); font-weight: 600; color: #1e293b;
  background: rgba(255, 255, 255, 0.85); border-radius: 16rpx;
  border: 1rpx solid rgba(203, 213, 225, 0.65); padding: 0 14rpx;
}

/* ═══ Chip section (weekday/month chips) ═══ */
.chip-section { margin-bottom: 14rpx; }

.chip-row {
  display: flex; flex-wrap: wrap; gap: 10rpx;
  margin-top: 8rpx;
}

.chip-row.small { gap: 5rpx; }

/* ═══ Year chips ═══ */
.year-chip {
  display: inline-flex; align-items: center; gap: 6rpx;
  font-size: var(--ui-type-meta); padding: 10rpx 18rpx; border-radius: var(--ui-compact-radius, 18rpx); margin: 3rpx;
  background: linear-gradient(135deg, rgba(219, 234, 254, 0.96) 0%, rgba(191, 219, 254, 0.88) 100%);
  color: #2563eb; border: 1rpx solid rgba(147, 197, 253, 0.7);
}

.year-chip-remove {
  color: #ef4444; font-weight: 700; margin-left: 6rpx; font-size: var(--ui-type-control);
}

/* Yearly range row */
.range-row { display: flex; gap: 8rpx; align-items: center; margin-bottom: 8rpx; }
.range-label { font-size: var(--ui-type-control); color: #64748b; min-width: 40rpx; }

.add-range-btn {
  font-size: var(--ui-type-control); color: #fff;
  background: linear-gradient(135deg, #2563eb 0%, #6366f1 100%);
  padding: 12rpx 24rpx; border-radius: var(--ui-compact-radius, 18rpx); font-weight: 600;
  white-space: nowrap;
  box-shadow: 0 6rpx 14rpx rgba(37, 99, 235, 0.20);
}

/* ═══ Button rows ═══ */
.button-row {
  display: flex;
  flex-wrap: wrap;
  gap: var(--ui-inline-gap, 10rpx);
  margin: var(--ui-action-gap, 20rpx) 0 0;
}

.button-row button {
  flex: 1;
}

.compact-row {
  margin-top: var(--ui-inline-gap, 10rpx);
}

/* ═══ Inner scroll ═══ */
.inner-scroll {
  padding-right: 0;
}

.large-scroll {
  max-height: 820rpx;
}

/* ═══ Loading overlay ═══ */
.card-loading-overlay {
  display: flex;
  align-items: center; justify-content: center;
  padding: 32rpx 0;
}

.card-loading-spinner {
  width: 40rpx; height: 40rpx;
  border: 5rpx solid rgba(37, 99, 235, 0.16);
  border-top-color: #2563eb;
  border-radius: 50%;
  animation: adminSpin 0.7s linear infinite;
}

@keyframes adminSpin {
  to { transform: rotate(360deg); }
}

/* ═══ Empty state ═══ */
.empty-inline {
  padding: 24rpx 8rpx;
  color: #64748b;
  font-size: var(--ui-type-control); line-height: 1.7;
  text-align: center;
}

/* ═══ Booking item specifics ═══ */
.booking-item-head {
  display: flex;
  gap: 12rpx;
  align-items: flex-start;
  margin-bottom: 10rpx;
}

.booking-item-title {
  flex: 1; min-width: 0;
}

.booking-actions {
  display: flex;
  gap: var(--ui-inline-gap, 10rpx);
  margin-top: var(--ui-action-gap, 20rpx);
}

.booking-actions .approve-btn,
.booking-actions .reject-btn {
  flex: 1;
  min-width: 0;
  min-height: 68rpx; height: auto;
  line-height: var(--ui-leading-control, 1.35);
  padding: var(--ui-compact-padding-y, 6rpx) var(--ui-compact-padding-x, 14rpx);
  text-align: center;
  border-radius: var(--ui-control-radius, 28rpx);
  font-size: var(--ui-type-label); font-weight: 700;
}

/* ═══ Rules tabs — underline style ═══ */
.rules-tabs {
  display: flex;
  border-bottom: 1rpx solid rgba(226, 232, 240, 0.8);
  margin: 0 0 18rpx;
}

.rules-tab {
  flex: 1; text-align: center;
  min-height: var(--ui-tab-min-height, 66rpx);
  padding: var(--ui-tab-padding-y, 14rpx) var(--ui-tab-padding-x, 18rpx);
  font-size: var(--ui-tab-font-size, 24rpx); color: #53687f;
  border-bottom: 3rpx solid transparent;
  font-weight: 600;
  transition: color 0.2s ease, background 0.2s ease, border-color 0.2s ease, box-shadow 0.24s ease, transform 0.2s ease;
  background: transparent; border-radius: 0;
  box-shadow: none;
  min-height: auto;
}

.rules-tab.active {
  color: #2563eb;
  border-bottom-color: #2563eb;
  font-weight: 700;
  background: transparent;
  box-shadow: none;
}

/* ═══ Flow editor ═══ */
.flow-info-bar {
  display: flex; justify-content: space-between; align-items: center;
  padding: 12rpx 18rpx; margin-bottom: 12rpx; border-radius: 16rpx;
  background: rgba(219, 234, 254, 0.42); border: 1rpx solid rgba(147, 197, 253, 0.3);
}

.flow-info-text { font-size: var(--ui-type-emphasis); font-weight: 600; color: #2563eb; }

.rule-org-context {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  margin-bottom: 18rpx;
  padding: 18rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, rgba(239, 246, 255, 0.94), rgba(255, 255, 255, 0.84));
  border: 1rpx solid rgba(147, 197, 253, 0.52);
  box-shadow: 0 10rpx 22rpx rgba(37, 99, 235, 0.07), inset 0 1rpx 0 rgba(255, 255, 255, 0.88);
}

.rule-org-context-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 54rpx;
  height: 54rpx;
  flex-shrink: 0;
  border-radius: 17rpx;
  background: rgba(219, 234, 254, 0.82);
}

.rule-org-context-copy {
  flex: 1;
  min-width: 0;
}

.rule-org-context-title {
  color: #0f172a;
  font-size: var(--ui-type-body);
  font-weight: 800;
  line-height: 1.45;
  overflow-wrap: anywhere;
}

.rule-org-context-desc {
  margin-top: 5rpx;
  color: #2563eb;
  font-size: var(--ui-type-meta);
  line-height: 1.55;
}

.rule-org-context-desc-warn {
  color: #c2410c;
}

.flow-step-card {
  padding: 20rpx; margin-bottom: 14rpx; border-radius: 20rpx;
}

.flow-step-card--editor { padding: 18rpx; }

.flow-step-head {
  display: grid;
  grid-template-columns: auto minmax(0, 1fr);
  align-items: start;
  gap: 10rpx 12rpx;
  margin-bottom: 10rpx;
}

.flow-step-badge {
  font-size: var(--ui-type-meta); font-weight: 700; color: #fff;
  background: linear-gradient(135deg, #2563eb 0%, #60a5fa 100%);
  padding: 4rpx 14rpx; border-radius: 12rpx;
}

.flow-step-name { min-width: 0; font-size: var(--ui-type-emphasis); font-weight: 700; line-height: 1.45; margin-bottom: 0; overflow-wrap: anywhere; }

.flow-step-actions { grid-column: 2; display: flex; flex-wrap: wrap; gap: 8rpx; min-width: 0; }

.flow-step-rules-summary { grid-column: 1 / -1; min-width: 0; padding: 10rpx 0 0; border-top: 1rpx solid rgba(226,237,247,0.78); }

.flow-rule-tag {
  display: block; margin: 0 0 8rpx; padding: 8rpx 10rpx;
  border-radius: 12rpx; background: rgba(239,246,255,0.72);
  border: 1rpx solid rgba(191,219,254,0.72); color: #64748b;
}
.flow-rule-tag:last-child { margin-bottom: 0; }
.flow-rule-pill-row { display: flex; flex-wrap: wrap; align-items: center; gap: 8rpx; min-width: 0; }
.flow-rule-pill {
  display: inline-flex; align-items: center; min-height: 34rpx; padding: 4rpx 10rpx;
  border-radius: var(--ui-compact-radius, 18rpx); color: var(--ui-blue-700);
  background: rgba(219,234,254,0.82); border: 1rpx solid rgba(147,197,253,0.56);
  font-size: var(--ui-type-meta); line-height: 1.35; overflow-wrap: anywhere;
}

.flow-rule-detail {
  margin: 0 0 14rpx; padding: 12rpx 14rpx;
  border-radius: 14rpx; background: rgba(239,246,255,0.62);
  border: 1rpx solid rgba(191,219,254,0.72);
}
.flow-rule-detail-title {
  margin-bottom: 8rpx; color: #475569;
  font-size: var(--ui-type-meta); font-weight: 700; line-height: 1.4;
}

.flow-rule-card {
  display: flex; justify-content: space-between; align-items: flex-start; gap: 12rpx;
  padding: 12rpx 14rpx; margin-bottom: 10rpx; border-radius: 16rpx;
}

.flow-rule-card:last-child { margin-bottom: 0; }
.flow-rule-summary { flex: 1; min-width: 0; font-size: var(--ui-type-meta); }
.flow-rule-card .inline-actions { flex: 0 0 auto; flex-wrap: wrap; justify-content: flex-end; }

.rule-edit-box {
  margin: 0;
  padding: var(--ui-dialog-section-padding, 22rpx);
  border-radius: var(--ui-dialog-section-radius, 22rpx);
}

.rule-editor-popup { width: 92vw; max-width: 760rpx; }
.rule-editor-viewport-limit {
  position: absolute; top: 0; left: 0; width: 1rpx; height: calc(100vh - var(--ui-dialog-height-inset, 72rpx) - env(safe-area-inset-top) - env(safe-area-inset-bottom));
  visibility: hidden; pointer-events: none;
}
.rule-editor-header-copy { flex: 1; min-width: 0; }
.rule-editor-header-note { margin-top: 5rpx; color: #64748b; font-size: var(--ui-type-meta); line-height: 1.5; }
.rule-editor-scroll { height: auto; min-height: 0; }
.ui-overlay .ui-dialog-shell.rule-editor-popup {
  height: auto !important;
  min-height: 0;
  max-height: calc(100vh - var(--ui-dialog-height-inset, 72rpx) - env(safe-area-inset-top) - env(safe-area-inset-bottom)) !important;
}
.ui-overlay .ui-dialog-shell.rule-editor-popup > scroll-view.rule-editor-scroll.ui-dialog-body {
  flex: 0 0 auto !important;
  height: auto !important;
  min-height: 0 !important;
  max-height: none !important;
}
.ui-overlay .ui-dialog-shell.rule-editor-popup > .rule-save-bar.ui-dialog-footer {
  flex: 0 0 auto !important;
  min-height: 0;
}
.rule-editor-stack { padding: 0; }
.activity-period-mode-list { display: flex; flex-direction: column; gap: 10rpx; }
.activity-period-mode-option { display: flex; align-items: center; gap: 14rpx; min-height: 74rpx; padding: 12rpx 14rpx; border: 1rpx solid rgba(191, 219, 254, 0.72); border-radius: 16rpx; background: rgba(248, 251, 255, 0.84); }
.activity-period-mode-option.active { border-color: rgba(37, 99, 235, 0.72); background: linear-gradient(135deg, rgba(239, 246, 255, 0.98), rgba(219, 234, 254, 0.78)); box-shadow: 0 8rpx 20rpx rgba(37, 99, 235, 0.1); }
.activity-period-check { display: flex; align-items: center; justify-content: center; flex: 0 0 auto; width: 34rpx; height: 34rpx; border: 2rpx solid #94a3b8; border-radius: 8rpx; color: #fff; font-size: var(--ui-type-control); font-weight: 700; }
.activity-period-mode-option.active .activity-period-check { border-color: #2563eb; background: #2563eb; }
.activity-period-mode-copy { display: flex; flex-direction: column; gap: 3rpx; min-width: 0; }
.activity-period-mode-title { color: #1e3a8a; font-size: var(--ui-type-control); font-weight: 700; line-height: 1.35; }
.activity-period-mode-note { color: #64748b; font-size: var(--ui-type-meta); line-height: 1.4; }
.rule-editor-section-head { display: flex; align-items: baseline; justify-content: space-between; gap: 12rpx; margin-bottom: 12rpx; }
.rule-editor-section-note { flex: 1; min-width: 0; color: #64748b; font-size: var(--ui-type-meta); line-height: 1.45; text-align: right; overflow-wrap: anywhere; }
.rule-condition-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12rpx; }
.rule-condition-field { min-width: 0; margin-bottom: 0; }
.rule-condition-field--full { grid-column: 1 / -1; }
.rule-condition-field .picker-display { min-height: var(--ui-field-control-height, 82rpx); padding: 0 14rpx; font-size: var(--ui-type-control); line-height: 1.45; overflow-wrap: anywhere; }
.rule-condition-field .picker-value { min-height: var(--ui-field-control-height, 82rpx); padding: 12rpx 14rpx; font-size: var(--ui-type-control); line-height: 1.45; overflow-wrap: anywhere; }
.rule-condition-field .field-label { margin-bottom: 6rpx; }
.rule-save-bar { flex: 0 0 auto; margin: 0; }
.rule-save-bar button { width: 100%; margin: 0; }

.booking-setting-option {
  margin-bottom: 16rpx;
}

.booking-setting-option .picker-display {
  margin-top: 12rpx;
}

.booking-setting-footer {
  gap: 0;
}

.booking-window-value-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 10rpx;
}

.booking-window-number {
  flex: 0 0 180rpx;
  width: 180rpx;
  min-height: 68rpx;
  box-sizing: border-box;
}

.booking-window-unit {
  color: #475569;
  font-size: var(--ui-type-control);
  font-weight: 700;
}

.flow-step-card--editor {
  border: 1rpx solid rgba(191, 219, 254, 0.72);
  background: linear-gradient(145deg, rgba(255, 255, 255, 0.96), rgba(239, 246, 255, 0.62));
  box-shadow: 0 10rpx 24rpx rgba(37, 99, 235, 0.06);
}

.flow-step-rules-summary {
  padding-top: 12rpx;
  border-top-color: rgba(191, 219, 254, 0.72);
}

.flow-step-admin-note {
  display: block;
  color: #475569;
  font-size: var(--ui-type-control);
  font-weight: 700;
  line-height: 1.45;
}

.flow-condition-preview {
  margin-bottom: 10rpx;
  padding: 10rpx 12rpx;
  border-left: 5rpx solid rgba(59, 130, 246, 0.76);
  border-radius: 12rpx;
  background: rgba(239, 246, 255, 0.68);
}

.flow-condition-preview:last-child { margin-bottom: 0; }
.flow-condition-preview-label { color: #64748b; font-size: var(--ui-type-caption); font-weight: 700; }
.flow-condition-preview-values { display: flex; flex-direction: column; gap: 6rpx; margin-top: 8rpx; }
.flow-condition-preview-field,
.flow-rule-card-line { display: flex; align-items: flex-start; gap: 10rpx; min-width: 0; }
.flow-condition-preview-key,
.flow-rule-card-key { flex: 0 0 72rpx; color: #64748b; font-size: var(--ui-type-caption); font-weight: 700; line-height: 1.55; }
.flow-condition-preview-value,
.flow-rule-card-value { flex: 1; min-width: 0; color: #1e293b; font-size: var(--ui-type-control); line-height: 1.55; overflow-wrap: anywhere; }

.flow-rule-card {
  align-items: flex-start;
  border: 1rpx solid rgba(226, 237, 247, 0.96);
  background: rgba(248, 251, 255, 0.82);
}

.flow-rule-card-label { color: #64748b; font-size: var(--ui-type-caption); font-weight: 700; }
.flow-rule-card-lines { display: flex; flex-direction: column; gap: 6rpx; margin-top: 8rpx; }
.flow-rule-card-line { padding: 5rpx 8rpx; border-radius: 10rpx; background: rgba(239, 246, 255, 0.58); }
.flow-rule-card-key { flex-basis: 72rpx; }

.rule-condition-list { display: flex; flex-direction: column; gap: 10rpx; }
.condition-option-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  padding: 12rpx 14rpx;
  border: 1rpx solid rgba(226, 237, 247, 0.96);
  border-radius: 14rpx;
  background: rgba(255, 255, 255, 0.78);
}
.condition-option-copy { flex: 1; min-width: 0; }
.condition-option-title { color: #0f172a; font-size: var(--ui-type-label); font-weight: 800; line-height: 1.4; }
.condition-option-hint { margin-top: 3rpx; color: #94a3b8; font-size: var(--ui-type-caption); line-height: 1.4; }
.condition-option-row picker { flex: 0 0 220rpx; min-width: 0; }
.condition-option-picker {
  min-height: 62rpx;
  padding: 0 12rpx;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  color: #2563eb;
  font-size: var(--ui-type-meta);
  font-weight: 700;
  text-align: right;
  overflow-wrap: anywhere;
}
.condition-selected-row { display: flex; align-items: center; gap: 10rpx; padding: 0 4rpx; }
.condition-selected-row .picker-value { flex: 1; min-width: 0; }

.rule-add-btn { margin-top: 6rpx; margin-bottom: 6rpx; }
.flow-add-step-btn { margin-bottom: 12rpx; }
.flow-add-rule-btn { margin-top: 10rpx; }

.section-title-sm {
  font-size: var(--ui-type-emphasis); font-weight: 700; color: #334155; margin-bottom: 10rpx;
  padding-left: 0;
}

.section-title-sm::before { display: none; }

.field-hint-sm { font-size: var(--ui-type-meta); color: #94a3b8; font-weight: 400; }

.flow-divider {
  height: 1rpx; margin: 20rpx 0 16rpx;
  background: linear-gradient(90deg, transparent, rgba(148, 163, 184, 0.25), transparent);
}

/* Multi-chip box */
.multi-chip-box {
  margin: 6rpx 0 10rpx; padding: 10rpx; border-radius: 16rpx;
  background: rgba(248, 250, 252, 0.7); border: 1rpx solid rgba(203, 213, 225, 0.35);
}

.multi-chip-scroll { max-height: 240rpx; }

.selected-hint {
  font-size: var(--ui-type-meta); color: #2563eb; font-weight: 600; margin-top: 6rpx; text-align: right;
}

/* ═══ Popup mask & header ═══ */
.popup-mask {
  position: fixed; inset: 0; z-index: 98;
  display: flex; align-items: center; justify-content: center;
  background: rgba(15, 23, 42, 0.34);
  backdrop-filter: blur(6rpx);
}

.popup-card {
  border-radius: 28rpx;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.95), rgba(248, 251, 255, 0.90));
  border: 1rpx solid rgba(255, 255, 255, 0.82);
  box-shadow: 0 22rpx 44rpx rgba(15, 23, 42, 0.14), inset 0 1rpx 0 rgba(255, 255, 255, 0.78);
}

.popup-header {
  display: flex; align-items: center; justify-content: space-between;
  gap: var(--ui-dialog-section-gap, 20rpx);
}

.popup-title {
  margin: 0; color: #0f172a;
  font-size: var(--ui-type-dialog); font-weight: 700;
  line-height: 1.42; flex: 1; min-width: 0;
}

.popup-close {
  color: #64748b; font-size: var(--ui-type-control); font-weight: 600;
  padding: 8rpx 20rpx; border-radius: 999rpx;
  background: rgba(241, 245, 249, 0.85);
  border: 1rpx solid rgba(203, 213, 225, 0.5);
}

.popup-scroll {
  width: 100%;
  max-height: 65vh;
  box-sizing: border-box;
}

/* Venue add/edit popup */
.venue-edit-popup {
  width: 88vw;
  max-height: 84vh;
  overflow: hidden;
}

.venue-edit-popup .popup-header {
  align-items: flex-start;
  border-bottom: 1rpx solid rgba(226, 237, 247, 0.72);
}

.popup-subtitle {
  margin-top: 6rpx;
  color: #64748b;
  font-size: var(--ui-type-label);
  line-height: 1.55;
}

.venue-edit-scroll {
  max-height: 52vh;
}

.venue-edit-popup .field:last-child {
  margin-bottom: 0;
}

.venue-edit-actions {
  display: flex;
  gap: var(--ui-inline-gap, 10rpx);
  margin: 0;
}

.venue-edit-actions button {
  flex: 1;
  margin: 0;
}

/* ═══ Detail popup ═══ */
.detail-title {
  margin-bottom: 16rpx;
  color: #0f172a;
  font-size: var(--ui-type-section);
  font-weight: 700;
  line-height: 1.45;
  overflow-wrap: anywhere;
}

.detail-row {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  padding: 9rpx 0;
  color: #334155;
  font-size: var(--ui-type-emphasis);
  line-height: 1.62;
}

.detail-key {
  width: 120rpx;
  flex-shrink: 0;
  color: #94a3b8;
  line-height: 1.62;
}

.detail-val {
  flex: 1;
  min-width: 0;
  color: #1e293b;
  line-height: 1.62;
  white-space: pre-wrap;
  overflow-wrap: anywhere;
}

.button-row.ui-dialog-footer {
  padding: var(--ui-dialog-footer-gap, 20rpx) 0 0;
}

/* ═══ Timetable ═══ */
.schedule-nav {
  display: flex; align-items: center; justify-content: center; gap: 28rpx;
  padding: 8rpx 16rpx 16rpx;
}

.nav-arrow {
  font-size: var(--ui-type-page); padding: 6rpx 22rpx; border-radius: 20rpx; font-weight: 300; color: #2563eb;
  background: rgba(255, 255, 255, 0.85); border: 1rpx solid rgba(59, 130, 246, 0.20);
}

.nav-label { font-size: var(--ui-type-emphasis); font-weight: 700; color: #1e293b; }

.timetable-popup { max-height: 95vh; width: 96vw; }
.timetable-scroll { width: 100%; height: 68vh; min-height: 520rpx; max-height: 760rpx; }
.timetable-body { display: flex; }

.tt-time-col { width: 64rpx; min-width: 64rpx; flex-shrink: 0; }

.tt-time-header {
  height: 58rpx; display: flex; align-items: center; justify-content: center;
  font-size: var(--ui-type-caption); font-weight: 700; color: #475569; background: #f1f5f9;
  border-bottom: 1rpx solid rgba(226, 232, 240, 0.6); box-sizing: border-box;
}

.tt-time-label {
  height: 64rpx; display: flex; align-items: center; justify-content: center;
  font-size: var(--ui-type-micro); color: #64748b; border-bottom: 1rpx solid rgba(226, 232, 240, 0.3);
  background: #f8fafc; box-sizing: border-box;
}

.tt-col-scroll { flex: 1; overflow-x: visible; }
.tt-cols-row { display: flex; min-width: 700rpx; }

.tt-col { flex: 0 0 100rpx; min-width: 100rpx; position: relative; }

.tt-col-header {
  height: 58rpx; display: flex; flex-direction: column; align-items: center; justify-content: center;
  font-size: var(--ui-type-meta); font-weight: 600; color: #475569; background: #f1f5f9;
  border-right: 1rpx solid rgba(226, 232, 240, 0.4); border-bottom: 1rpx solid rgba(226, 232, 240, 0.6);
  position: sticky; top: 0; z-index: 1; padding: 2rpx 0; box-sizing: border-box;
}

.tt-col-sub { font-size: var(--ui-type-micro); font-weight: 400; color: #64748b; display: block; }

.tt-open-block {
  position: absolute; left: 2rpx; right: 2rpx; background: rgba(219, 234, 254, 0.38);
  border-radius: 6rpx; border: 1rpx dashed rgba(147, 197, 253, 0.40);
}

.tt-time-target { position: absolute; left: 0; right: 0; z-index: 1; opacity: 0; }

.tt-event-block {
  position: absolute; left: 3rpx; right: 3rpx;
  display: flex; align-items: center; justify-content: center;
  border-radius: 7rpx; overflow: hidden; z-index: 2;
}

.tt-event-block.booked { background: rgba(254, 243, 199, 0.78); border: 1rpx solid rgba(252, 211, 77, 0.50); }
.tt-event-block.pending { background: rgba(254, 215, 170, 0.72); border: 1rpx solid rgba(253, 186, 116, 0.45); }
.tt-event-block.activity { background: rgba(252, 231, 243, 0.65); border: 1rpx solid rgba(249, 168, 212, 0.45); }

.tt-event-label {
  font-size: var(--ui-type-micro); color: #475569; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  max-width: 90rpx; text-align: center; line-height: 1.1;
}

.tt-legend { display: flex; gap: 16rpx; padding: 12rpx 18rpx; font-size: var(--ui-type-caption); color: #64748b; flex-wrap: wrap; }
.tt-leg-item { display: flex; align-items: center; gap: 6rpx; }
.tt-dot { width: 22rpx; height: 22rpx; border-radius: 6rpx; flex-shrink: 0; }
.tt-dot.open { background: rgba(209,250,229,0.94); border: 1rpx solid rgba(110,231,183,0.62); }
.tt-dot.booked { background: rgba(254,215,170,0.94); border: 1rpx solid rgba(253,186,116,0.66); }
.tt-dot.pending { background: rgba(224,242,254,0.94); border: 1rpx solid rgba(56,189,248,0.60); }
.tt-dot.activity { background: rgba(219,234,254,0.94); border: 1rpx solid rgba(147,197,253,0.66); }
.tt-dot.closed { background: #e2e8f0; border: 1rpx solid #cbd5e1; }

/* ═══ Department tabs (multi-picker) ═══ */
.dept-tab-scroll { margin: 0 0 var(--ui-inline-gap, 10rpx); }
.dept-tab-scroll-view { width: 100%; white-space: nowrap; }
.dept-tab-row { display: inline-flex; gap: 8rpx; }

.dept-tab {
  display: inline-flex; align-items: center; gap: 4rpx; flex-shrink: 0;
  font-size: var(--ui-type-meta); padding: 10rpx 18rpx; border-radius: var(--ui-compact-radius, 18rpx); font-weight: 600;
  background: rgba(241, 245, 249, 0.85); color: #475569;
  border: 1rpx solid rgba(203, 213, 225, 0.55);
  transition: color 0.2s ease, background 0.2s ease, border-color 0.2s ease, box-shadow 0.24s ease, transform 0.2s ease;
}

.dept-tab-active {
  background: linear-gradient(135deg, #2563eb 0%, #3b82f6 100%);
  color: #fff; border-color: transparent;
  box-shadow: 0 6rpx 16rpx rgba(37, 99, 235, 0.20);
}

@media (min-width: 520px) {
  .page {
    max-width: 760px;
  }

  .rule-org-context {
    gap: 12px;
    margin-bottom: 16px;
    padding: 15px;
    border-radius: 16px;
  }

  .rule-org-context-icon {
    width: 42px;
    height: 42px;
    border-radius: 13px;
  }

  .rule-org-context-title {
    font-size: var(--ui-type-body);
  }

  .rule-org-context-desc {
    margin-top: 4px;
    font-size: var(--ui-type-meta);
  }

  .timetable-popup {
    width: calc(100vw - 48px);
    width: min(920px, calc(100vw - 48px));
  }

  .timetable-scroll {
    height: calc(90vh - 190px);
    min-height: 420px;
    max-height: 720px;
  }

  .tt-time-col {
    width: 56px;
    min-width: 56px;
  }

  .tt-cols-row {
    min-width: 504px;
  }

  .tt-col {
    flex: 0 0 72px;
    min-width: 72px;
  }

  .tt-time-header,
  .tt-time-label,
  .tt-col-header,
  .tt-col-sub,
  .tt-event-label,
  .tt-legend {
    font-size: var(--ui-type-caption);
  }

  .inner-scroll,
  .large-scroll {
    max-height: 65vh !important;
  }
}

@media (min-width: 900px) {
  .page {
    display: block;
    max-width: 1180px;
  }

  .page > .hero,
  .page > .workspace-hero-host,
  .page > .page-footer {
    width: 100%;
  }

  .page > .workspace-hero-host {
    margin-bottom: 0;
  }

  .page > .tabs {
    position: static;
    z-index: 24;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: var(--ui-tab-gap);
    padding: var(--ui-tab-shell-padding);
    margin-bottom: 14px;
    border-radius: var(--ui-tab-shell-radius);
  }

  .page > .tabs .tab {
    width: 100%;
    min-height: var(--ui-tab-min-height);
    justify-content: center;
    padding: var(--ui-tab-padding-y) var(--ui-tab-padding-x);
    border-bottom: 0;
    border-radius: var(--ui-tab-radius);
    text-align: center;
  }

  .page > .section-host {
    min-width: 0;
    margin-bottom: 0;
  }
}

.dept-tab-count { font-size: var(--ui-type-caption); opacity: 0.85; }

/* ═══ Rule filter row ═══ */
.rule-filter-row {
  display: flex; gap: 12rpx;
}

.rule-filter-field {
  min-width: 0;
}

/* ═══ Field half layout ═══ */
.field-half {
  flex: 1; min-width: 0;
}

/* ═══ Misc ═══ */
.required { color: #ef4444; }

.field {
  margin-bottom: var(--ui-field-gap, 16rpx);
}

.detail-body > .field--approval-comment {
  margin-top: var(--ui-action-gap, 20rpx);
}

/* ═══ Flow info (audit-style timeline inside booking cards / popups) ═══ */
.flow-info-title { font-size: var(--ui-type-meta); font-weight: 700; color: #0f172a; line-height: 1.4; }
.flow-info-desc {
  margin-top: 4rpx;
  color: #64748b;
  font-size: var(--ui-type-caption);
  line-height: 1.6;
  overflow-wrap: anywhere;
}

/* ═══ Page footer ═══ */
.page-footer {
  display: flex; flex-direction: column; align-items: center;
  padding: 0; margin: 0;
  color: #7b8ba3; font-size: var(--ui-type-control);
  line-height: 1.8; letter-spacing: 2rpx;
}

.page-footer .footer-name { font-size: var(--ui-type-caption); color: #8b9bb5; letter-spacing: 4rpx; }
.page-footer .footer-org { font-size: var(--ui-type-emphasis); font-weight: 600; color: #506380; }

/* Admin venue final polish: glass segmented tabs and timetable surfaces */
.rules-tabs {
  gap: var(--ui-tab-gap, 8rpx);
  margin: 0 0 var(--ui-dialog-section-gap, 20rpx);
  padding: var(--ui-tab-shell-padding, 8rpx);
  border-radius: var(--ui-tab-shell-radius, 26rpx);
  border-bottom: none;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.72), rgba(248, 251, 255, 0.56));
  border: 1rpx solid rgba(255, 255, 255, 0.62);
  box-shadow:
    0 14rpx 28rpx rgba(15, 23, 42, 0.045),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.78);
}

.rules-tab {
  min-height: var(--ui-tab-min-height, 66rpx);
  padding: var(--ui-tab-padding-y, 14rpx) var(--ui-tab-padding-x, 18rpx);
  border-radius: var(--ui-tab-radius, 20rpx);
  border-bottom: none;
  display: flex;
  align-items: center;
  justify-content: center;
}

.rules-tab.active {
  color: #ffffff;
  background: linear-gradient(135deg, #2563eb 0%, #3b82f6 58%, #60a5fa 100%);
  box-shadow: 0 16rpx 30rpx rgba(37, 99, 235, 0.22);
  border-bottom-color: transparent;
}

.rule-switch-row,
.rule-empty,
.multi-chip-box,
.flow-info-bar,
.rule-template-row,
.merit-summary-filter-value,
.picker-sm {
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.88), rgba(248, 251, 255, 0.76));
  border-color: rgba(226, 237, 247, 0.82);
  box-shadow:
    0 8rpx 18rpx rgba(15, 23, 42, 0.03),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.76);
}

.tt-time-header,
.tt-col-header,
.tt-time-label {
  background: linear-gradient(135deg, rgba(248, 251, 255, 0.95), rgba(239, 246, 255, 0.84));
  border-color: rgba(226, 237, 247, 0.76);
}

.tt-open-block {
  background: linear-gradient(135deg, rgba(219, 234, 254, 0.42), rgba(239, 246, 255, 0.34));
  border-radius: 10rpx;
}

.tt-event-block {
  border-radius: 10rpx;
  box-shadow:
    0 5rpx 12rpx rgba(15, 23, 42, 0.04),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.54);
}

.tt-event-block.booked {
  background: linear-gradient(135deg, rgba(255, 247, 237, 0.88), rgba(254, 215, 170, 0.76));
}

.tt-event-block.pending {
  background: linear-gradient(135deg, rgba(255, 237, 213, 0.88), rgba(253, 186, 116, 0.72));
}

.tt-event-block.activity {
  background: linear-gradient(135deg, rgba(219, 234, 254, 0.88), rgba(191, 219, 254, 0.74));
  border-color: rgba(147, 197, 253, 0.46);
}

.tt-dot {
  border-radius: 999rpx;
  box-shadow:
    0 5rpx 12rpx rgba(15, 23, 42, 0.035),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.56);
}

.tt-dot.open { background: linear-gradient(135deg, #dbeafe, #bfdbfe); }
.tt-dot.booked { background: linear-gradient(135deg, #fff7ed, #fed7aa); }
.tt-dot.pending { background: linear-gradient(135deg, #ffedd5, #fdba74); }
.tt-dot.activity { background: linear-gradient(135deg, #dbeafe, #93c5fd); border-color: #93c5fd; }
.tt-dot.closed { background: linear-gradient(135deg, #f8fafc, #e2e8f0); }

/* Popup close is plain text plus x, not a pill button. */
.popup-close {
  display: inline-flex !important;
  align-items: center !important;
  gap: 8rpx !important;
  padding: 4rpx 0 4rpx 16rpx !important;
  border: 0 !important;
  background: transparent !important;
  box-shadow: none !important;
  color: #475569 !important;
  font-size: var(--ui-type-control) !important;
  font-weight: 700 !important;
}

.popup-close::before { display: none !important; content: none !important; }
.popup-close::after { content: "×" !important; color: #2563eb !important; font-size: var(--ui-type-value) !important; font-weight: 800 !important; line-height: 1 !important; }
.context-switch-guard-card {
  padding: 26rpx;
  text-align: center;
}

.context-switch-guard-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 68rpx;
  height: 68rpx;
  margin: 0 auto 17rpx;
  border: 1rpx solid rgba(147, 197, 253, 0.62);
  border-radius: 20rpx;
  background: linear-gradient(135deg, rgba(219, 234, 254, 0.94), rgba(239, 246, 255, 0.82));
}

.context-switch-guard-title {
  color: #0f172a;
  font-size: var(--ui-type-dialog);
  font-weight: 800;
  line-height: 1.45;
}

.context-switch-guard-desc {
  margin-top: 10rpx;
  color: #64748b;
  font-size: var(--ui-type-body);
  line-height: 1.65;
}

.context-switch-guard-actions {
  margin-top: 0;
  padding: 0;
  border: 0;
  background: transparent;
}

.context-switch-guard-actions button {
  width: 100%;
}

@media (min-width: 520px) {
  .context-switch-guard-card { padding: 24px 26px; }
  .context-switch-guard-icon {
    width: 50px;
    height: 50px;
    margin-bottom: 13px;
    border-radius: 14px;
  }
  .context-switch-guard-desc { margin-top: 8px; }
}

.flow-meta-card {
  cursor: default;
}

.flow-meta-card-active {
  border-color: rgba(96, 165, 250, 0.72);
  box-shadow: 0 10rpx 24rpx rgba(37, 99, 235, 0.08), inset 0 1rpx 0 rgba(255, 255, 255, 0.82);
}

.flow-switch-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx 20rpx;
  margin-top: 10rpx;
}

.flow-switch-item {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.flow-switch-label {
  font-size: var(--ui-type-caption);
  color: #475569;
}

.flow-switch-item switch {
  transform: scale(0.8);
  transform-origin: left center;
}
