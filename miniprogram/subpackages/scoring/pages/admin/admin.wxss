}

.hr-import-preview-note {
  border: 1rpx solid rgba(147, 197, 253, 0.55);
  background: rgba(239, 246, 255, 0.88);
  color: #2563eb;
}

.hr-import-preview-section {
  margin-top: 22rpx;
}

.hr-import-preview-heading {
  margin-bottom: 12rpx;
  color: #0f172a;
  font-size: var(--ui-type-body);
  font-weight: 750;
}

.hr-import-preview-mapping {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
  gap: 12rpx;
  align-items: center;
  padding: 14rpx 16rpx;
  border-bottom: 1rpx solid rgba(226, 232, 240, 0.9);
  color: #334155;
  font-size: var(--ui-type-label);
  line-height: 1.5;
}

.hr-import-preview-column,
.hr-import-preview-target {
  min-width: 0;
  overflow-wrap: anywhere;
}

.hr-import-preview-arrow { color: #60a5fa; }

.hr-import-preview-target {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  color: #2563eb;
  font-weight: 700;
}

.hr-import-preview-type {
  color: #94a3b8;
  font-size: var(--ui-type-micro);
  font-weight: 500;
}

.hr-import-preview-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.hr-import-preview-chip {
  max-width: 100%;
  padding: 7rpx 13rpx;
  border: 1rpx solid rgba(147, 197, 253, 0.58);
  border-radius: var(--ui-compact-radius, 18rpx);
  background: rgba(239, 246, 255, 0.88);
  color: #2563eb;
  font-size: var(--ui-type-caption);
  line-height: 1.45;
  overflow-wrap: anywhere;
  box-sizing: border-box;
}

.hr-import-preview-chip.is-muted {
  border-color: rgba(203, 213, 225, 0.7);
  background: rgba(248, 250, 252, 0.9);
  color: #64748b;
}

.hr-import-preview-dict-row {
  padding: 12rpx 0;
  border-bottom: 1rpx solid rgba(226, 232, 240, 0.75);
}

.hr-import-preview-dict-label {
  display: block;
  margin-bottom: 10rpx;
  color: #334155;
  font-size: var(--ui-type-label);
  font-weight: 700;
}

.hr-import-preview-empty {
  color: #94a3b8;
  font-size: var(--ui-type-meta);
}

.hr-import-preview-card button[disabled] {
  opacity: 0.46;
}

.validation-errors-card {
  width: 700rpx;
  max-height: 85vh;
}

.validation-errors-summary {
  font-size: var(--ui-type-emphasis);
  color: #ef4444;
  padding: 0 28rpx 16rpx 28rpx;
  font-weight: 500;
}

.validation-errors-body {
  max-height: 52vh;
  padding: 0 24rpx;
}

/* Validation error cards — matching hr-member-card design */
.validation-error-card {
  padding: 24rpx;
  margin-bottom: 14rpx;
  border-radius: 22rpx;
  background: linear-gradient(135deg, rgba(255,255,255,0.92) 0%, rgba(254,250,250,0.82) 100%);
  border: 1rpx solid rgba(254,226,226,0.8);
  box-shadow: 0 12rpx 24rpx rgba(15,23,42,0.04), inset 0 1rpx 0 rgba(255,255,255,0.78);
}

.ve-card-top {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  margin-bottom: 14rpx;
  padding-bottom: 12rpx;
  border-bottom: 1rpx solid #fef2f2;
}

.ve-card-name {
  font-size: var(--ui-type-section);
  font-weight: 700;
  color: #0f172a;
}

.ve-card-sid {
  font-size: var(--ui-type-label);
  color: #64748b;
  font-weight: 500;
}

.ve-card-errors {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.ve-error-item {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  padding: 10rpx 14rpx;
  background: #fffbfb;
  border-radius: 12rpx;
  border: 1rpx solid #fee2e2;
}

.ve-error-label {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.ve-error-field {
  font-size: var(--ui-type-body);
  font-weight: 600;
  color: #1e293b;
}

.ve-error-type-tag {
  display: inline-block;
  font-size: var(--ui-type-caption);
  padding: 2rpx 10rpx;
  border-radius: var(--ui-compact-radius, 18rpx);
  background: #eff6ff;
  color: #2563eb;
}

.ve-error-detail {
  font-size: var(--ui-type-label);
  color: #64748b;
  line-height: 1.5;
}

.ve-error-reason {
  color: #dc2626;
  font-weight: 500;
}

.ve-error-value {
  display: block;
  margin-top: 2rpx;
  color: #94a3b8;
  font-size: var(--ui-type-meta);
}

.picker-placeholder {
  padding: 20rpx 24rpx;
  border-radius: 24rpx;
  background: #f8fafc;
  border: 1rpx dashed #cbd5e1;
  font-size: var(--ui-type-value);
  color: #94a3b8;
}

/* Publications tab — minimal additions using existing rules-tab patterns */
.popup-footer { display: flex; align-items: center; justify-content: space-between; padding: 20rpx 28rpx; border-top: 1rpx solid rgba(226,237,247,0.92); }
.popup-footer-info { font-size: var(--ui-type-emphasis); color: #64748b; }

/* Designation popup */
.desig-popup-card {
  max-height: 88vh;
  padding: 28rpx 28rpx 24rpx;
}
.desig-popup-card .button-row { margin-top: 16rpx; }
.desig-popup-card .ui-dialog-footer { margin-top: 0; }

.desig-inner-scroll { margin-bottom: 8rpx; border-radius: 20rpx; background: rgba(248,250,252,0.6); border: 1rpx solid rgba(226,232,240,0.7); padding: 8rpx; box-sizing: border-box; }
.desig-current-scroll { height: 300rpx; }
.desig-candidate-scroll { height: 520rpx; }
.desig-current-item { background: rgba(255,255,255,0.85); }
.popup-scroll { max-height: 58vh; }
.popup-scroll .button-row button {
  min-height: 76rpx;
  height: auto;
  line-height: 1.35;
  font-size: var(--ui-type-value);
  padding: 14rpx 24rpx;
}

/* ── Card-based overview result list (matches user-side "结果公示" style) ── */

@keyframes glassFadeUp {
  from { opacity: 0; transform: translateY(18rpx); }
  to   { opacity: 1; transform: translateY(0); }
}

.ranked-list {
  display: flex; flex-direction: column; gap: 16rpx;
  padding-bottom: 8rpx;
}

.rank-card {
  display: flex; align-items: center; gap: 14rpx;
  padding: 20rpx 20rpx 20rpx 16rpx; border-radius: 24rpx;
  background: linear-gradient(135deg, rgba(255,255,255,0.90) 0%, rgba(248,251,255,0.82) 100%);
  border: 1rpx solid rgba(226,237,247,0.94);
  box-shadow: 0 10rpx 24rpx rgba(15,23,42,0.035), inset 0 1rpx 0 rgba(255,255,255,0.78);
  backdrop-filter: blur(20rpx); -webkit-backdrop-filter: blur(20rpx);
  box-sizing: border-box;
  transition: transform 0.20s ease, box-shadow 0.24s ease;
  animation: glassFadeUp 0.36s ease both;
}
.rank-card:active {
  transform: translateY(2rpx) scale(0.992);
  box-shadow: 0 6rpx 16rpx rgba(15,23,42,0.05);
}

/* Score-tier card tints */
.rank-card-gold {
  border-color: rgba(251,191,36,0.55);
  box-shadow: 0 14rpx 28rpx rgba(245,158,11,0.10), inset 0 1rpx 0 rgba(255,255,255,0.78), 0 0 36rpx rgba(251,191,36,0.06);
  background: linear-gradient(135deg, rgba(255,252,245,0.94) 0%, rgba(254,249,235,0.86) 100%);
}
.rank-card-silver {
  border-color: rgba(203,213,225,0.60);
  box-shadow: 0 14rpx 28rpx rgba(148,163,184,0.08), inset 0 1rpx 0 rgba(255,255,255,0.78), 0 0 32rpx rgba(203,213,225,0.06);
  background: linear-gradient(135deg, rgba(252,252,253,0.94) 0%, rgba(246,248,252,0.86) 100%);
}
.rank-card-bronze {
  border-color: rgba(251,191,36,0.35);
  box-shadow: 0 14rpx 28rpx rgba(217,119,6,0.07), inset 0 1rpx 0 rgba(255,255,255,0.78), 0 0 30rpx rgba(245,158,11,0.04);
  background: linear-gradient(135deg, rgba(255,251,247,0.94) 0%, rgba(254,246,235,0.86) 100%);
}

/* Rank badge */
.rank-badge {
  flex-shrink: 0; width: 60rpx; height: 60rpx; border-radius: 18rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: var(--ui-type-emphasis); font-weight: 800; line-height: 1;
  box-shadow: 0 8rpx 18rpx rgba(15,23,42,0.06);
}
.rank-badge-gold {
  background: linear-gradient(135deg, #fbbf24 0%, #f59e0b 60%, #d97706 100%);
  font-size: var(--ui-type-dialog); color: #ffffff;
  box-shadow: 0 8rpx 20rpx rgba(245,158,11,0.28);
}
.rank-badge-silver {
  background: linear-gradient(135deg, #e2e8f0 0%, #cbd5e1 60%, #94a3b8 100%);
  font-size: var(--ui-type-dialog); color: #ffffff;
  box-shadow: 0 8rpx 20rpx rgba(148,163,184,0.22);
}
.rank-badge-bronze {
  background: linear-gradient(135deg, #fcd34d 0%, #f59e0b 60%, #b45309 100%);
  font-size: var(--ui-type-dialog); color: #ffffff;
  box-shadow: 0 8rpx 20rpx rgba(217,119,6,0.22);
}
.rank-badge-normal {
  background: linear-gradient(135deg, rgba(239,246,255,0.96) 0%, rgba(219,234,254,0.88) 100%);
  color: #2563eb; border: 1rpx solid rgba(147,197,253,0.55);
}

/* Member info */
.member-info {
  flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 4rpx;
}
.member-name {
  color: #0f172a; font-size: var(--ui-type-value); font-weight: 700; line-height: 1.4;
  word-break: break-word;
}
.member-detail {
  color: #64748b; font-size: var(--ui-type-meta); line-height: 1.5; word-break: break-word;
}

/* Score display */
.score-display {
  flex-shrink: 0; display: flex; flex-direction: column; align-items: flex-end;
  min-width: 120rpx; padding-left: 8rpx;
}
.score-value {
  color: #2563eb; font-size: var(--ui-type-dialog); font-weight: 800; line-height: 1.2;
  letter-spacing: 0; white-space: nowrap;
  font-variant-numeric: tabular-nums;
}
.score-label {
  color: #94a3b8; font-size: var(--ui-type-caption); font-weight: 500; line-height: 1.4;
  margin-top: 2rpx;
}

/* Inline progress bar (inside card) */
.progress-row {
  display: flex; align-items: center; gap: 10rpx; margin-top: 6rpx;
}
.progress-row .progress-track {
  flex: 1; max-width: 200rpx; height: 8rpx; border-radius: 8rpx;
  background: rgba(226,232,240,0.75); overflow: hidden;
}
.progress-row .progress-fill {
  height: 100%; border-radius: 8rpx;
}
.progress-row .progress-nums {
  font-size: var(--ui-type-caption); color: #94a3b8; white-space: nowrap;
}

/* ─── Grade Band Bubbles (Feature 4) ─── */
.grade-band-card {
  transition: background 0.2s ease, border-color 0.2s ease, box-shadow 0.24s ease, transform 0.2s ease;
}
.grade-band-collapsed {
  display: flex; align-items: center; padding: 0 32rpx 24rpx; cursor: pointer;
}
.grade-band-bubble {
  display: inline-flex; align-items: center; justify-content: center;
  padding: 14rpx 28rpx; border-radius: var(--ui-compact-radius, 18rpx);
  box-shadow: 0 4rpx 16rpx rgba(15,23,42,0.10), inset 0 1rpx 0 rgba(255,255,255,0.22);
}
.grade-band-bubble-name {
  color: #fff; font-size: var(--ui-type-emphasis); font-weight: 600;
  white-space: nowrap;
}

/* ─── Merit Summary (Feature 5) — redesigned to match project card language ─── */
.merit-summary-panel {
  background: transparent; border: none; box-shadow: none; padding: 0;
}
.merit-summary-head-bar {
  display: flex; align-items: center; justify-content: space-between;
  margin-top: 16rpx;
}
.merit-export-btn-wrap {
  flex-shrink: 0; width: 320rpx;
}
.merit-export-btn-wrap .secondary-btn {
  width: 100%; min-width: 0; padding: 0; font-size: var(--ui-type-meta);
}
.merit-summary-total-chip {
  font-size: var(--ui-type-meta); font-weight: 600; color: #64748b;
  padding: 8rpx 18rpx; border-radius: var(--ui-compact-radius, 18rpx);
  background: rgba(255,255,255,0.64);
  border: 1rpx solid rgba(148,163,184,0.20);
}
.merit-summary-filter-bar {
  display: flex; gap: 18rpx; padding: 18rpx 24rpx; margin-bottom: 22rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, rgba(255,255,255,0.78) 0%, rgba(248,251,255,0.72) 100%);
  border: 1rpx solid rgba(255,255,255,0.65);
  box-shadow: 0 8rpx 22rpx rgba(15,23,42,0.04), inset 0 1rpx 0 rgba(255,255,255,0.72);
}
.merit-summary-filter-field {
  display: flex; align-items: center; gap: 10rpx;
}
.merit-summary-filter-label {
  font-size: var(--ui-type-meta); font-weight: 600; color: #64748b; white-space: nowrap;
}
.merit-summary-filter-value {
  font-size: var(--ui-type-label); color: #163047; padding: 8rpx 16rpx;
  border-radius: 14rpx;
  background: rgba(255,255,255,0.82);
  border: 1rpx solid rgba(148,163,184,0.25);
  min-width: 88rpx; text-align: center;
}
.glass-empty {
  background: linear-gradient(135deg, rgba(255,255,255,0.68) 0%, rgba(248,251,255,0.62) 100%);
  border-radius: 24rpx; border: 1rpx solid rgba(255,255,255,0.55);
  display: flex; flex-direction: column; align-items: center;
  padding: 48rpx 30rpx; text-align: center;
}
.merit-summary-panel .glass-empty .empty-title,
.merit-summary-panel .glass-empty .empty-desc {
  width: 100%;
  margin-left: auto;
  margin-right: auto;
  text-align: center;
}

/* ── Group card (matches .list-item / .rule-clause-card pattern) ── */
.merit-group-card {
  margin-bottom: 20rpx; border-radius: 22rpx;
  background: linear-gradient(135deg, rgba(255,255,255,0.92) 0%, rgba(249,251,255,0.82) 100%);
  border: 1rpx solid rgba(226,237,247,0.96);
  box-shadow: 0 12rpx 24rpx rgba(15,23,42,0.04), inset 0 1rpx 0 rgba(255,255,255,0.78);
  overflow: hidden;
}

/* ── Group header ── */
.merit-group-head {
  display: flex; align-items: center; gap: 0;
  padding: 22rpx 24rpx;
  transition: background 0.18s ease;
}
.merit-group-head:active {
  background: rgba(241,245,249,0.28);
}
.merit-group-head-accent {
  width: 6rpx; height: 52rpx; border-radius: 999rpx;
  flex-shrink: 0; margin-right: 18rpx;
  opacity: 0.82;
}
.merit-group-head-body {
  flex: 1; min-width: 0;
}
.merit-group-head-title {
  line-height: 1.4;
}
.merit-title-dept {
  font-weight: 600; color: #475569; font-size: var(--ui-type-value);
}
.merit-group-head-meta {
  display: flex; align-items: center; gap: 10rpx; margin-top: 8rpx;
}

/* ── Colorful accent chips (matches .preview-chip style) ── */
.merit-chip {
  display: inline-flex; align-items: center; justify-content: center;
  min-height: 36rpx; padding: 5rpx 14rpx; border-radius: var(--ui-compact-radius, 18rpx);
  font-size: var(--ui-type-caption); font-weight: 700; line-height: 1.35;
  border: 1rpx solid transparent;
}
.merit-chip-count {
  background: rgba(219,234,254,0.76); color: #2563eb;
  border-color: rgba(147,197,253,0.64);
}
.merit-chip-quota {
  background: rgba(255,237,213,0.78); color: #c2410c;
  border-color: rgba(253,186,116,0.58);
}
.merit-chip-ident {
  background: rgba(209,250,229,0.78); color: #15803d;
  border-color: rgba(110,231,183,0.58);
}

/* ── Chevron circle ── */
.merit-group-chevron {
  width: 44rpx; height: 44rpx; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0; margin-left: 10rpx;
  background: rgba(241,245,249,0.65);
  border: 1rpx solid rgba(148,163,184,0.18);
  transition: background 0.2s ease, border-color 0.2s ease;
}
.merit-group-chevron text {
  font-size: var(--ui-type-micro); color: #64748b;
  transition: transform 0.24s ease;
}
.merit-group-chevron-open {
  background: rgba(219,234,254,0.64);
  border-color: rgba(147,197,253,0.38);
}
.merit-group-chevron-open text {
  color: #2563eb;
}

/* ── Group body (expanded member list) ── */
.merit-group-body {
  padding: 0 16rpx 18rpx;
}

/* ── Member card ── */
.merit-member-card {
  display: flex; align-items: center; gap: 0;
  margin: 0 4rpx 8rpx; padding: 16rpx 18rpx;
  border-radius: 18rpx;
  background: linear-gradient(135deg, rgba(255,255,255,0.90) 0%, rgba(241,245,249,0.78) 100%);
  border: 1rpx solid rgba(226,232,240,0.65);
  box-shadow: 0 4rpx 12rpx rgba(15,23,42,0.03);
}
.merit-member-accent {
  width: 5rpx; height: 42rpx; border-radius: 999rpx;
  flex-shrink: 0; margin-right: 16rpx;
  opacity: 0.58;
}
.merit-member-body {
  flex: 1; min-width: 0;
}

/* ── Member top row: name (left) + student ID chip (right) ── */
.merit-member-row {
  display: flex; align-items: center; justify-content: space-between;
}
.merit-member-name {
  font-size: var(--ui-type-value); font-weight: 700; color: #1e293b; line-height: 1.35;
}
.merit-member-sid-chip {
  display: inline-flex; align-items: center; justify-content: center;
  padding: 4rpx 16rpx; border-radius: var(--ui-compact-radius, 18rpx); flex-shrink: 0; margin-left: 14rpx;
  background: rgba(241,245,249,0.72);
  border: 1rpx solid rgba(148,163,184,0.16);
}
.merit-member-sid-chip text {
  font-size: var(--ui-type-caption); font-weight: 600; color: #64748b; line-height: 1.5;
  font-family: -apple-system, "Helvetica Neue", "SF Pro Text", "Segoe UI", Roboto, sans-serif;
  letter-spacing: 0.8rpx;
}

/* ── Member tag row (colorful bubbles matching .preview-chip style) ── */
.merit-member-tags {
  display: flex; flex-wrap: wrap; gap: 8rpx; margin-top: 8rpx;
}
.merit-tag {
  display: inline-flex; align-items: center; justify-content: center;
  min-height: 34rpx; padding: 4rpx 12rpx; border-radius: var(--ui-compact-radius, 18rpx);
  font-size: var(--ui-type-micro); font-weight: 600; line-height: 1.35;
  border: 1rpx solid transparent;
}
.merit-tag-ident {
  background: rgba(219,234,254,0.76); color: #2563eb;
  border-color: rgba(147,197,253,0.64);
}
.merit-tag-dept {
  background: rgba(207,250,254,0.72); color: #0891b2;
  border-color: rgba(103,232,249,0.48);
}
.merit-tag-wg {
  background: rgba(209,250,229,0.78); color: #059669;
  border-color: rgba(110,231,183,0.58);
}

/* ── Portal back button ── */
.actions {
  margin-top: 8rpx;
  padding-bottom: 12rpx;
}
.actions button {
  position: relative;
  overflow: hidden;
  height: 94rpx;
  line-height: 94rpx;
  margin-bottom: 20rpx;
  border: none;
  border-radius: var(--ui-control-radius, 28rpx);
  font-size: var(--ui-type-value);
  font-weight: 700;
  letter-spacing: 0.5rpx;
  box-shadow: 0 16rpx 30rpx rgba(15,23,42,0.06), inset 0 1rpx 0 rgba(255,255,255,0.24);
}
.actions button::after {
  border: none;
}

/* ═══════════════════════════════════════════════════════════
   Admin Audit — glassmorphism enhancement styles
   ═══════════════════════════════════════════════════════════ */

/* ── Audit gradient status chips (replace flat green/red/blue-chip) ── */
.audit-chip {
  display: inline-flex; align-items: center; justify-content: center;
  min-height: 44rpx; padding: 8rpx 20rpx; border-radius: var(--ui-compact-radius, 18rpx);
  font-size: var(--ui-type-meta); font-weight: 700; line-height: 1.2; letter-spacing: 0.2rpx;
  border: 1rpx solid transparent;
  box-shadow: 0 6rpx 14rpx rgba(15,23,42,0.04);
}
.audit-chip-draft    { color: #64748b; background: linear-gradient(135deg, rgba(241,245,249,0.96) 0%, rgba(226,232,240,0.90) 100%); border-color: rgba(148,163,184,0.42); }
.audit-chip-pending  { color: #c2410c; background: linear-gradient(135deg, rgba(255,247,237,0.98) 0%, rgba(254,215,170,0.90) 100%); border-color: rgba(253,186,116,0.55); }
.audit-chip-progress { color: #2563eb; background: linear-gradient(135deg, rgba(219,234,254,0.98) 0%, rgba(191,219,254,0.90) 100%); border-color: rgba(147,197,253,0.55); }
.audit-chip-approved { color: #15803d; background: linear-gradient(135deg, rgba(220,252,231,0.98) 0%, rgba(187,247,208,0.90) 100%); border-color: rgba(134,239,172,0.52); }
.audit-chip-rejected { color: #dc2626; background: linear-gradient(135deg, rgba(254,242,242,0.98) 0%, rgba(254,226,226,0.90) 100%); border-color: rgba(252,165,165,0.50); }
.audit-chip-withdrawn{ color: #9a3412; background: linear-gradient(135deg, rgba(255,247,237,0.96) 0%, rgba(254,215,170,0.84) 100%); border-color: rgba(253,186,116,0.46); }

/* Override the old flat chips globally for audit tabs */
.green-chip, .blue-chip, .red-chip {
  min-height: 44rpx !important; padding: 8rpx 20rpx !important;
  border-radius: var(--ui-compact-radius, 18rpx) !important; font-size: var(--ui-type-meta) !important; font-weight: 700 !important;
  border: 1rpx solid transparent !important;
  box-shadow: 0 6rpx 14rpx rgba(15,23,42,0.04) !important;
}
.green-chip { color: #15803d !important; background: linear-gradient(135deg, rgba(220,252,231,0.98) 0%, rgba(187,247,208,0.90) 100%) !important; border-color: rgba(134,239,172,0.52) !important; }
.blue-chip  { color: #2563eb !important; background: linear-gradient(135deg, rgba(219,234,254,0.98) 0%, rgba(191,219,254,0.90) 100%) !important; border-color: rgba(147,197,253,0.55) !important; }
.red-chip   { color: #dc2626 !important; background: linear-gradient(135deg, rgba(254,242,242,0.98) 0%, rgba(254,226,226,0.90) 100%) !important; border-color: rgba(252,165,165,0.50) !important; }
.gray-chip  { color: #64748b !important; background: linear-gradient(135deg, rgba(241,245,249,0.96) 0%, rgba(226,232,240,0.90) 100%) !important; border-color: rgba(148,163,184,0.42) !important; }
.orange-chip{ color: #c2410c !important; background: linear-gradient(135deg, rgba(255,247,237,0.98) 0%, rgba(254,215,170,0.90) 100%) !important; border-color: rgba(253,186,116,0.55) !important; }

/* ── Audit condition bubble chips (scope tags in template editor) ── */
.info-chip {
  display: inline-flex !important; align-items: center; justify-content: center;
  min-height: 40rpx !important; padding: 6rpx 16rpx !important; border-radius: var(--ui-compact-radius, 18rpx) !important;
  font-size: var(--ui-type-caption) !important; font-weight: 700 !important; line-height: 1.3 !important;
  border: 1rpx solid transparent !important;
  background: linear-gradient(135deg, rgba(239,246,255,0.96) 0%, rgba(219,234,254,0.88) 100%) !important;
  color: #2563eb !important; border-color: rgba(147,197,253,0.55) !important;
  box-shadow: 0 4rpx 10rpx rgba(37,99,235,0.06) !important;
}

/* ── Audit template list items (expanded/collapsible) ── */
.audit-template-list-item {
  flex-direction: column !important;
  padding: 22rpx 20rpx !important;
  border-radius: 22rpx !important;
  margin-bottom: 12rpx !important;
  background: linear-gradient(135deg, rgba(255,255,255,0.90) 0%, rgba(248,251,255,0.80) 100%) !important;
  border: 1rpx solid rgba(226,237,247,0.90) !important;
  box-shadow: 0 10rpx 24rpx rgba(15,23,42,0.035), inset 0 1rpx 0 rgba(255,255,255,0.76) !important;
  transition: transform 0.18s ease, box-shadow 0.22s ease !important;
}
.audit-template-list-item:active { transform: translateY(1rpx) scale(0.992) !important; }
.audit-template-list-item:last-child { margin-bottom: 4rpx !important; }

/* ── Audit template expanded preview ── */
.audit-template-expanded {
  width: 100%; margin-top: 14rpx; padding-top: 14rpx;
  border-top: 1rpx solid rgba(226,232,240,0.7);
}
.audit-template-step-preview {
  margin-bottom: 12rpx; padding: 16rpx 18rpx; border-radius: 16rpx;
  background: linear-gradient(135deg, rgba(248,251,255,0.88) 0%, rgba(241,245,249,0.76) 100%);
  border: 1rpx solid rgba(226,232,240,0.55);
}
.audit-template-step-preview:last-child { margin-bottom: 0; }
.audit-template-step-head {
  display: flex; align-items: center; margin-bottom: 6rpx;
}

/* ── Condition bubble chips in expanded template preview ── */
.audit-cond-chip {
  display: inline-flex; align-items: center; justify-content: center;
  min-height: 36rpx; padding: 4rpx 14rpx; border-radius: var(--ui-compact-radius, 18rpx);
  font-size: var(--ui-type-caption); font-weight: 700; line-height: 1.3;
  border: 1rpx solid transparent; margin: 2rpx;
  box-shadow: 0 3rpx 8rpx rgba(15,23,42,0.03);
}
.audit-cond-dept  { background: linear-gradient(135deg, rgba(219,234,254,0.94) 0%, rgba(191,219,254,0.84) 100%); color: #2563eb; border-color: rgba(147,197,253,0.48); }
.audit-cond-wg    { background: linear-gradient(135deg, rgba(220,252,231,0.94) 0%, rgba(187,247,208,0.84) 100%); color: #15803d; border-color: rgba(134,239,172,0.48); }
.audit-cond-ident { background: linear-gradient(135deg, rgba(255,247,237,0.96) 0%, rgba(254,215,170,0.86) 100%); color: #c2410c; border-color: rgba(253,186,116,0.52); }
.audit-cond-person{ background: linear-gradient(135deg, rgba(224,242,254,0.94) 0%, rgba(186,230,253,0.84) 100%); color: #0369a1; border-color: rgba(56,189,248,0.48); }
.audit-cond-none   { background: linear-gradient(135deg, rgba(254,242,242,0.92) 0%, rgba(254,226,226,0.80) 100%); color: #dc2626; border-color: rgba(252,165,165,0.45); }

/* ── OR separator text ── */
.audit-or-sep {
  color: #ef4444; font-size: var(--ui-type-caption); font-weight: 700; margin: 2rpx 8rpx;
}

/* ── Audit progress detail popup (submission detail view) ── */
.audit-progress-header {
  padding: 20rpx 18rpx; margin-bottom: 16rpx; border-radius: 20rpx;
  background: linear-gradient(135deg, rgba(255,255,255,0.86) 0%, rgba(246,249,255,0.76) 100%);
  border: 1rpx solid rgba(226,237,247,0.84);
}
.audit-progress-step {
  padding: 20rpx 18rpx; margin-bottom: 10rpx; border-radius: 18rpx;
  background: linear-gradient(135deg, rgba(255,255,255,0.85) 0%, rgba(248,251,255,0.75) 100%);
  border: 1rpx solid rgba(226,237,247,0.84);
  box-shadow: 0 6rpx 14rpx rgba(15,23,42,0.025);
}
.audit-progress-step:last-child { margin-bottom: 0; }

/* ── Audit verification result card ── */
.audit-verify-result-card {
  margin-top: 18rpx; padding: 24rpx 22rpx; border-radius: 22rpx;
  background: linear-gradient(135deg, rgba(255,255,255,0.88) 0%, rgba(248,251,255,0.78) 100%);
  border: 1rpx solid rgba(226,237,247,0.88);
  box-shadow: 0 10rpx 24rpx rgba(15,23,42,0.04);
}
.audit-verify-result-badge {
  font-size: var(--ui-type-section); font-weight: 700; line-height: 1.4; margin-bottom: 10rpx;
}
.audit-verify-valid { color: #059669; }
.audit-verify-invalid { color: #ef4444; }

/* ── Audit stamp image preview ── */
.audit-stamp-preview {
  border-radius: 14rpx; background: #fff;
  border: 1rpx solid rgba(226,232,240,0.6);
  box-shadow: 0 4rpx 12rpx rgba(15,23,42,0.04);
  margin-top: 8rpx; margin-bottom: 12rpx;
}

/* ── Audit section sub-head ── */
.audit-section-subhead {
  margin-top: 22rpx; margin-bottom: 14rpx;
}

/* ── Template expand toggle indicator ── */
.audit-expand-toggle {
  display: flex; align-items: center; gap: 6rpx;
  padding: 6rpx 14rpx; border-radius: 999rpx;
  background: rgba(241,245,249,0.65);
  border: 1rpx solid rgba(148,163,184,0.18);
  color: #64748b; font-size: var(--ui-type-caption); font-weight: 600;
  transition: color 0.18s ease, background 0.18s ease, border-color 0.18s ease, box-shadow 0.22s ease, transform 0.18s ease;
}
.audit-expand-toggle:active {
  background: rgba(219,234,254,0.55);
  border-color: rgba(147,197,253,0.35);
  color: #2563eb;
}

/* ── File attachment item (for admin progress popup) ── */
.file-attach-item {
  display: flex; align-items: center; gap: 16rpx;
  padding: 18rpx 20rpx; margin-bottom: 8rpx; border-radius: 18rpx;
  background: linear-gradient(135deg, rgba(255,255,255,0.88) 0%, rgba(248,251,255,0.76) 100%);
  border: 1rpx solid rgba(226,237,247,0.88);
  box-shadow: 0 8rpx 18rpx rgba(15,23,42,0.03);
  box-sizing: border-box;
}
.file-attach-item:last-child { margin-bottom: 0; }
.file-attach-icon {
  flex-shrink: 0; width: 52rpx; height: 52rpx; border-radius: 14rpx;
  display: flex; align-items: center; justify-content: center;
  background: linear-gradient(135deg, rgba(219,234,254,0.94) 0%, rgba(191,219,254,0.84) 100%);
  border: 1rpx solid rgba(147,197,253,0.48);
  color: #2563eb; font-size: var(--ui-type-control); font-weight: 700;
}
.file-attach-name { flex: 1; min-width: 0; color: #0f172a; font-size: var(--ui-type-control); font-weight: 600; line-height: 1.4; }

/* ─── Admin audit submission list items (glassmorphism) ─── */
.audit-submission-admin-item {
  display: flex; align-items: center; gap: 18rpx;
  padding: 24rpx 22rpx; margin-bottom: 12rpx; border-radius: 22rpx;
  background: linear-gradient(135deg, rgba(255,255,255,0.90) 0%, rgba(248,251,255,0.80) 100%);
  border: 1rpx solid rgba(226,237,247,0.94);
  box-shadow: 0 10rpx 24rpx rgba(15,23,42,0.035), inset 0 1rpx 0 rgba(255,255,255,0.78);
  box-sizing: border-box; transition: transform 0.18s ease, box-shadow 0.22s ease;
  animation: glassFadeUp 0.36s ease both;
}
.audit-submission-admin-item:last-child { margin-bottom: 4rpx; }
.audit-submission-admin-item:active { transform: translateY(1rpx) scale(0.992); }
.audit-submission-admin-main { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 8rpx; }
.audit-submission-admin-title { color: #0f172a; font-size: var(--ui-type-value); font-weight: 700; line-height: 1.4; }
.audit-submission-admin-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 10rpx; }
.audit-submission-admin-sub { font-size: var(--ui-type-caption); color: #94a3b8; }
.audit-submission-admin-arrow {
  flex-shrink: 0; width: 48rpx; height: 48rpx; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  background: rgba(241,245,249,0.7); color: #94a3b8; font-size: var(--ui-type-dialog); font-weight: 600;
}

/* Final admin motion: prevent parent cards and popups from moving with child taps. */
.edit-box:active,
.list-card:active,
.card:active,
.section-stack:active {
  transform: none !important;
  filter: none !important;
}

.result-table-row:active,
.task-table-row:active,
.popup-table-row:active,
.question-card:active,
.rank-card:active,
.hr-member-card:active,
.audit-submission-admin-item:active {
  transform: none !important;
}

@media (min-width: 520px) {
  .audit-personnel-filter-row {
    flex-wrap: nowrap;
  }

  .audit-personnel-filter-field,
  .audit-personnel-search-field {
    flex: 1 1 0;
  }

  .admin-workbench .section-stack {
    min-width: 0;
  }

  .admin-workbench .edit-box,
  .admin-workbench .list-card {
    padding: var(--ui-card-padding-y, 18px) var(--ui-card-padding-x, 18px);
    border-radius: var(--ui-card-radius, 18px);
  }

  .field-row {
    gap: var(--ui-inline-gap, 7px);
  }

  .admin-field-grid {
    gap: 12px;
  }

  .field-value {
    padding-left: var(--ui-control-padding-x, 16px);
    font-size: var(--ui-type-emphasis);
    line-height: 1.5;
  }

  .field-label {
    padding-left: var(--ui-control-padding-x, 16px);
  }

  .dialog-btn,
  .popup-scroll .button-row button {
    min-height: 44px !important;
    height: auto !important;
    padding: 10px 16px !important;
    font-size: var(--ui-type-body) !important;
    line-height: 20px !important;
  }
}

@media (min-width: 900px) {
  .admin-workbench {
    display: block;
  }

  .admin-workbench > .tabs {
    position: static;
    z-index: 24;
    display: flex;
    flex-wrap: nowrap;
    gap: var(--ui-tab-gap);
    max-height: none;
    overflow: visible;
    padding: var(--ui-tab-shell-padding);
    margin-bottom: 14px;
    border-radius: var(--ui-tab-shell-radius);
  }

  .admin-workbench > .tabs .tab {
    flex: 1 1 0;
    min-width: 0;
    width: 0;
    min-height: var(--ui-tab-min-height);
    justify-content: center;
    padding: var(--ui-tab-padding-y) var(--ui-tab-padding-x);
    text-align: center;
    white-space: nowrap;
  }

  .admin-workbench > .section-stack {
    margin-bottom: 0;
  }

  .admin-workbench .edit-box,
  .admin-workbench .list-card {
    min-width: 0;
  }
}

.result-table-row.control-pressing,
.task-table-row.control-pressing,
.popup-table-row.control-pressing,
.question-card.control-pressing,
.rank-card.control-pressing,
.hr-member-card.control-pressing,
.audit-submission-admin-item.control-pressing {
  transform: translate3d(0, 2rpx, 0) scale(0.992) !important;
  opacity: 0.975 !important;
  filter: saturate(1.018) brightness(1.004) !important;
  transition:
    transform 0.18s cubic-bezier(0.2, 0.78, 0.22, 1),
    box-shadow 0.20s ease,
    opacity 0.18s ease,
    filter 0.20s ease !important;
}

.link:active,
.pill-link:active,
.pill-close:active,
.audit-template-list-item:active {
  transform: translate3d(0, 1rpx, 0) scale(0.984) !important;
  opacity: 0.94 !important;
  transition:
    transform 0.16s cubic-bezier(0.2, 0.78, 0.22, 1),
    opacity 0.16s ease,
    box-shadow 0.18s ease !important;
}

/* Popup close is plain text plus x, not a pill button. */
.popup-close,
.modal-close {
  display: inline-flex !important;
  align-items: center !important;
  justify-content: flex-end !important;
  gap: 8rpx !important;
  width: auto !important;
  height: auto !important;
  min-height: 0 !important;
  line-height: 1.4 !important;
  padding: 4rpx 0 4rpx 16rpx !important;
  border: 0 !important;
  border-radius: 0 !important;
  background: transparent !important;
  box-shadow: none !important;
  color: #475569 !important;
  font-size: var(--ui-type-control) !important;
  font-weight: 700 !important;
}

.popup-close::before,
.modal-close::before { display: none !important; content: none !important; }
.popup-close::after,
.modal-close::after { content: "×" !important; color: #2563eb !important; font-size: var(--ui-type-value) !important; font-weight: 800 !important; line-height: 1 !important; }

@media (min-width: 520px) {
  .rule-panel-title,
  .question-title,
  .edit-box-title,
  .list-card-title {
    font-size: var(--ui-type-section) !important;
    line-height: 1.45 !important;
  }

  .stat-value,
  .hr-member-name,
  .result-name,
  .task-name {
    font-size: var(--ui-type-emphasis) !important;
    line-height: 1.5 !important;
  }

  .csv-mapping-col,
  .question-desc,
  .rule-panel-desc,
  .result-meta,
  .task-meta {
    font-size: var(--ui-type-meta) !important;
    line-height: 1.55 !important;
  }

  .popup-close,
  .modal-close {
    min-height: 36px !important;
    padding: 8px 0 8px 14px !important;
    font-size: var(--ui-type-meta) !important;
    line-height: 20px !important;
  }

  .popup-close::after,
  .modal-close::after {
    font-size: var(--ui-type-section) !important;
  }

  .csv-mapping-card {
    width: 100%;
    max-width: 720px;
    max-height: calc(100vh - 48px);
  }

  .csv-mapping-body {
    padding: 0 20px;
  }

  .csv-mapping-row,
  .csv-mapping-row-header {
    display: grid;
    grid-template-columns:
      minmax(0, 1.1fr)
      minmax(88px, 0.65fr)
      minmax(110px, 1fr)
      minmax(180px, 1.35fr);
    gap: 12px;
    align-items: center;
    margin-bottom: 0;
    padding: 12px 14px;
    border-radius: 0;
    border: 0;
    border-bottom: 1px solid rgba(226,237,247,0.96);
    background: transparent;
    box-shadow: none;
  }

  .csv-mapping-row-header {
    position: sticky;
    top: 0;
    z-index: 2;
    margin-bottom: 4px;
    border-radius: 10px;
    background: linear-gradient(135deg, rgba(248,250,252,0.98), rgba(239,246,255,0.96));
  }

  .csv-mapping-col-csv,
  .csv-mapping-col-type,
  .csv-mapping-col-sample,
  .csv-mapping-col-target {
    grid-column: auto;
    text-align: left;
  }

  .csv-mapping-mobile-label,
  .csv-mapping-sample-hint {
    display: none;
  }

  .csv-mapping-primary-text {
    display: block;
    white-space: normal;
    overflow: visible;
    text-overflow: clip;
    overflow-wrap: anywhere;
  }

  .csv-mapping-sample-text {
    display: block;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .csv-mapping-col-target,
  .csv-mapping-col-target picker,
  .csv-mapping-picker-value {
    min-width: 180px;
  }

  .csv-mapping-picker-value {
    min-height: 42px;
    padding: 9px 12px;
    border-radius: 12px;
    font-size: var(--ui-type-label);
    line-height: 20px;
    white-space: normal;
    overflow: visible;
    text-overflow: clip;
  }

  .csv-skip-invalid-row {
    gap: 16px;
    padding: 16px 20px;
    margin-bottom: 6px;
  }

  .csv-mapping-footer {
    gap: 12px;
    padding-top: 12px;
  }

  .csv-mapping-footer button {
    min-height: 46px;
    height: 46px;
    padding: 0 18px;
    line-height: 46px;
    font-size: var(--ui-type-label);
  }

  .hr-import-preview-card {
    width: 100%;
    max-width: 720px;
    max-height: calc(100vh - 48px);
  }

  .hr-import-preview-source {
    max-width: 560px;
    font-size: var(--ui-type-meta);
  }

  .hr-import-preview-body {
    padding: 0 20px 18px;
  }

  .hr-import-preview-stats {
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 12px;
  }

  .hr-import-preview-stat {
    gap: 6px;
    padding: 14px;
    border-radius: 14px;
    font-size: var(--ui-type-meta);
  }

  .hr-import-preview-stat-value { font-size: var(--ui-type-page); }
  .hr-import-preview-heading { font-size: var(--ui-type-body); }
  .hr-import-preview-mapping { padding: 10px 12px; font-size: var(--ui-type-label); }
  .hr-import-preview-type { font-size: var(--ui-type-caption); }
  .hr-import-preview-chip { padding: 5px 10px; font-size: var(--ui-type-meta); }
  .hr-import-preview-dict-label,
  .hr-import-preview-empty { font-size: var(--ui-type-meta); }
}

@media (min-width: 900px) {
  .csv-mapping-card,
  .hr-import-preview-card {
    max-width: 860px;
  }
}

/* 管理 Hero 使用同一组织控件语言，仅调整深色表面的光影层次。 */
.hero-admin .hero-org-context {
  background: linear-gradient(135deg, rgba(96, 165, 250, 0.20), rgba(255, 255, 255, 0.08));
  border-color: rgba(191, 219, 254, 0.24);
  box-shadow: 0 12rpx 28rpx rgba(2, 6, 23, 0.16), inset 0 1rpx 0 rgba(255, 255, 255, 0.16);
}

.hero-admin .hero-org-context-pressing {
  background: linear-gradient(135deg, rgba(96, 165, 250, 0.26), rgba(255, 255, 255, 0.11));
  box-shadow: 0 6rpx 16rpx rgba(2, 6, 23, 0.13), inset 0 1rpx 0 rgba(255, 255, 255, 0.18);
}

/* 人事模板：组织快照与共享模板库 */
.hr-template-workspace,
.hr-template-current-card,
.hr-template-editor {
  margin-top: 20rpx;
}

.hr-template-editor-actions {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 14rpx;
  width: 100%;
}

.hr-template-editor-btn {
  display: block;
  box-sizing: border-box;
  width: 100%;
  min-width: 0;
  min-height: 74rpx;
  height: 74rpx;
  margin: 0;
  padding: 0 12rpx;
  border-radius: var(--ui-control-radius, 28rpx);
  font-size: var(--ui-type-meta);
  line-height: 74rpx;
  white-space: nowrap;
  overflow: hidden;
}

.hr-template-editor-save {
  grid-column: auto;
}

.hr-template-editor-btn.template-save-btn::before {
  display: none;
}

.hr-template-current-card {
  border-color: rgba(59, 130, 246, 0.22);
  background: linear-gradient(145deg, rgba(239, 246, 255, 0.90), rgba(255, 255, 255, 0.78));
}

.hr-template-empty,
.hr-switch-empty {
  padding: 28rpx;
  border: 1rpx dashed rgba(96, 165, 250, 0.42);
  border-radius: 18rpx;
  color: #475569;
  font-size: var(--ui-type-body);
  line-height: 1.7;
  background: rgba(239, 246, 255, 0.54);
}

.hr-template-source-row,
.hr-template-card-head,
.hr-switch-source-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.hr-template-card {
  padding: 26rpx;
  margin-top: 18rpx;
  border: 1rpx solid rgba(147, 197, 253, 0.25);
  border-radius: 22rpx;
  background: linear-gradient(145deg, rgba(255, 255, 255, 0.84), rgba(239, 246, 255, 0.72));
  box-shadow: 0 14rpx 36rpx rgba(15, 23, 42, 0.07), inset 0 1rpx 0 rgba(255, 255, 255, 0.90);
}

.hr-template-card-name {
  color: #1e3a8a;
  font-size: var(--ui-type-section);
  font-weight: 700;
  line-height: 1.4;
}

.hr-template-meta,
.hr-template-description,
.hr-switch-suggestion {
  margin-top: 8rpx;
  color: #64748b;
  font-size: var(--ui-type-label);
  line-height: 1.55;
}

.hr-template-description {
  padding: 18rpx 0 4rpx;
  color: #475569;
}

.hr-template-actions {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
  margin-top: 20rpx;
}

.hr-template-action {
  display: block;
  box-sizing: border-box;
  width: 100%;
  max-width: 100%;
  min-width: 0;
  min-height: 74rpx;
  height: 74rpx;
  padding: 0 16rpx;
  margin: 0;
  border: 1rpx solid rgba(147, 197, 253, 0.72);
  border-radius: var(--ui-control-radius, 28rpx);
  color: #2563eb;
  font-size: var(--ui-type-meta);
  font-weight: 700;
  line-height: 74rpx;
  white-space: nowrap;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.96), rgba(239, 246, 255, 0.90));
  box-shadow:
    0 12rpx 24rpx rgba(37, 99, 235, 0.09),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.84);
  overflow: hidden;
}

.hr-template-action::after {
  border: 0;
}

.hr-template-action-primary {
  color: #ffffff;
  border-color: rgba(59, 130, 246, 0.72);
  background: linear-gradient(135deg, #2563eb 0%, #3b82f6 58%, #60a5fa 100%);
  box-shadow:
    0 16rpx 32rpx rgba(29, 78, 216, 0.20),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.20);
}

.hr-template-action-danger {
  color: #ffffff;
  border-color: rgba(248, 113, 113, 0.72);
  background: linear-gradient(135deg, #ef4444 0%, #f87171 100%);
  box-shadow:
    0 16rpx 30rpx rgba(239, 68, 68, 0.16),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.18);
}

.hr-snapshot-fields {
  margin: 20rpx 0 24rpx;
  padding: 18rpx;
  border: 1rpx solid rgba(191, 219, 254, 0.72);
  border-radius: 18rpx;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.82), rgba(239, 246, 255, 0.62));
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.88);
}

.hr-snapshot-fields-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 12rpx;
}

.hr-snapshot-fields-title {
  color: #1e3a8a;
  font-size: var(--ui-type-body);
  font-weight: 700;
}

.hr-snapshot-field {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 16rpx 12rpx;
  border-top: 1rpx solid rgba(219, 234, 254, 0.82);
}

.hr-snapshot-field-order {
  display: flex;
  flex: 0 0 40rpx;
  align-items: center;
  justify-content: center;
  width: 40rpx;
  height: 40rpx;
  border-radius: 10rpx;
  color: #2563eb;
  font-size: var(--ui-type-caption);
  font-weight: 700;
  background: rgba(219, 234, 254, 0.76);
}

.hr-snapshot-field-main {
  flex: 1;
  min-width: 0;
}

.hr-snapshot-field-name {
  color: #1e293b;
  font-size: var(--ui-type-body);
  font-weight: 600;
  line-height: 1.4;
}

.hr-snapshot-field-rule {
  margin-top: 4rpx;
  color: #64748b;
  font-size: var(--ui-type-caption);
  line-height: 1.45;
  overflow-wrap: anywhere;
}

.hr-snapshot-field-tags {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  gap: 8rpx;
}

.hr-snapshot-type-tag,
.hr-snapshot-required-tag {
  padding: 6rpx 10rpx;
  border-radius: var(--ui-compact-radius, 18rpx);
  font-size: var(--ui-type-caption);
  font-weight: 700;
  line-height: 1.2;
}

.hr-snapshot-type-tag {
  color: #2563eb;
  border: 1rpx solid rgba(147, 197, 253, 0.64);
  background: rgba(219, 234, 254, 0.76);
}

.hr-snapshot-required-tag {
  color: #c2410c;
  border: 1rpx solid rgba(253, 186, 116, 0.58);
  background: rgba(255, 237, 213, 0.78);
}

.hr-template-add-btn {
  display: block;
  flex: 0 0 auto;
  box-sizing: border-box;
  width: auto;
  min-width: 176rpx;
  min-height: 72rpx;
  height: 72rpx;
  margin: 0;
  padding: 0 22rpx;
  border-radius: var(--ui-control-radius, 28rpx);
  font-size: var(--ui-type-meta);
  line-height: 72rpx;
  white-space: nowrap;
}

.hr-template-library-header,
.hr-member-list-header {
  align-items: center;
  gap: 18rpx;
}

.hr-profile-export-btn {
  flex: 0 0 auto;
  width: auto;
  min-width: 220rpx;
  min-height: 72rpx;
  height: 72rpx;
  margin: 0 0 0 auto;
  padding: 0 22rpx;
  border-radius: var(--ui-control-radius, 28rpx);
  font-size: var(--ui-type-label);
  line-height: 72rpx;
  white-space: nowrap;
  justify-self: end;
}

.hr-template-library-header .hr-template-add-btn {
  margin-left: auto;
}

.hr-template-action,
.hr-template-editor-btn,
.hr-template-add-btn,
.hr-profile-export-btn {
  text-align: center;
}

.hr-template-action::after,
.hr-template-editor-btn::after,
.hr-template-add-btn::after,
.hr-profile-export-btn::after {
  border: 0;
}

.hr-member-profile-summary {
  display: -webkit-box;
  margin-top: 8rpx;
  overflow: hidden;
  color: #475569;
  font-size: var(--ui-type-meta);
  line-height: 1.55;
  overflow-wrap: anywhere;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.hr-member-profile-pending {
  color: #c2410c;
}

.hr-template-switch-modal {
  width: calc(100vw - 48rpx);
  max-width: 1080rpx;
  max-height: 1200rpx;
}

.hr-template-switch-body {
  flex: 1;
  min-height: 0;
  padding: 8rpx 0 12rpx;
}

.hr-switch-source {
  padding: 24rpx;
  margin-top: 18rpx;
  border: 1rpx solid rgba(147, 197, 253, 0.26);
  border-radius: 20rpx;
  background: rgba(248, 250, 252, 0.78);
}

.hr-switch-suggestion {
