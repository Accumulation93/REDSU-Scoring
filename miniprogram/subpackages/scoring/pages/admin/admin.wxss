/* CSV mapping dialog */
.csv-mapping-card {
  display: flex;
  flex-direction: column;
  width: 680rpx;
  max-height: 80vh;
  overflow: hidden;
}

.csv-mapping-card .modal-header {
  flex: 0 0 auto;
}

.csv-mapping-body {
  flex: 1 1 auto;
  min-height: 0;
  max-height: none;
  padding: 0 4rpx;
  box-sizing: border-box;
}
.csv-mapping-tip {
  font-size: var(--ui-type-control);
  color: #64748b;
  margin-bottom: 20rpx;
  line-height: 1.5;
}
.csv-mapping-row {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  gap: 18rpx 16rpx;
  align-items: start;
  margin-bottom: 16rpx;
  padding: 20rpx;
  border-radius: 22rpx;
  background: linear-gradient(135deg, rgba(255,255,255,0.96), rgba(239,246,255,0.82));
  border: 1rpx solid rgba(191,219,254,0.62);
  box-shadow: 0 10rpx 22rpx rgba(15,23,42,0.04), inset 0 1rpx 0 rgba(255,255,255,0.86);
  box-sizing: border-box;
}
.csv-mapping-row-header {
  display: none;
  background: linear-gradient(135deg, rgba(248,250,252,0.94), rgba(239,246,255,0.82));
  font-weight: 600;
  font-size: var(--ui-type-control);
  color: #64748b;
  border-radius: 8rpx;
  padding: 12rpx 16rpx;
  margin-bottom: 4rpx;
}
.csv-mapping-col {
  min-width: 0;
  font-size: var(--ui-type-emphasis);
  color: #1e293b;
  box-sizing: border-box;
}
.csv-mapping-col-csv { grid-column: 1; }
.csv-mapping-col-type { grid-column: 2; text-align: right; }
.csv-mapping-col-sample { grid-column: 1 / -1; color: #64748b; font-size: var(--ui-type-control); }
.csv-mapping-col-target { grid-column: 1 / -1; min-width: 0; }
.csv-mapping-col-target picker { display: block; width: 100%; }
.csv-mapping-mobile-label {
  display: block;
  margin-bottom: 8rpx;
  color: #64748b;
  font-size: var(--ui-type-caption);
  font-weight: 700;
  line-height: 1.35;
}
.csv-mapping-primary-text {
  display: block;
  color: #0f172a;
  font-size: var(--ui-type-value);
  font-weight: 750;
  line-height: 1.5;
  overflow-wrap: anywhere;
}
.csv-mapping-sample-text {
  display: -webkit-box;
  overflow: hidden;
  color: #64748b;
  line-height: 1.55;
  text-overflow: ellipsis;
  overflow-wrap: anywhere;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}
.csv-mapping-sample-hint {
  display: block;
  margin-top: 6rpx;
  color: #2563eb;
  font-size: var(--ui-type-caption);
  font-weight: 700;
}
.csv-mapping-type-tag {
  display: inline-block;
  font-size: var(--ui-type-meta);
  padding: 2rpx 12rpx;
  border-radius: var(--ui-compact-radius, 18rpx);
  background: #eff6ff;
  color: #2563eb;
}
.csv-mapping-picker-value {
  display: flex;
  align-items: center;
  width: 100%;
  min-height: 72rpx;
  padding: 14rpx 18rpx;
  border: 1rpx solid rgba(147,197,253,0.78);
  border-radius: 16rpx;
  font-size: var(--ui-type-body);
  line-height: 1.45;
  font-weight: 700;
  color: #1e293b;
  background: linear-gradient(135deg, rgba(255,255,255,0.98), rgba(239,246,255,0.90));
  white-space: normal;
  overflow: visible;
  text-overflow: clip;
  overflow-wrap: anywhere;
  box-sizing: border-box;
}

.csv-skip-invalid-row {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 20rpx 28rpx;
