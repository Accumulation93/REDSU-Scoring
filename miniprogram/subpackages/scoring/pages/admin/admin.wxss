  color: #94a3b8;
  margin-top: 4rpx;
}

.csv-mapping-scroll-hint {
  flex: 0 0 auto;
}

.csv-mapping-footer {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding-top: 14rpx;
  padding-bottom: 0;
  box-sizing: border-box;
}

.csv-mapping-footer button {
  flex: 1 1 0;
  min-width: 0;
  min-height: 76rpx;
  height: 76rpx;
