  box-sizing: border-box;
}

.modal-card {
  width: 100%;
  max-height: 80vh;
  padding: 28rpx;
  border-radius: 30rpx;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.96) 0%, rgba(248, 251, 255, 0.94) 100%);
  border: 1rpx solid rgba(255, 255, 255, 0.72);
  box-shadow: 0 28rpx 60rpx rgba(15, 23, 42, 0.16);
