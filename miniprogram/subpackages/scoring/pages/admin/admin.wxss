@import '../../../main/styles/home.wxss';

page {
  min-height: 100%;
  background:
    radial-gradient(circle at 12% 10%, rgba(96, 165, 250, 0.16) 0%, transparent 26%),
    radial-gradient(circle at 86% 18%, rgba(191, 219, 254, 0.22) 0%, transparent 24%),
    radial-gradient(circle at 18% 88%, rgba(125, 211, 252, 0.10) 0%, transparent 22%),
    linear-gradient(135deg, #f8fbff 0%, #f1f6fc 48%, #edf3fa 100%);
  color: #1f2a37;
  font-family: "PingFang SC", "Microsoft YaHei", sans-serif;
}

button,
input,
textarea,
picker,
view,
text,
scroll-view {
  font-family: "PingFang SC", "HarmonyOS Sans SC", "Microsoft YaHei", sans-serif;
}

.page {
  position: relative;
  min-height: 100vh;
  padding: var(--ui-page-padding-top, 30rpx) var(--ui-page-padding-x, 24rpx) calc(var(--ui-page-padding-bottom, 42rpx) + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.page::before {
  content: "";
  position: fixed;
  top: -120rpx;
  right: -90rpx;
  width: 320rpx;
  height: 320rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(96, 165, 250, 0.18) 0%, rgba(96, 165, 250, 0) 72%);
  pointer-events: none;
}

.page::after {
  content: "";
  position: fixed;
  left: -120rpx;
  bottom: 150rpx;
  width: 280rpx;
  height: 280rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(147, 197, 253, 0.16) 0%, rgba(147, 197, 253, 0) 72%);
  pointer-events: none;
}

.hero {
  position: relative;
  overflow: hidden;
  margin-bottom: 28rpx;
  padding: 42rpx 34rpx 38rpx;
  border-radius: 38rpx;
  background:
    linear-gradient(135deg, rgba(37, 99, 235, 0.98) 0%, rgba(59, 130, 246, 0.95) 42%, rgba(96, 165, 250, 0.90) 100%),
    linear-gradient(180deg, rgba(255, 255, 255, 0.10), rgba(255, 255, 255, 0));
  border: 1rpx solid rgba(255, 255, 255, 0.24);
  box-shadow:
    0 24rpx 54rpx rgba(37, 99, 235, 0.22),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.24);
  animation: glassFadeUp 0.42s ease both;
}

.hero-admin {
  padding: 40rpx 34rpx 36rpx;
  border-radius: 34rpx;
  background:
    linear-gradient(135deg, rgba(15, 23, 42, 0.96) 0%, rgba(30, 41, 59, 0.96) 42%, rgba(37, 99, 235, 0.92) 100%);
  box-shadow:
    0 26rpx 54rpx rgba(15, 23, 42, 0.22),
    0 0 28rpx rgba(37, 99, 235, 0.08),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.14);
}

.hero-admin::before {
  top: -130rpx;
  right: -56rpx;
  width: 280rpx;
  height: 280rpx;
  background: radial-gradient(circle, rgba(96, 165, 250, 0.30) 0%, rgba(96, 165, 250, 0.06) 46%, rgba(96, 165, 250, 0) 72%);
}

.hero-admin::after {
  content: "";
  position: absolute;
  left: 34rpx;
  right: 34rpx;
  bottom: 20rpx;
  height: 1rpx;
  background: linear-gradient(90deg, rgba(255, 255, 255, 0.16) 0%, rgba(191, 219, 254, 0.34) 52%, rgba(255, 255, 255, 0) 100%);
}

.hero-admin .hero-badge {
  background: linear-gradient(135deg, rgba(59, 130, 246, 0.24) 0%, rgba(148, 163, 184, 0.14) 100%);
  border-color: rgba(191, 219, 254, 0.26);
  box-shadow: 0 10rpx 26rpx rgba(15, 23, 42, 0.12);
}

.hero-admin .hero-title {
  font-size: var(--ui-type-page);
  letter-spacing: 0.8rpx;
}

.hero-admin .hero-subtitle {
  color: rgba(241, 245, 249, 0.90);
}

.hero-admin-subtitle {
  margin-top: 16rpx;
  color: #ffffff;
  font-size: var(--ui-type-section);
  font-weight: 700;
  line-height: 1.55;
  letter-spacing: 0.4rpx;
}

.tab {
  color: #49627f;
}

.tab-active {
  color: #ffffff;
  background: linear-gradient(135deg, #2563eb 0%, #3b82f6 58%, #60a5fa 100%);
  box-shadow: 0 16rpx 30rpx rgba(37, 99, 235, 0.22);
}

/* Department tabs inside multi-picker */
.dept-tab-scroll { margin: 0 24rpx 12rpx; }
.dept-tab-scroll-view { width: 100%; white-space: nowrap; }
.dept-tab-row { display: inline-flex; gap: 8rpx; }
.dept-tab {
  display: inline-flex; align-items: center; gap: 4rpx; flex-shrink: 0;
  font-size: var(--ui-type-meta); padding: 10rpx 18rpx; border-radius: var(--ui-compact-radius, 18rpx); font-weight: 600;
  background: rgba(241, 245, 249, 0.85); color: #475569;
  border: 1rpx solid rgba(203, 213, 225, 0.55);
  transition: color 0.2s ease, background 0.2s ease, border-color 0.2s ease, box-shadow 0.24s ease, transform 0.2s ease;
}
.dept-tab-active {
  background: linear-gradient(135deg, #2563eb 0%, #3b82f6 100%);
  color: #fff; border-color: transparent;
  box-shadow: 0 6rpx 16rpx rgba(37, 99, 235, 0.20);
}
.dept-tab-count { font-size: var(--ui-type-caption); opacity: 0.85; }

.section-title,
.list-title {
  color: #10233d;
}

.field-label {
  color: #52647c;
}

.field-input,
.picker-value,
.field-textarea {
  border: 1rpx solid rgba(203, 213, 225, 0.82);
  box-shadow:
    inset 0 1rpx 0 rgba(255, 255, 255, 0.82),
    0 8rpx 18rpx rgba(15, 23, 42, 0.035);
}

.field-input:focus,
.field-textarea:focus {
  border-color: rgba(59, 130, 246, 0.96);
  box-shadow:
    0 14rpx 28rpx rgba(37, 99, 235, 0.12),
    0 0 0 4rpx rgba(191, 219, 254, 0.62),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.9);
}

.picker-value:active {
  border-color: rgba(59, 130, 246, 0.96);
  box-shadow:
    0 12rpx 24rpx rgba(37, 99, 235, 0.12),
    0 0 0 4rpx rgba(191, 219, 254, 0.52),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.9);
}

.primary-btn {
  background: linear-gradient(135deg, #2563eb 0%, #3b82f6 58%, #60a5fa 100%);
  box-shadow: 0 16rpx 32rpx rgba(37, 99, 235, 0.20);
}

.secondary-btn {
  color: #2563eb;
  border: 1rpx solid rgba(147, 197, 253, 0.88);
  box-shadow: 0 12rpx 24rpx rgba(37, 99, 235, 0.09);
}

.link,
.pill-link {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 36rpx;
  padding: 6rpx 16rpx;
  border-radius: var(--ui-compact-radius, 18rpx);
  font-size: var(--ui-type-control);
  font-weight: 600;
  line-height: 1.25;
  background: rgba(219, 234, 254, 0.65);
  color: #2563eb;
  border: 1rpx solid rgba(147, 197, 253, 0.45);
  transition: transform 0.12s ease, opacity 0.12s ease;
}

.pill-close {
  border-radius: 999rpx;
}

.link:active,
.pill-link:active,
.pill-close:active {
  transform: scale(0.94);
  opacity: 0.85;
}

.danger,
.pill-close {
  background: rgba(254, 226, 226, 0.65);
  color: #dc2626;
  border-color: rgba(252, 165, 165, 0.45);
}

.current-chip,
.select-chip {
  color: #2563eb;
  border: 1rpx solid rgba(96, 165, 250, 0.86);
}

.template-section-tip {
  color: #51657f;
  border: 1rpx solid rgba(147, 197, 253, 0.76);
}

.template-hero {
  position: relative;
  overflow: hidden;
  margin-bottom: 22rpx;
  padding: 30rpx 26rpx 28rpx;
  border-radius: 28rpx;
  background:
    linear-gradient(135deg, rgba(255, 255, 255, 0.88) 0%, rgba(238, 246, 255, 0.78) 100%);
  border: 1rpx solid rgba(219, 234, 254, 0.92);
  box-shadow:
    0 18rpx 38rpx rgba(37, 99, 235, 0.08),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.86);
  animation: glassFadeUp 0.4s ease both;
}

.template-hero::before {
  content: "";
  position: absolute;
  top: -120rpx;
  right: -80rpx;
  width: 260rpx;
  height: 260rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(59, 130, 246, 0.18) 0%, rgba(59, 130, 246, 0) 68%);
  pointer-events: none;
}

.template-hero::after {
  content: "";
  position: absolute;
  left: -60rpx;
  bottom: -90rpx;
  width: 220rpx;
  height: 220rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(14, 165, 233, 0.12) 0%, rgba(14, 165, 233, 0) 70%);
  pointer-events: none;
}

.template-hero-badge,
.template-hero-title,
.template-hero-desc {
  position: relative;
  z-index: 1;
}

.template-hero-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 8rpx 18rpx;
  border-radius: var(--ui-compact-radius, 18rpx);
  background: linear-gradient(135deg, rgba(219, 234, 254, 0.98) 0%, rgba(191, 219, 254, 0.9) 100%);
  color: #2563eb;
  font-size: var(--ui-type-caption);
  font-weight: 700;
  box-shadow: 0 10rpx 20rpx rgba(37, 99, 235, 0.08);
}

.template-hero-title {
  margin-top: 16rpx;
  color: #0f172a;
  font-size: var(--ui-type-page);
  font-weight: 800;
  line-height: 1.36;
}

.template-hero-desc {
  margin-top: 12rpx;
  color: #5f7289;
  font-size: var(--ui-type-control);
  line-height: 1.8;
}

.template-section-head {
  margin-bottom: 14rpx;
}

.template-section-head .list-title {
  margin-bottom: 10rpx;
}

.template-section-tip {
  padding: 14rpx 18rpx;
  border-radius: 18rpx;
  background: linear-gradient(135deg, rgba(239, 246, 255, 0.92) 0%, rgba(247, 250, 255, 0.84) 100%);
  border: 1rpx solid rgba(191, 219, 254, 0.72);
  color: #5f7289;
  font-size: var(--ui-type-meta);
  line-height: 1.72;
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.82);
}

.template-save-btn {
  position: relative;
  overflow: hidden;
  box-shadow:
    0 18rpx 34rpx rgba(37, 99, 235, 0.18),
    0 0 26rpx rgba(96, 165, 250, 0.16),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.26);
}

.template-save-btn::before {
  content: "";
  position: absolute;
  inset: -24% auto auto -24%;
  width: 220rpx;
  height: 220rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.24) 0%, rgba(255, 255, 255, 0) 66%);
  pointer-events: none;
}

.hero::before {
  content: "";
  position: absolute;
  top: -90rpx;
  right: -35rpx;
  width: 240rpx;
  height: 240rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.14);
}

.hero-badge,
.hero-title,
.hero-subtitle {
  position: relative;
  z-index: 1;
}

.hero-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 18rpx;
  padding: 10rpx 24rpx;
  border-radius: var(--ui-compact-radius, 18rpx);
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.22) 0%, rgba(255, 255, 255, 0.14) 100%);
  border: 1rpx solid rgba(255, 255, 255, 0.28);
  color: #f8fbff;
  font-size: var(--ui-type-meta);
  font-weight: 600;
  letter-spacing: 1rpx;
}

.hero-title {
  color: #ffffff;
  font-size: var(--ui-type-page);
  font-weight: 700;
  line-height: 1.24;
  letter-spacing: 1rpx;
}

.hero-subtitle {
  margin-top: 12rpx;
  color: rgba(255, 255, 255, 0.92);
  font-size: var(--ui-type-emphasis);
  line-height: 1.72;
}

.empty-card {
  position: relative;
  margin-bottom: 24rpx;
  padding: 26rpx 24rpx;
  border-radius: 30rpx;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.82) 0%, rgba(248, 251, 255, 0.74) 100%);
  border: 1rpx solid rgba(255, 255, 255, 0.62);
  box-shadow:
    0 18rpx 36rpx rgba(15, 23, 42, 0.06),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.78);
  backdrop-filter: blur(24rpx);
  -webkit-backdrop-filter: blur(24rpx);
  box-sizing: border-box;
  transition: transform 0.22s ease, box-shadow 0.28s ease, border-color 0.24s ease;
  animation: glassFadeUp 0.46s ease both;
}

/* Tab sections are layout stacks; their child card/edit-box owns the surface. */
.section-stack {
  position: relative;
  min-width: 0;
  margin: 0;
  padding: 0;
  border: 0;
  background: transparent;
  box-shadow: none;
}

.section-stack > .section-title + .edit-box,
.section-stack > .section-title + .list-card,
.section-stack > .section-title + .rule-panel,
.section-stack > .section-title + .card,
.section-stack > .section-title + .button-row {
  margin-top: 0;
}

.section-stack > .button-row + .edit-box,
.section-stack > .button-row + .list-card {
  margin-top: 0;
}

.empty-card {
  text-align: center;
  padding-top: 64rpx;
  padding-bottom: 64rpx;
}

.tabs {
  display: flex;
  flex-wrap: nowrap;
  gap: var(--ui-tab-gap, 8rpx);
  margin-bottom: 22rpx;
}

.tab {
  flex: 1 1 0;
  min-width: 0;
  width: 0;
  min-height: var(--ui-tab-min-height, 66rpx);
  padding: var(--ui-tab-padding-y, 14rpx) 4rpx;
  border-radius: var(--ui-tab-radius, 24rpx);
  background: rgba(255, 255, 255, 0.74);
  border: 1rpx solid rgba(255, 255, 255, 0.54);
  color: #53687f;
  font-size: var(--ui-tab-font-size, 24rpx);
  line-height: var(--ui-leading-control, 1.35);
  font-weight: 600;
  text-align: center;
  white-space: nowrap;
  box-shadow: 0 10rpx 22rpx rgba(15, 23, 42, 0.04);
  transition: transform 0.18s ease, box-shadow 0.22s ease, background 0.22s ease, color 0.22s ease;
}

.tab-active {
  color: #ffffff;
  background: linear-gradient(135deg, #2563eb 0%, #60a5fa 100%);
  box-shadow: 0 16rpx 30rpx rgba(37, 99, 235, 0.18);
}

.tab:active {
  transform: translateY(1rpx) scale(0.985);
}

.section-title,
.list-title {
  position: relative;
  padding-left: 18rpx;
  margin-bottom: 18rpx;
  color: #0f172a;
  font-size: var(--ui-type-section);
  font-weight: 700;
}

.section-title::before,
.list-title::before {
  content: "";
  position: absolute;
  left: 0;
  top: 50%;
  width: 8rpx;
  height: 28rpx;
  border-radius: 999rpx;
  transform: translateY(-50%);
  background: linear-gradient(180deg, #2563eb 0%, #60a5fa 100%);
  box-shadow: 0 0 14rpx rgba(59, 130, 246, 0.24);
}

.field {
  margin-bottom: var(--ui-field-gap, 16rpx);
}

.field-row {
  display: flex;
  gap: var(--ui-inline-gap, 10rpx);
}

.field-row > .field {
  margin-bottom: 0;
}

.field-half {
  flex: 1;
  min-width: 0;
}

.field-label {
  margin-bottom: var(--ui-label-gap, 6rpx);
  color: #64748b;
  font-size: var(--ui-type-meta);
  line-height: 1.5;
  padding-left: var(--ui-control-padding-x, 28rpx);
}

.field-value {
  color: #1e293b;
  font-size: var(--ui-type-section);
  font-weight: 700;
  line-height: 1.5;
  padding-left: var(--ui-control-padding-x, 28rpx);
}

.field-input,
.picker-value,
.field-textarea {
  width: 100%;
  box-sizing: border-box;
  border-radius: 22rpx;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.92) 0%, rgba(247, 250, 255, 0.82) 100%);
  border: 1rpx solid rgba(226, 232, 240, 0.68);
  color: #0f172a;
  box-shadow:
    inset 0 1rpx 0 rgba(255, 255, 255, 0.78),
    0 8rpx 18rpx rgba(15, 23, 42, 0.03);
  transition: box-shadow 0.22s ease, border-color 0.22s ease, background 0.22s ease;
}

.field-input,
.picker-value {
  min-height: var(--ui-control-height, 82rpx);
  font-size: var(--ui-type-emphasis);
}

.field-input {
  display: block;
  padding: var(--ui-control-padding-y, 16rpx) var(--ui-control-padding-x, 28rpx);
  line-height: 1.35;
}

.picker-value {
  display: flex;
  align-items: center;
  padding: var(--ui-control-padding-y, 16rpx) var(--ui-control-padding-x, 28rpx);
}

.field-textarea {
  min-height: 160rpx;
  padding: var(--ui-control-padding-y, 16rpx) var(--ui-control-padding-x, 28rpx);
  font-size: var(--ui-type-emphasis);
}

.field-input:focus,
.field-textarea:focus {
  border-color: rgba(96, 165, 250, 0.92);
  box-shadow:
    0 14rpx 28rpx rgba(37, 99, 235, 0.10),
    0 0 0 4rpx rgba(191, 219, 254, 0.55),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.9);
}

.picker-value:active {
  transform: translateY(1rpx) scale(0.992);
  border-color: rgba(96, 165, 250, 0.92);
  box-shadow:
    0 12rpx 24rpx rgba(37, 99, 235, 0.10),
    0 0 0 4rpx rgba(191, 219, 254, 0.48),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.9);
}

.question-textarea {
  min-height: 120rpx;
  white-space: pre-wrap;
}

.button-row {
  display: flex;
  flex-wrap: wrap;
  gap: var(--ui-inline-gap, 10rpx);
  margin: var(--ui-action-gap, 20rpx) 0;
}

.compact-row {
  margin-top: 10rpx;
}

.primary-btn,
.secondary-btn {
  flex: 1 1 calc(50% - 7rpx);
  min-width: calc(50% - 7rpx);
  max-width: 100%;
  min-height: var(--ui-control-height, 82rpx);
  height: auto;
  padding: var(--ui-control-padding-y, 16rpx) var(--ui-control-padding-x, 28rpx);
  border-radius: var(--ui-control-radius, 28rpx);
  line-height: 1.35;
  font-size: var(--ui-type-control);
  font-weight: 700;
  white-space: normal;
  word-break: normal;
  overflow-wrap: anywhere;
  transition: box-shadow 0.24s ease, opacity 0.18s ease, filter 0.24s ease;
}

.primary-btn {
  color: #ffffff;
  background: linear-gradient(135deg, #2563eb 0%, #60a5fa 100%);
  box-shadow: 0 16rpx 32rpx rgba(37, 99, 235, 0.18);
}

.secondary-btn {
  color: #2563eb;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.92) 0%, rgba(235, 243, 255, 0.86) 100%);
  border: 1rpx solid rgba(191, 219, 254, 0.8);
  box-shadow: 0 12rpx 24rpx rgba(37, 99, 235, 0.08);
}

.primary-btn:active,
.secondary-btn:active {
  transform: translateY(2rpx) scale(0.986);
  filter: saturate(1.03);
}

.edit-box,
.list-card {
  margin-top: 0;
  padding: var(--ui-card-padding-y, 28rpx) var(--ui-card-padding-x, 26rpx);
  border-radius: var(--ui-card-radius, 30rpx);
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.72) 0%, rgba(247, 250, 255, 0.62) 100%);
  border: 1rpx solid rgba(255, 255, 255, 0.62);
  box-shadow:
    inset 0 1rpx 0 rgba(255, 255, 255, 0.78),
    0 12rpx 26rpx rgba(15, 23, 42, 0.04);
  transition: transform 0.22s ease, box-shadow 0.28s ease, border-color 0.24s ease, background 0.24s ease;
  animation: glassFadeUp 0.48s ease both;
}

.nested-card {
  margin-top: 10rpx;
}

/* The condition editor is a centered sub-panel inside the step dialog.
   The page-level field utility adds left padding for full-width forms; that
   padding must not be accumulated again inside this nested panel. */
.audit-step-condition-editor {
  width: calc(100% - 32rpx);
  margin-left: auto !important;
  margin-right: auto !important;
  box-sizing: border-box;
  text-align: left;
}

.audit-designation-options {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
  width: 100%;
}

.audit-designation-option {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 44rpx;
  padding: 6rpx 16rpx;
  box-sizing: border-box;
  border: 1rpx solid rgba(94, 139, 205, 0.22);
  border-radius: 14rpx;
  color: #52647d;
  background: rgba(247, 250, 255, 0.82);
  font-size: var(--ui-type-control);
  line-height: 1.35;
}

.audit-designation-option-active {
  color: #1769d2;
  border-color: rgba(57, 129, 232, 0.46);
  background: rgba(230, 241, 255, 0.92);
  box-shadow: inset 0 0 0 1rpx rgba(255, 255, 255, 0.72);
}
.audit-step-condition-editor .field,
.audit-step-condition-editor .button-row,
.audit-step-condition-editor .list-title {
  width: 100%;
  margin-left: auto;
  margin-right: auto;
  box-sizing: border-box;
}
.audit-step-condition-editor .field-label,
.audit-step-condition-editor .field-value {
  padding-left: 0;
}
.audit-step-condition-editor .field-input,
.audit-step-condition-editor .picker-value,
.audit-step-condition-editor .field-textarea {
  margin-left: auto;
  margin-right: auto;
}

.rule-panel {
  margin: 0 0 var(--ui-card-gap, 24rpx);
  padding: var(--ui-card-padding-y, 24rpx) var(--ui-card-padding-x, 24rpx);
  border-radius: var(--ui-card-radius, 24rpx);
