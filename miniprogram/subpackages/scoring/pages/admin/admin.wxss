}

.profile-comparison-text,
.correction-person-id,
.correction-org-meta {
  margin-top: 5rpx;
  color: #334155;
  font-size: var(--ui-type-value);
  line-height: 1.5;
  overflow-wrap: anywhere;
}

.hr-review-dialog,
.person-correction-dialog {
  width: min(92vw, 720rpx);
  max-height: calc(100vh - 48rpx - env(safe-area-inset-bottom));
}

.hr-review-dialog-body {
  max-height: 360rpx;
}

.person-correction-body {
  min-height: 0;
  max-height: calc(100vh - 300rpx - env(safe-area-inset-bottom));
}

.correction-callout {
  padding: 16rpx;
  border: 1rpx solid rgba(59, 130, 246, 0.28);
  border-radius: 16rpx;
  background: rgba(239, 246, 255, 0.86);
  color: #2563eb;
  font-size: var(--ui-type-meta);
  line-height: 1.6;
}

.correction-callout.is-danger {
  border-color: rgba(239, 68, 68, 0.28);
  background: rgba(254, 242, 242, 0.90);
  color: #991b1b;
}

.correction-section {
  margin-top: 20rpx;
}

.correction-person-card.is-target {
  margin-top: 10rpx;
  border-color: rgba(139, 92, 246, 0.30);
  background: rgba(245, 243, 255, 0.86);
}

.correction-org-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
  margin-top: 10rpx;
}

.correction-org-copy {
  min-width: 0;
  flex: 1;
}

.correction-confirm-row {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin-top: 22rpx;
  padding: 16rpx;
  border: 1rpx solid rgba(148, 163, 184, 0.26);
  border-radius: 16rpx;
  background: rgba(248, 250, 252, 0.82);
  color: #334155;
  font-size: var(--ui-type-meta);
  line-height: 1.55;
}

@media (min-width: 520px) {
  .former-member-list,
  .profile-comparison-list { gap: 10px; }
  .former-member-card { gap: 14px; padding: 14px 16px; border-radius: 12px; }
  .profile-comparison-grid,
  .correction-comparison-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
  .profile-comparison-card,
  .profile-comparison-value,
  .correction-person-card,
  .correction-org-card { border-radius: 11px; }
  .person-correction-dialog { width: min(720px, calc(100vw - 36px)); }
  .person-correction-body { max-height: calc(100vh - 164px); }
  .hr-review-dialog { width: min(520px, calc(100vw - 36px)); }
  .hr-review-dialog-body { max-height: min(280px, calc(100vh - 156px)); }
}

@media (min-width: 900px) {
  .person-correction-dialog { width: min(760px, calc(100vw - 48px)); }
  .person-correction-body { max-height: calc(100vh - 148px); }
  .hr-review-dialog { width: min(560px, calc(100vw - 48px)); }
}
