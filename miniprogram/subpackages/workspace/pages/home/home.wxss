@import '../../../main/styles/home.wxss';

.profile-passphrase-form {
  display: flex;
  flex-direction: column;
  width: 100%;
}

.profile-passphrase-submit {
  flex: none;
  box-sizing: border-box;
  width: 100%;
  min-width: 100%;
  max-width: 100%;
  margin-right: 0;
  margin-bottom: 0;
  margin-left: 0;
}

.profile-load-error {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 18rpx;
  margin-top: 12rpx;
  padding: 28rpx 24rpx;
  border: 1rpx solid rgba(251, 191, 36, 0.34);
  border-radius: 22rpx;
  background: linear-gradient(135deg, rgba(255, 251, 235, 0.96), rgba(255, 247, 237, 0.88));
  box-sizing: border-box;
}

.profile-load-error-text {
  color: #92400e;
  font-size: var(--ui-type-body);
  line-height: 1.6;
  text-align: center;
}

.profile-load-error .profile-retry-btn {
  flex: none;
  box-sizing: border-box;
  width: 100%;
  min-width: 100%;
  max-width: 100%;
  height: auto;
  min-height: var(--ui-control-height, 76rpx);
  margin: 0;
}
