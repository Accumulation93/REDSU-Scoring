<view class="page">
  <workspace-hero class="workspace-hero-host" app-name="{{copy.appName}}" page-name="{{heroSubtitle || copy.defaultPageName}}" tone="{{isAdminRole ? 'admin' : 'blue'}}"></workspace-hero>

  <view class="tabs-card" wx:if="{{hasUser && !isAdminRole}}">
    <view
      class="feature-tab {{activeTab === item.key ? 'feature-tab-active' : ''}} ui-motion-chip"
      wx:for="{{userTabs}}"
      wx:key="key"
      data-tab="{{item.key}}"
      bindtap="switchUserTab"
     hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">
      {{item.label}}
    </view>
  </view>

  <view class="panel {{activeTab === 'scoring' ? 'panel-active' : ''}}" wx:if="{{isAdminRole || !hasUser || activeTab === 'scoring'}}">
    <view class="card activity-card {{!currentActivity ? 'activity-card-empty' : ''}}">
      <view class="info-head">
        <view class="section-title">{{copy.currentActivity}}</view>
      </view>

      <view class="activity-name" wx:if="{{currentActivityText}}">
        {{currentActivityText}}
      </view>

      <view class="activity-desc" wx:if="{{currentActivity && currentActivity.description}}">
        {{currentActivity.description}}
      </view>
    </view>

    <view class="stats-bar" wx:if="{{hasUser && !isAdminRole && activeTab === 'scoring'}}">
      <view class="stat-item">
        <view class="stat-value">{{scoringStats.total}}</view>
        <view class="stat-label">{{copy.totalTargets}}</view>
      </view>
      <view class="stat-item">
        <view class="stat-value stat-value-gold">{{scoringStats.scored}}</view>
        <view class="stat-label">{{copy.completed}}</view>
      </view>
      <view class="stat-item">
        <view class="stat-value stat-value-blue">{{scoringStats.pending}}</view>
        <view class="stat-label">{{copy.pendingScore}}</view>
      </view>
    </view>

    <view class="card targets-card {{!targetsLoading && !targetList.length ? 'targets-card-empty' : ''}}" wx:if="{{hasUser && !isAdminRole && activeTab === 'scoring'}}">
      <view class="info-head">
        <view class="section-title">{{copy.scoreTarget}}</view>
      </view>

      <view class="activity-status-banner paused-banner" wx:if="{{activityPaused}}">
        <view class="status-banner-text">{{copy.activityPaused}}</view>
      </view>

      <view class="target-state" wx:if="{{targetsLoading}}">{{copy.loadingDots}}</view>

      <scroll-view class="target-scroll" scroll-y wx:if="{{!targetsLoading && targetGroups.length}}">
        <block wx:for="{{targetGroups}}" wx:key="identity">
          <view class="target-group-label">{{item.identity}}</view>
          <view
            class="target-card {{selectedTargetId === target.id ? 'target-card-active' : ''}} ui-motion-card"
            wx:for="{{item.targets}}"
            wx:key="id"
            wx:for-item="target"
            data-id="{{target.id}}"
            data-name="{{target.name}}"
            bindtap="selectTarget"
           hover-class="ui-press-card" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">
            <view class="target-main">
              <view class="target-name">{{target.name}}</view>
              <view class="target-tags">
                <view class="target-identity">{{target.identity}}</view>
                <view class="target-status {{target.scoreStatus === 'scored' ? 'target-status-scored' : 'target-status-pending'}}">
                  {{target.scoreStatusText}}
                </view>
              </view>
            </view>
            <view class="target-meta">{{target.department}}</view>
            <view class="target-meta" wx:if="{{target.workGroup}}">{{target.workGroup}}</view>
            <view class="target-assignment-chip" wx:if="{{target._showAssignmentChip}}">{{target._assignmentChipText}}</view>
          </view>
        </block>
      </scroll-view>

      <view class="target-state" wx:if="{{!targetsLoading && !targetList.length}}">{{targetsEmptyText}}</view>
    </view>
  </view>

  <view class="panel {{activeTab === 'results' ? 'panel-active' : ''}}" wx:if="{{hasUser && !isAdminRole && activeTab === 'results'}}">
    <view class="card empty-state-card" wx:if="{{publicationAccessLoading && !hasPublication}}">
      <view class="empty-illustration"><view class="empty-icon-clock"><ui-icon name="clock" tone="primary" size="46" ariaLabel="{{copy.loadingDots}}" /></view></view>
      <view class="empty-title">{{copy.loadingDots}}</view>
    </view>
    <view class="card empty-state-card" wx:if="{{!publicationAccessLoading && !hasPublication}}">
      <view class="empty-illustration"><view class="empty-icon-clock"><ui-icon name="clock" tone="primary" size="46" ariaLabel="{{copy.waitingPublication}}" /></view></view>
      <view class="empty-title">{{copy.noPublication}}</view>
    </view>
    <view class="card empty-state-card" wx:if="{{hasPublication && !publishedResults.length}}">
      <view class="empty-illustration"><view class="empty-icon-lock"><ui-icon name="shield" tone="danger" size="46" ariaLabel="{{copy.noPermission}}" /></view></view>
      <view class="empty-title">{{copy.noVisibleResults}}</view>
    </view>
    <view class="card results-panel-card" wx:if="{{hasPublication && publishedResults.length}}">
      <view class="info-head">
        <view class="section-title">{{copy.scoringResults}}</view>
        <view class="results-count-chip">{{copy.totalPrefix}} {{publishedResults.length}} {{copy.personSuffix}}</view>
      </view>
      <view class="stats-bar">
        <view class="stat-item">
          <view class="stat-value">{{filteredStatsData.count || publishedResults.length}}</view>
          <view class="stat-label">{{copy.publicationCount}}</view>
        </view>
        <view class="stat-item" wx:if="{{displayMode !== 'grade'}}">
          <view class="stat-value stat-value-gold">{{filteredStatsData.maxScore || '--'}}</view>
          <view class="stat-label">{{copy.maxScore}}</view>
        </view>
        <view class="stat-item" wx:if="{{displayMode !== 'grade'}}">
          <view class="stat-value">{{filteredStatsData.avgScore || '--'}}</view>
          <view class="stat-label">{{copy.averageScore}}</view>
        </view>
      </view>
      <!-- 等第模式下显示各等第人数分布（可点击筛选） -->
      <view class="grade-distribution" wx:if="{{displayMode === 'grade' && gradeDistribution.length}}">
        <view class="grade-chip {{resultFilterGrade === item.grade ? 'grade-chip-active' : ''}} ui-motion-chip" wx:for="{{gradeDistribution}}" wx:key="grade" bindtap="onResultFilterGrade" data-value="{{item.grade}}" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">
          <text class="grade-chip-name">{{item.grade}}</text>
          <text class="grade-chip-count">{{item.count}}{{copy.personSuffix}}</text>
        </view>
      </view>

      <!-- 搜索 + 筛选 -->
      <view class="result-filter-area">
        <view class="result-search-row">
          <view class="search-icon"><ui-icon name="search" tone="muted" size="34" ariaLabel="{{copy.search}}" /></view>
          <input class="result-search-input" placeholder="{{copy.resultSearchPlaceholder}}" value="{{resultSearchText}}" bindinput="onResultSearchInput" confirm-type="search" />
          <view class="search-clear ui-motion-chip" wx:if="{{resultSearchText}}" bindtap="onResultSearchClear" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">✕</view>
        </view>
        <view class="filter-title">{{copy.filter}}</view>
        <view class="filter-row" wx:if="{{resultIdentities.length}}">
          <view class="filter-row-label">{{copy.identity}}</view>
          <scroll-view class="filter-row-scroll" scroll-x enhanced show-scrollbar="{{false}}">
            <view class="filter-chip {{resultFilterIdentity === '' ? 'filter-chip-active' : ''}} ui-motion-chip" bindtap="onResultFilterIdentity" data-value="" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">{{copy.all}}</view>
            <view class="filter-chip {{resultFilterIdentity === item ? 'filter-chip-active' : ''}} ui-motion-chip" wx:for="{{resultIdentities}}" wx:key="*this" bindtap="onResultFilterIdentity" data-value="{{item}}" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">{{item}}</view>
          </scroll-view>
        </view>
        <view class="filter-row" wx:if="{{resultDepartments.length}}">
          <view class="filter-row-label">{{copy.department}}</view>
          <scroll-view class="filter-row-scroll" scroll-x enhanced show-scrollbar="{{false}}">
            <view class="filter-chip {{resultFilterDepartment === '' ? 'filter-chip-active' : ''}} ui-motion-chip" bindtap="onResultFilterDepartment" data-value="" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">{{copy.all}}</view>
            <view class="filter-chip {{resultFilterDepartment === item ? 'filter-chip-active' : ''}} ui-motion-chip" wx:for="{{resultDepartments}}" wx:key="*this" bindtap="onResultFilterDepartment" data-value="{{item}}" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">{{item}}</view>
          </scroll-view>
        </view>
        <view class="filter-row" wx:if="{{resultWorkGroups.length}}">
          <view class="filter-row-label">{{copy.workGroup}}</view>
          <scroll-view class="filter-row-scroll" scroll-x enhanced show-scrollbar="{{false}}">
            <view class="filter-chip {{resultFilterWorkGroup === '' ? 'filter-chip-active' : ''}} ui-motion-chip" bindtap="onResultFilterWorkGroup" data-value="" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">{{copy.all}}</view>
            <view class="filter-chip filter-chip-wg {{resultFilterWorkGroup === item ? 'filter-chip-active' : ''}} ui-motion-chip" wx:for="{{resultWorkGroups}}" wx:key="*this" bindtap="onResultFilterWorkGroup" data-value="{{item}}" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">{{item}}</view>
          </scroll-view>
        </view>
        <view class="filter-clear ui-motion-chip" wx:if="{{resultFilterIdentity || resultFilterDepartment || resultFilterWorkGroup || resultFilterGrade || resultSearchText}}" bindtap="onResultFilterClear" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">{{copy.clearAllFilters}}</view>
      </view>

      <!-- Grouped bubble cards (new per-clause mode) -->
      <view class="result-groups-area" wx:if="{{filteredGroups.length}}">
        <view class="result-group-bubble" wx:for="{{filteredGroups}}" wx:key="clauseId" wx:for-item="group" wx:for-index="gi" style="animation: glassFadeUp 0.38s {{0.07 * gi}}s ease both;">
          <view class="result-group-head ui-motion-chip" data-clause-id="{{group.clauseId}}" bindtap="toggleResultGroup" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">
            <view class="result-group-head-left">
              <view class="result-group-label">{{group.groupLabel}}</view>
              <view class="result-group-mode-chip {{group.displayMode === 'grade' ? 'result-group-mode-grade' : 'result-group-mode-score'}}">{{group.displayMode === 'grade' ? copy.grade : copy.score}}</view>
            </view>
            <view class="result-group-head-right">
              <view class="result-group-count">{{group.memberCount}}{{copy.personSuffix}}</view>
              <text class="result-group-arrow">{{expandedResultGroupClauseId === group.clauseId ? '▲' : '▼'}}</text>
            </view>
          </view>
          <view class="result-group-body" wx:if="{{expandedResultGroupClauseId === group.clauseId || filteredGroups.length === 1}}">
            <view class="ranked-list">
              <view class="rank-card rank-card-{{index === 0 ? 'gold' : (index === 1 ? 'silver' : (index === 2 ? 'bronze' : 'normal'))}}" wx:for="{{group.members}}" wx:for-item="m" wx:key="name" style="animation-delay: {{0.05 * index}}s;">
                <view class="rank-badge rank-badge-{{index === 0 ? 'gold' : (index === 1 ? 'silver' : (index === 2 ? 'bronze' : 'normal'))}}">
                  <text wx:if="{{index === 0}}">🥇</text>
                  <text wx:elif="{{index === 1}}">🥈</text>
                  <text wx:elif="{{index === 2}}">🥉</text>
                  <text wx:else>{{index + 1}}</text>
                </view>
                <view class="member-info">
                  <view class="member-name">{{m.name}}</view>
                  <view class="member-detail">{{m.identity}}<text wx:if="{{m.department}}"> · {{m.department}}</text><text wx:if="{{m.workGroup}}"> · {{m.workGroup}}</text></view>
                </view>
                <view class="score-display">
                  <view class="score-value">{{group.displayMode === 'grade' ? (m.grade || m.finalScore) : m.finalScore}}</view>
                  <view class="score-label">{{group.displayMode === 'grade' ? copy.grade : copy.earnedScore}}</view>
                </view>
              </view>
            </view>
          </view>
        </view>
      </view>

      <!-- Legacy flat list (fallback when no groups) -->
      <scroll-view class="results-scroll" scroll-y enhanced show-scrollbar="{{false}}" wx:if="{{!filteredGroups.length && filteredResults.length}}">
      <view class="ranked-list">
        <view class="rank-card rank-card-{{item.rank === 1 ? 'gold' : (item.rank === 2 ? 'silver' : (item.rank === 3 ? 'bronze' : 'normal'))}}" wx:for="{{filteredResults}}" wx:key="name" style="animation-delay: {{0.06 * index}}s;">
          <view class="rank-badge rank-badge-{{item.rank === 1 ? 'gold' : (item.rank === 2 ? 'silver' : (item.rank === 3 ? 'bronze' : 'normal'))}}">
            <text wx:if="{{item.rank === 1}}">🥇</text>
            <text wx:elif="{{item.rank === 2}}">🥈</text>
            <text wx:elif="{{item.rank === 3}}">🥉</text>
            <text wx:else>{{item.rank}}</text>
          </view>
          <view class="member-info">
            <view class="member-name">{{item.name}}</view>
            <view class="member-detail">{{item.identity}}<text wx:if="{{item.department}}"> · {{item.department}}</text><text wx:if="{{item.workGroup}}"> · {{item.workGroup}}</text></view>
          </view>
          <view class="score-display">
            <view class="score-value">{{displayMode === 'grade' ? item.grade : item.finalScore}}</view>
            <view class="score-label">{{displayMode === 'grade' ? copy.grade : copy.earnedScore}}</view>
          </view>
        </view>
      </view>
      </scroll-view>
      <view class="target-state" wx:if="{{!filteredResults.length && !filteredGroups.length && publishedResults.length}}">{{copy.noMatchingResults}}</view>
    </view>
  </view>

  <view class="panel {{activeTab === 'meritList' ? 'panel-active' : ''}}" wx:if="{{hasUser && !isAdminRole && activeTab === 'meritList'}}">
    <view class="card empty-state-card" wx:if="{{publicationAccessLoading && !hasPublication}}">
      <view class="empty-illustration"><view class="empty-icon-clock"><ui-icon name="clock" tone="primary" size="46" ariaLabel="{{copy.loadingDots}}" /></view></view>
      <view class="empty-title">{{copy.loadingDots}}</view>
    </view>
    <view class="card empty-state-card" wx:if="{{!publicationAccessLoading && !hasPublication}}">
      <view class="empty-illustration"><view class="empty-icon-clock"><ui-icon name="clock" tone="primary" size="46" ariaLabel="{{copy.waitingPublication}}" /></view></view>
      <view class="empty-title">{{copy.noMeritList}}</view>
    </view>
    <view class="card empty-state-card" wx:if="{{hasPublication && !hasMeritPerm}}">
      <view class="empty-illustration"><view class="empty-icon-star"><ui-icon name="star" tone="primary" size="46" ariaLabel="{{copy.noMeritList}}" /></view></view>
      <view class="empty-title">{{copy.noMeritList}}</view>
    </view>
    <view wx:if="{{hasPublication && hasMeritPerm}}">
      <view class="section-control-card section-control-card--stacked">
        <view class="info-head">
          <view class="section-title section-title-icon"><ui-icon name="star" tone="primary" size="26" ariaLabel="{{copy.merit}}" /><text>{{copy.meritList}}</text></view>
          <view class="results-count-chip">{{copy.totalPrefix}} {{meritRuleGroups.length}} {{copy.groupSuffix}}</view>
        </view>
        <view class="stats-bar">
          <view class="stat-item">
            <view class="stat-value stat-value-gold">{{meritRuleGroups.length}}</view>
            <view class="stat-label">{{copy.meritGroup}}</view>
          </view>
          <view class="stat-item">
            <view class="stat-value">{{publishedMeritList.length}}</view>
            <view class="stat-label">{{copy.designatedCount}}</view>
          </view>
          <view class="stat-item">
            <view class="stat-value stat-value-blue">{{meritDeptCount || meritRuleGroups.length}}</view>
            <view class="stat-label">{{copy.involvedDepartments}}</view>
          </view>
        </view>
      </view>
      <view class="card targets-card" wx:for="{{meritRuleGroups}}" wx:key="targetIdentity" style="animation: glassFadeUp 0.42s {{0.08 * index}}s ease both;">
        <view class="merit-rule-head">
          <view class="target-group-label target-group-label--flush">{{item.targetIdentity}}</view>
          <view class="merit-group-count">{{item.quotaInfo}}</view>
          <text class="merit-edit-btn ui-motion-chip" bindtap="openUserDesignation" data-identity="{{item.targetIdentity}}" hover-class="ui-press-chip" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">{{copy.edit}}</text>
        </view>
        <scroll-view class="target-scroll" scroll-y wx:if="{{item.designatedMembers.length}}">
          <view class="target-card" wx:for="{{item.designatedMembers}}" wx:key="id" wx:for-item="m" style="animation-delay: {{0.05 * index}}s;">
            <view class="target-main">
              <view class="target-name">{{m.name}}</view>
              <view class="target-tags">
                <view class="target-identity">{{m.identity}}</view>
              </view>
            </view>
            <view class="target-meta">{{m.department}}{{m.workGroup ? ' · ' + m.workGroup : ''}}</view>
          </view>
        </scroll-view>
        <view class="target-state" wx:else>{{copy.noDesignatedMember}}</view>
      </view>
    </view>
  </view>

  <view class="panel {{activeTab === 'profile' ? 'panel-active' : ''}}" wx:if="{{hasUser && !isAdminRole && activeTab === 'profile'}}">
    <view class="card profile-card">
      <view class="info-head">
        <view class="section-title">{{copy.hr}}</view>
        <view class="mode-chip {{hrProfile.template && hrProfile.template.editMode === 'audit' ? 'mode-chip-audit' : ''}} {{hrProfile.template && hrProfile.template.editMode === 'readonly' ? 'mode-chip-readonly' : ''}}" wx:if="{{hrProfile.loaded && !hrProfile.errorText}}">
          {{hrProfile.template ? hrProfile.template.modeText : copy.noTemplate}}
        </view>
      </view>

      <view class="profile-banner" wx:if="{{hrProfile.template && hrProfile.template.description}}">
        {{hrProfile.template.description}}
      </view>

      <view class="profile-status" wx:if="{{hrProfile.loaded && !hrProfile.errorText}}">
        <view class="status-title">{{hrProfile.statusText}}</view>
        <view class="status-desc" wx:if="{{hrProfile.auditStatus === 'pending'}}">{{copy.profilePending}}</view>
        <view class="status-desc" wx:if="{{hrProfile.auditStatus === 'rejected' && hrProfile.rejectionReason}}">{{copy.rejectionReasonPrefix}}{{hrProfile.rejectionReason}}</view>
      </view>

      <view class="field-grid">
        <view class="info-block">
          <view class="info-label">{{copy.name}}</view>
          <view class="info-value">{{user.name}}</view>
        </view>
        <view class="info-block">
          <view class="info-label">{{copy.studentId}}</view>
          <view class="info-value">{{user.studentId}}</view>
        </view>
        <view class="info-block info-block-full" wx:if="{{user.department}}">
          <view class="info-label">{{copy.belongingDepartment}}</view>
          <view class="info-value">{{user.department}}</view>
        </view>
        <view class="info-block info-block-wide">
          <view class="info-label">{{copy.identity}}</view>
          <view class="info-value">{{user.identity}}</view>
        </view>
        <view class="info-block info-block-wide" wx:if="{{user.workGroup}}">
          <view class="info-label">{{copy.workDivision}}</view>
          <view class="info-value">{{user.workGroup}}</view>
        </view>
      </view>

      <view class="readonly-tip">{{copy.profileManagedByAdmin}}</view>

      <view class="target-state" wx:if="{{hrProfile.loading}}">{{copy.loadingProfile}}</view>
      <view class="profile-load-error" wx:if="{{!hrProfile.loading && hrProfile.errorText}}">
        <view class="profile-load-error-text">{{hrProfile.errorText}}</view>
        <button class="secondary-btn profile-retry-btn ui-motion-button" bindtap="retryUserHrProfile" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">{{copy.reloadProfile}}</button>
      </view>
      <view class="empty-card profile-empty" wx:if="{{!hrProfile.loading && hrProfile.loaded && !hrProfile.errorText && (!hrProfile.template || !hrProfile.template.fields.length)}}">
        <view class="empty-title">{{copy.noExtraProfile}}</view>
      </view>

      <view class="profile-form" wx:if="{{!hrProfile.loading && hrProfile.template && hrProfile.template.fields.length}}">
        <scroll-view class="profile-form-scroll" scroll-y enhanced show-scrollbar="{{false}}">
        <view class="profile-field" wx:for="{{hrProfile.template.fields}}" wx:key="id">
          <view class="profile-field-head">
            <view class="profile-field-title">{{item.label}}<text class="field-required" wx:if="{{item.required}}">*</text></view>
            <view class="profile-field-type">{{item.typeLabel}}</view>
          </view>

          <picker
            wx:if="{{item.type === 'sequence'}}"
            range="{{item.options}}"
            value="{{item.valueIndex}}"
            bindchange="onHrProfileOptionChange"
            data-index="{{index}}"
            disabled="{{hrProfile.errorText || hrProfile.template.editMode === 'readonly'}}"
          >
            <view class="picker-value">{{item.value || copy.select}}</view>
          </picker>

          <input
            wx:elif="{{item.type === 'number'}}"
            class="field-input"
            type="digit"
            data-index="{{index}}"
            bindinput="onHrProfileInput"
            value="{{item.value}}"
            placeholder="{{copy.inputNumber}}"
            disabled="{{hrProfile.errorText || hrProfile.template.editMode === 'readonly'}}"
          />

          <picker
            wx:elif="{{item.type === 'date'}}"
            mode="date"
            value="{{item.value}}"
            bindchange="onHrProfileDateChange"
            data-index="{{index}}"
            disabled="{{hrProfile.errorText || hrProfile.template.editMode === 'readonly'}}"
          >
            <view class="picker-value">{{item.value || copy.selectDate}}</view>
          </picker>

          <input
            wx:elif="{{item.type === 'phone'}}"
            class="field-input"
            type="number"
            maxlength="11"
            data-index="{{index}}"
            bindinput="onHrProfileInput"
            value="{{item.value}}"
            placeholder="{{copy.inputPhone}}"
            disabled="{{hrProfile.errorText || hrProfile.template.editMode === 'readonly'}}"
          />

          <input
            wx:elif="{{item.type === 'email'}}"
            class="field-input"
            data-index="{{index}}"
            bindinput="onHrProfileInput"
            value="{{item.value}}"
            placeholder="{{copy.inputEmail}}"
            disabled="{{hrProfile.errorText || hrProfile.template.editMode === 'readonly'}}"
          />

          <input
            wx:else
            class="field-input"
            data-index="{{index}}"
            bindinput="onHrProfileInput"
            value="{{item.value}}"
            placeholder="{{copy.inputPrefix}}{{item.label}}"
            disabled="{{hrProfile.errorText || hrProfile.template.editMode === 'readonly'}}"
          />

          <view class="field-hint" wx:if="{{item.hintText}}">{{item.hintText}}</view>
        </view>
        </scroll-view>

        <button
          class="primary-btn profile-submit-btn {{hrProfile.template.editMode === 'audit' ? 'profile-submit-btn-audit' : ''}} ui-motion-button"
          bindtap="submitHrProfile"
          loading="{{hrProfile.saving}}"
          disabled="{{hrProfile.errorText || hrProfile.template.editMode === 'readonly'}}"
         hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">
          {{hrProfile.template.editMode === 'audit' ? copy.submitReview : copy.saveProfile}}
        </button>
      </view>

      <view class="profile-account-section" id="account-and-login">
        <view class="profile-account-head">
          <view>
            <view class="section-title">{{copy.accountAndLogin}}</view>
            <view class="profile-account-note">{{copy.accountDescription}}</view>
          </view>
          <view class="profile-account-status" wx:if="{{accountSecurity.account}}">{{copy.verified}}</view>
        </view>

        <view class="target-state" wx:if="{{accountSecurity.loading}}">{{copy.loadingAccount}}</view>
        <block wx:elif="{{accountSecurity.loaded}}">
          <view class="profile-account-summary" wx:if="{{accountSecurity.account}}">
            <view class="info-block"><view class="info-label">{{copy.name}}</view><view class="info-value">{{accountSecurity.account.name}}</view></view>
            <view class="info-block"><view class="info-label">{{copy.studentId}}</view><view class="info-value">{{accountSecurity.account.studentId}}</view></view>
          </view>

          <view class="profile-security-note" wx:if="{{!accountSecurity.allowRecoveryCode && !accountSecurity.allowPassphrase}}">{{copy.contactAdminForWechat}}</view>

          <view class="profile-account-grid" wx:if="{{accountSecurity.allowRecoveryCode || accountSecurity.allowPassphrase}}">
            <view class="profile-credential-card" wx:if="{{accountSecurity.allowRecoveryCode}}">
              <view class="profile-credential-head">
                <view><view class="profile-credential-title">{{copy.recoveryCode}}</view><view class="profile-credential-note">{{copy.recoveryCodeWarning}}</view></view>
                <button class="secondary-btn profile-account-action ui-motion-button" loading="{{accountSecurity.savingCredential}}" bindtap="rotateAccountRecoveryCode" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160">{{copy.generateCode}}</button>
              </view>
              <view class="profile-recovery-code" wx:if="{{accountSecurity.recoveryCode}}">
                <view class="profile-recovery-value">{{accountSecurity.recoveryCode}}</view>
                <view class="profile-recovery-actions"><button class="secondary-btn profile-account-action ui-motion-button" bindtap="copyAccountRecoveryCode" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160">{{copy.copy}}</button><button class="primary-btn profile-account-action ui-motion-button" bindtap="hideAccountRecoveryCode" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160">{{copy.saved}}</button></view>
              </view>
            </view>

            <view class="profile-credential-card" wx:if="{{accountSecurity.allowPassphrase}}">
              <view class="profile-credential-title">{{copy.loginPassphrase}}</view>
              <view class="profile-credential-note">{{copy.passphraseDescription}}</view>
              <view class="profile-passphrase-form">
                <input class="field-input profile-passphrase-input" password="{{true}}" value="{{accountSecurity.passphrase}}" bindinput="onAccountPassphraseInput" placeholder="{{copy.passphrasePlaceholder}}" />
                <button class="primary-btn profile-submit-btn profile-passphrase-submit ui-motion-button" loading="{{accountSecurity.savingCredential}}" bindtap="saveAccountPassphrase" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160">{{copy.savePassphrase}}</button>
              </view>
            </view>
          </view>

          <view class="profile-session-panel">
            <view class="profile-session-head"><view><view class="profile-credential-title">{{copy.loginDevices}}</view><view class="profile-credential-note">{{copy.loginDevicesDescription}}</view></view><view class="profile-session-count">{{accountSecurity.sessions.length}} {{copy.deviceSuffix}}</view></view>
            <view class="profile-session-list">
              <view class="profile-session-row" wx:for="{{accountSecurity.sessions}}" wx:key="id">
                <view class="profile-session-copy">
                  <view class="profile-session-title">{{item.deviceTitle}}</view>
                  <view class="profile-credential-note">{{item.deviceMeta}}</view>
                  <view class="profile-credential-note">{{item.sessionMeta}} · {{copy.recentActivity}} {{item.lastSeenText}}</view>
                </view>
                <view class="profile-account-status" wx:if="{{item.current}}">{{copy.current}}</view>
                <button wx:else class="secondary-btn profile-account-action ui-motion-button" data-id="{{item.id}}" loading="{{accountSecurity.revokingSessionId === item.id}}" bindtap="revokeAccountSession" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160">{{copy.signOutDevice}}</button>
              </view>
              <view class="empty-inline" wx:if="{{!accountSecurity.sessions.length}}">{{copy.noDevices}}</view>
            </view>
          </view>
        </block>
      </view>
    </view>
  </view>

  <!-- ═══ Audit Panel ═══ -->
  <view class="panel {{activeTab === 'audit' ? 'panel-active' : ''}}" wx:if="{{hasUser && !isAdminRole && activeTab === 'audit'}}">
    <view class="card">
      <view class="section-title">{{copy.auditCenter}}</view>
      <view class="audit-home-cards">
        <!-- 我的审核 -->
        <view class="audit-home-card ui-motion-card" bindtap="goMySubmissions" hover-class="ui-press-card" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">
          <view class="audit-home-card-icon"><ui-icon name="file" tone="primary" sizeRole="feature-leading" ariaLabel="{{copy.myAudits}}" /></view>
          <view class="audit-home-card-content">
            <view class="audit-home-card-title">{{copy.myAudits}}</view>
          </view>
          <view class="audit-home-card-badge" wx:if="{{auditMyCount > 0}}">{{auditMyCount}}</view>
          <view class="audit-home-card-arrow"><ui-icon name="chevron-right" tone="muted" size="32" ariaLabel="{{copy.enter}}" /></view>
        </view>
        <!-- 待我审批 -->
        <view class="audit-home-card ui-motion-card" bindtap="goPendingApprovals" hover-class="ui-press-card" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">
          <view class="audit-home-card-icon"><ui-icon name="signature" tone="primary" sizeRole="feature-leading" ariaLabel="{{copy.pendingApprovals}}" /></view>
          <view class="audit-home-card-content">
            <view class="audit-home-card-title">{{copy.pendingApprovals}}</view>
          </view>
          <view class="audit-home-card-badge audit-home-card-badge-pending" wx:if="{{auditPendingCount > 0}}">{{auditPendingCount}}</view>
          <view class="audit-home-card-arrow"><ui-icon name="chevron-right" tone="muted" size="32" ariaLabel="{{copy.enter}}" /></view>
        </view>
        <!-- 我的审批记录 -->
        <view class="audit-home-card ui-motion-card" bindtap="goMyApprovalHistory" hover-class="ui-press-card" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">
          <view class="audit-home-card-icon"><ui-icon name="list" tone="primary" sizeRole="feature-leading" ariaLabel="{{copy.approvalHistory}}" /></view>
          <view class="audit-home-card-content">
            <view class="audit-home-card-title">{{copy.myApprovalHistory}}</view>
          </view>
          <view class="audit-home-card-arrow"><ui-icon name="chevron-right" tone="muted" size="32" ariaLabel="{{copy.enter}}" /></view>
        </view>
        <!-- 文件验签 -->
        <view class="audit-home-card ui-motion-card" wx:if="{{auditCanVerify}}" bindtap="goAuditVerification" hover-class="ui-press-card" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">
          <view class="audit-home-card-icon"><ui-icon name="shield" tone="primary" sizeRole="feature-leading" ariaLabel="{{copy.auditVerification}}" /></view>
          <view class="audit-home-card-content">
            <view class="audit-home-card-title">{{copy.auditVerification}}</view>
            <view class="audit-home-card-desc">{{copy.auditVerificationDescription}}</view>
          </view>
          <view class="audit-home-card-arrow"><ui-icon name="chevron-right" tone="muted" size="32" ariaLabel="{{copy.enter}}" /></view>
        </view>
      </view>
    </view>
  </view>

  <view class="card empty-card" wx:if="{{!hasUser}}">
    <view class="empty-title">{{copy.noIdentity}}</view>
  </view>

  <view class="actions">
    <button class="secondary-btn ui-motion-button" bindtap="goPortal" hover-class="ui-press-button" hover-start-time="0" hover-stay-time="160" hover-stop-propagation="{{true}}">{{copy.backToPortal}}</button>
  </view>

  <view class="page-footer">
    <view class="footer-name">{{copy.appName}}</view>
    <view class="footer-org">{{copy.organizationName}}</view>
  </view>

  <personnel-picker visible="{{showUserDesigPopup}}" title="{{copy.designateMeritList}}" options="{{userDesigHrList}}" value="{{userDesigSelectedList}}" selectionLevel="assignment" multiple="{{true}}" confirmLoading="{{userDesigSaving}}" bindconfirm="confirmSharedUserDesignation" bindcancel="closeUserDesignation" />
</view>
